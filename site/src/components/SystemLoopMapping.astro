---
/**
 * 系统级闭环映射图：左列为 1.1 的抽象闭环（感知—决策—行动—产生新观测），
 * 右列为同一条环在整机上的落地环节，按环的运行顺序自上而下排列；
 * 连线表示抽象环节落在哪些整机环节上，右侧虚线弧线表示新观测上行、
 * 闭环继续。光点沿连线流动，经过的节点按所在层配色发光；
 * 左列抽象环节同步以主题色发光。纯 SVG + CSS/SMIL，无 JS 依赖。
 * 遵循 prefers-reduced-motion：用户系统开启减弱动态效果时光点静止。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import SystemLoopMapping from '../../../components/SystemLoopMapping.astro';
 *   <SystemLoopMapping />
 */

// 右列：整机落地环节，按闭环运行顺序排列；cls 决定层标注的配色
const steps = [
  { label: '传感器采集', layer: '电气与嵌入式层', cls: 'elec' },
  { label: '状态估计', layer: '小脑层', cls: 'cerebellum' },
  { label: '感知、规划或 VLA/WAM', layer: '大脑层', cls: 'brain' },
  { label: '运动规划', layer: '大脑层', cls: 'brain' },
  { label: '全身控制', layer: '小脑层', cls: 'cerebellum' },
  { label: '关节伺服与电机驱动', layer: '电气与嵌入式层', cls: 'elec' },
  { label: '本体运动', layer: '机械与本体层', cls: 'mech' },
];

const stepY = (i) => 64 + i * 56; // 右列第 i 个环节的中心 y

// 左列：1.1 的抽象闭环，中心 y 对齐其落地环节簇的中点
const stages = [
  { lines: ['感知'], y: stepY(0), targets: [0] },
  { lines: ['决策'], y: (stepY(1) + stepY(2)) / 2, targets: [1, 2] },
  { lines: ['行动'], y: stepY(4), targets: [3, 4, 5] },
  { lines: ['行动改变环境', '产生新观测'], y: stepY(6), targets: [6] },
];

const LX = 26; // 左列盒子左缘
const LW = 150; // 左列盒子宽
const RX = 436; // 右列盒子左缘
const RW = 200; // 右列盒子宽
const BH = 44; // 盒子高

// 抽象环节 → 落地环节的贝塞尔连线
const connectors = stages.flatMap((s) =>
  s.targets.map((t) => ({
    d: `M ${LX + LW} ${s.y} C ${LX + LW + 90} ${s.y}, ${RX - 90} ${stepY(t)}, ${RX} ${stepY(t)}`,
    t,
  })),
);

// 动画时序：一个周期 T 秒，光点到达右列第 i 个环节的时刻为 arrive(i)
const T = 8;
const arrive = (i) => 0.6 + i * 1.0;
const fmt = (n) => (Math.round(n * 1000) / 1000).toString();

// 连线上光点的动画参数：到达前 0.6s 从左列出发
const dotAnims = connectors.map(({ t }) => {
  const b = Math.max(0, arrive(t) - 0.6) / T; // 出发时刻（周期比例）
  const e = Math.min(b + 0.075, 1); // 到达时刻（周期比例）
  return {
    t,
    motionKeyTimes: `0;${fmt(e)};1`,
    opacityValues: '0;0;1;1;0;0',
    opacityKeyTimes: `0;${fmt(b)};${fmt(b + 0.008)};${fmt(e - 0.005)};${fmt(e)};1`,
  };
});

// 右列节点发光（层配色）：光点到达时亮起，随后淡出
const nodeGlows = steps.map((_, i) => {
  const a = arrive(i) / T;
  return {
    i,
    values: '0;0;1;0;0',
    keyTimes: `0;${fmt(a)};${fmt(a + 0.015)};${fmt(a + 0.09)};1`,
  };
});

// 左列节点发光（主题色）：覆盖其所有目标环节的到达窗口
const stageGlows = stages.map((s) => {
  const points = [{ kt: 0, v: 0 }];
  for (const t of s.targets) {
    const a = arrive(t) / T;
    points.push({ kt: a - 0.075, v: 0 }, { kt: a - 0.06, v: 1 }, { kt: a + 0.09, v: 0 });
  }
  points.push({ kt: 1, v: 0 });
  const list = points.filter((p) => p.kt >= 0 && p.kt <= 1).sort((x, y) => x.kt - y.kt);
  return {
    values: list.map((p) => p.v).join(';'),
    keyTimes: list.map((p) => fmt(p.kt)).join(';'),
  };
});

// 右侧回流弧上的光点：周期末尾从"本体运动"回到"传感器采集"
const returnDot = {
  begin: `${fmt(6.8)}s`,
  motionKeyTimes: `0;${fmt(1.1 / T)};1`,
  opacityValues: '0;1;1;0;0',
  opacityKeyTimes: `0;0.01;${fmt(1.05 / T)};${fmt(1.15 / T)};1`,
};

// 左列相邻抽象环节之间的下行箭头（两端留出盒子空间）
const stageArrows = [
  `M ${LX + LW / 2} ${stages[0].y + BH / 2 + 2} L ${LX + LW / 2} ${stages[1].y - BH / 2 - 4}`,
  `M ${LX + LW / 2} ${stages[1].y + BH / 2 + 2} L ${LX + LW / 2} ${stages[2].y - BH / 2 - 4}`,
  `M ${LX + LW / 2} ${stages[2].y + BH / 2 + 2} L ${LX + LW / 2} ${stages[3].y - BH / 2 - 8}`,
];
---

<figure class="system-loop-mapping">
  <svg
    viewBox="0 0 720 444"
    role="img"
    aria-label="系统级闭环映射图：抽象闭环的感知、决策、行动、产生新观测四个环节，分别连线到整机上的传感器采集、状态估计、感知规划、运动规划、全身控制、关节伺服、本体运动等落地环节；虚线表示新观测回到感知，闭环继续"
  >
    <defs>
      <marker id="slm-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" class="slm-arrow-head-accent"></path>
      </marker>
      <marker id="slm-arrow-gray" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" class="slm-arrow-head-gray"></path>
      </marker>
    </defs>

    <text x={LX + LW / 2} y="20" class="slm-header" text-anchor="middle">1.1 的抽象闭环</text>
    <text x={RX + RW / 2} y="20" class="slm-header" text-anchor="middle">整机落地（按环的运行顺序）</text>

    {/* 抽象环节 → 落地环节的连线 */}
    {connectors.map(({ d }) => <path d={d} class="slm-connector" fill="none" marker-end="url(#slm-arrow)"></path>)}

    {/* 左列：抽象闭环的循环箭头 */}
    {stageArrows.map((d) => <path d={d} class="slm-stage-arrow" fill="none" marker-end="url(#slm-arrow-gray)"></path>)}
    <path
      d={`M ${LX} ${stages[3].y} C 2 ${stages[3].y}, 2 ${stages[0].y}, ${LX - 3} ${stages[0].y}`}
      class="slm-return"
      fill="none"
      marker-end="url(#slm-arrow-gray)"
    ></path>

    {/* 右列：新观测回到感知的回环虚线 */}
    <path
      d={`M ${RX + RW} ${stepY(6)} C 696 ${stepY(6)}, 696 ${stepY(0)}, ${RX + RW + 3} ${stepY(0)}`}
      class="slm-return"
      fill="none"
      marker-end="url(#slm-arrow-gray)"
    ></path>
    <text x="710" y={(stepY(0) + stepY(6)) / 2} class="slm-arc-label" text-anchor="middle" transform={`rotate(-90 710 ${(stepY(0) + stepY(6)) / 2})`}>
      新观测上行，闭环继续
    </text>

    {/* 左列节点 */}
    {stages.map((s) => (
      <g>
        <rect x={LX} y={s.y - (s.lines.length > 1 ? BH / 2 + 6 : BH / 2)} width={LW} height={s.lines.length > 1 ? BH + 12 : BH} rx="6" class="slm-box"></rect>
        {s.lines.map((line, i) => (
          <text x={LX + LW / 2} y={s.lines.length > 1 ? s.y - 9 + i * 20 : s.y} class="slm-label" text-anchor="middle" dominant-baseline={s.lines.length > 1 ? 'auto' : 'central'}>
            {line}
          </text>
        ))}
      </g>
    ))}

    {/* 右列节点 */}
    {steps.map((step, i) => (
      <g class={`slm-node slm-node-${step.cls}`}>
        <rect x={RX} y={stepY(i) - BH / 2} width={RW} height={BH} rx="6" class="slm-box"></rect>
        <rect x={RX} y={stepY(i) - BH / 2} width="4" height={BH} class="slm-bar"></rect>
        <text x={RX + RW / 2 + 2} y={stepY(i) - 4} class="slm-label" text-anchor="middle">{step.label}</text>
        <text x={RX + RW / 2 + 2} y={stepY(i) + 13} class="slm-tag" text-anchor="middle">{step.layer}</text>
      </g>
    ))}

    {/* 发光覆盖层与流动光点（减弱动态效果时整体隐藏） */}
    <g class="slm-anim">
      {/* 左列节点发光覆盖层 */}
      {stages.map((s, i) => (
        <rect
          x={LX}
          y={s.y - (s.lines.length > 1 ? BH / 2 + 6 : BH / 2)}
          width={LW}
          height={s.lines.length > 1 ? BH + 12 : BH}
          rx="6"
          class="slm-glow slm-glow-stage"
          opacity="0"
        >
          <animate attributeName="opacity" values={stageGlows[i].values} keyTimes={stageGlows[i].keyTimes} dur={`${T}s`} repeatCount="indefinite"></animate>
        </rect>
      ))}
      {/* 右列节点发光覆盖层 */}
      {steps.map((_, i) => (
        <rect x={RX} y={stepY(i) - BH / 2} width={RW} height={BH} rx="6" class={`slm-glow slm-glow-${steps[i].cls}`} opacity="0">
          <animate attributeName="opacity" values={nodeGlows[i].values} keyTimes={nodeGlows[i].keyTimes} dur={`${T}s`} repeatCount="indefinite"></animate>
        </rect>
      ))}
      {/* 连线上的光点 */}
      {connectors.map(({ d }, i) => (
        <circle r="5" class="slm-dot" opacity="0">
          <animateMotion dur={`${T}s`} repeatCount="indefinite" path={d} calcMode="linear" keyPoints="0;1;1" keyTimes={dotAnims[i].motionKeyTimes}></animateMotion>
          <animate attributeName="opacity" values={dotAnims[i].opacityValues} keyTimes={dotAnims[i].opacityKeyTimes} dur={`${T}s`} repeatCount="indefinite"></animate>
        </circle>
      ))}
      {/* 回流弧上的光点 */}
      <circle r="5" class="slm-dot slm-dot-return" opacity="0">
        <animateMotion
          dur={`${T}s`}
          begin={returnDot.begin}
          repeatCount="indefinite"
          path={`M ${RX + RW} ${stepY(6)} C 696 ${stepY(6)}, 696 ${stepY(0)}, ${RX + RW + 3} ${stepY(0)}`}
          calcMode="linear"
          keyPoints="0;1;1"
          keyTimes={returnDot.motionKeyTimes}
        ></animateMotion>
        <animate attributeName="opacity" values={returnDot.opacityValues} keyTimes={returnDot.opacityKeyTimes} dur={`${T}s`} begin={returnDot.begin} repeatCount="indefinite"></animate>
      </circle>
    </g>
  </svg>
  <figcaption>左列是 1.1 的抽象闭环，右列是同一条环在整机上的落地环节（按运行顺序排列，标注所在层）；光点沿环流动，经过的节点发光，虚线表示新观测回到感知，闭环继续。</figcaption>
</figure>

<style>
  .system-loop-mapping {
    margin: 1.5rem 0;
    text-align: center;
  }
  .system-loop-mapping svg {
    display: block;
    margin: 0 auto;
    max-width: 720px;
    width: 100%;
    height: auto;
  }
  .slm-header {
    fill: var(--sl-color-gray-2);
    font-size: 13px;
    font-weight: 600;
  }
  .slm-box {
    fill: var(--sl-color-bg);
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .slm-label {
    fill: var(--sl-color-text);
    font-size: 14px;
  }
  .slm-tag {
    font-size: 11px;
  }
  .slm-connector {
    stroke: var(--sl-color-accent);
    stroke-width: 2;
    opacity: 0.75;
  }
  .slm-arrow-head-accent {
    fill: var(--sl-color-accent);
    opacity: 0.75;
  }
  .slm-stage-arrow {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .slm-arrow-head-gray {
    fill: var(--sl-color-gray-3);
  }
  .slm-return {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }
  .slm-arc-label {
    fill: var(--sl-color-gray-2);
    font-size: 11px;
  }

  /* 各层配色（标注、色条、发光共用），兼顾明暗两套主题 */
  .slm-node-brain {
    --layer: light-dark(#6d28d9, #c4b5fd);
  }
  .slm-node-cerebellum {
    --layer: light-dark(#0f766e, #5eead4);
  }
  .slm-node-elec {
    --layer: light-dark(#b45309, #fbbf24);
  }
  .slm-node-mech {
    --layer: light-dark(#9f1239, #fda4af);
  }
  .slm-tag,
  .slm-bar {
    fill: var(--layer);
  }

  /* 发光覆盖层：节点本身不透明，由 SMIL 控制透明度 */
  .slm-glow {
    fill: none;
    stroke-width: 3;
  }
  .slm-glow-stage {
    stroke: var(--sl-color-accent);
  }
  .slm-glow-brain {
    stroke: light-dark(#6d28d9, #c4b5fd);
  }
  .slm-glow-cerebellum {
    stroke: light-dark(#0f766e, #5eead4);
  }
  .slm-glow-elec {
    stroke: light-dark(#b45309, #fbbf24);
  }
  .slm-glow-mech {
    stroke: light-dark(#9f1239, #fda4af);
  }

  /* 连线上的流动光点 */
  .slm-dot {
    fill: var(--sl-color-accent);
  }
  .slm-dot-return {
    fill: var(--sl-color-gray-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .slm-anim {
      display: none;
    }
  }

  .system-loop-mapping figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
  }
</style>
