---
/**
 * 4.4 状态估计：互补滤波与陀螺积分漂移交互演示 —— “## 互补滤波”一节之后。
 *
 * 纯 2D SVG 时间轴 + HTML 读数，无 3D、无外部依赖。页面里真算四条轨迹：
 *   真值 θ_true、纯陀螺积分 θ_g、加速度计观测 θ_a、互补滤波输出 θ_hat。
 * 更新式（与正文公式一致）：
 *   θ_g   ← θ_g + (ω_meas − b_g) dt
 *   θ_hat ← α (θ_hat + (ω_meas − b_g) dt) + (1 − α) θ_a      （重力观测关闭时退化为 θ_hat = θ_g）
 *
 * 教学示意参数（噪声、零偏为可复现的伪随机，量级为示意）：
 *   θ_true = 25° · sin(2π t / 9)，角速度由解析导数给出；
 *   陀螺噪声 0.25°/s、零偏可注入；加速度计噪声 1.5°，快速运动时按 |ω| 加权放大；
 *   α 由滑块给出（0.80–0.998），对应时间常数 τ ≈ α/(1−α)；
 *   yaw 通道没有重力观测：陀螺零偏会把 yaw 估计单调拉开，用来解释“不可观”。
 * 漂移机理、互补滤波的权重行为是真实的；具体噪声与偏置数值是示意，不代表某台 G1。
 */

const R2D = 180 / Math.PI;
const WINDOW_S = 12;
const YAW_WINDOW_S = 30;
const MAX_PTS = 600;
const ALPHA_DEF = 0.96;
const ALPHA_MIN = 0.8;
const ALPHA_MAX = 0.998;
const GYRO_N = 0.25;
const ACC_N = 1.5;
const YAW_BIAS = 0.35;

const fmt1 = (v) => (Math.abs(v) < 0.05 ? "0.0" : (v < 0 ? "−" : "") + Math.abs(v).toFixed(1));
const fmt2 = (v) => (Math.abs(v) < 0.005 ? "0.00" : (v < 0 ? "−" : "") + Math.abs(v).toFixed(2));
const tauText = (a) => ((a / (1 - a)) * (1 / 30)).toFixed(2);
const CFG = {
  window: WINDOW_S,
  yawWindow: YAW_WINDOW_S,
  maxPts: MAX_PTS,
  alpha: ALPHA_DEF,
  aMin: ALPHA_MIN,
  aMax: ALPHA_MAX,
  gyroN: GYRO_N,
  accN: ACC_N,
  yawBias: YAW_BIAS,
  tau: tauText(ALPHA_DEF),
};
---

<figure class="cf-demo" data-cf={JSON.stringify(CFG)}>
  <svg viewBox="0 0 980 410" role="img" aria-label="互补滤波教学示意：三条时间轨迹分别显示真值、纯陀螺积分和带噪声的加速度计观测，绿色曲线显示互补滤波输出；拖动 α 滑块改变对陀螺和重力观测的信任比例">
    <defs>
      <clipPath id="cf-clip"><rect x="150" y="66" width="790" height="284"></rect></clipPath>
    </defs>

    <text class="cf-title" x="150" y="32">互补滤波：短期信陀螺，长期信重力</text>
    <text class="cf-legend" x="150" y="54">浅灰粗虚线 = 真值　蓝线 = 陀螺积分　橙线 = 加速度计　绿线 = 融合输出</text>

    <text class="cf-lane-name" x="138" y="110" text-anchor="end">roll 真值与融合</text>
    <text class="cf-lane-name" x="138" y="210" text-anchor="end">纯陀螺积分</text>
    <text class="cf-lane-name" x="138" y="310" text-anchor="end">加速度计与融合</text>
    <text class="cf-lane-sub" x="138" y="128" text-anchor="end">虚线 = 真值</text>
    <text class="cf-lane-sub" x="138" y="228" text-anchor="end">退化后与它重合</text>
    <text class="cf-lane-sub" x="138" y="328" text-anchor="end">橙线抖动最大</text>

    <g clip-path="url(#cf-clip)">
      <line class="cf-grid" x1="150" y1="66" x2="940" y2="66"></line>
      <line class="cf-grid" x1="150" y1="166" x2="940" y2="166"></line>
      <line class="cf-grid" x1="150" y1="266" x2="940" y2="266"></line>
      <line class="cf-grid" x1="150" y1="350" x2="940" y2="350"></line>
      <line class="cf-zero" x1="150" y1="114" x2="940" y2="114"></line>
      <line class="cf-zero" x1="150" y1="214" x2="940" y2="214"></line>
      <line class="cf-zero" x1="150" y1="314" x2="940" y2="314"></line>
      <path class="cf-series cf-true-halo" data-cf-halo="0" d=""></path>
      <path class="cf-series cf-true" data-cf-true="0" d=""></path>
      <path class="cf-series cf-gyro" data-cf-gyro="1" d=""></path>
      <path class="cf-series cf-fuse" data-cf-fuse="0" d=""></path>
      <path class="cf-series cf-acc" data-cf-acc="2" d=""></path>
      <path class="cf-series cf-fuse" data-cf-fuse="2" d=""></path>
    </g>

    <line class="cf-axis" x1="150" y1="350" x2="940" y2="350"></line>
    <line class="cf-tick" x1="150" y1="350" x2="150" y2="356"></line>
    <line class="cf-tick" x1="545" y1="350" x2="545" y2="356"></line>
    <line class="cf-tick" x1="940" y1="350" x2="940" y2="356"></line>
    <text class="cf-axis-label" x="150" y="378" text-anchor="start">−12 s</text>
    <text class="cf-axis-label" x="545" y="378" text-anchor="middle">−6 s</text>
    <text class="cf-axis-label" x="940" y="378" text-anchor="end">现在</text>
    <text class="cf-scale-label" data-cf-scale x="150" y="378" text-anchor="start">纵轴 ±10°</text>
  </svg>

  <div class="cf-controls">
    <div class="cf-row">
      <span class="cf-row-title">α（信陀螺的比例）</span>
      <input class="cf-range" type="range" data-cf-alpha min="800" max="998" step="1" value="960" />
      <span class="cf-alpha-val" data-cf-alpha-val>0.960</span>
      <span class="cf-hint" data-cf-tau>时间常数 ≈ 3.30 s（教学示意）</span>
    </div>
    <div class="cf-row">
      <span class="cf-row-title"></span>
      <button type="button" class="cf-btn" data-cf-gravity>重力观测：开</button>
      <button type="button" class="cf-btn" data-cf-bias>陀螺零偏：关</button>
      <button type="button" class="cf-btn" data-cf-pause>暂停</button>
      <button type="button" class="cf-btn" data-cf-reset>复位</button>
    </div>
  </div>

  <div class="cf-readout">
    <div class="cf-fields">
      <div class="cf-field"><span class="cf-field-k">真值 roll</span><span class="cf-field-v" data-cf-out="true">0.0°</span></div>
      <div class="cf-field"><span class="cf-field-k">融合输出</span><span class="cf-field-v cf-field-fuse" data-cf-out="fuse">0.0°</span></div>
      <div class="cf-field"><span class="cf-field-k">yaw 真值</span><span class="cf-field-v" data-cf-out="yawTrue">0.0°</span></div>
      <div class="cf-field"><span class="cf-field-k">yaw 估计（无重力）</span><span class="cf-field-v cf-field-warn" data-cf-out="yawEst">0.0°</span></div>
    </div>
    <div class="cf-metrics">
      <span>此刻误差</span>
      <span>陀螺积分 <b data-cf-err="g">0.0</b>°</span>
      <span>加速度计 <b data-cf-err="a">0.0</b>°</span>
      <span>融合输出 <b data-cf-err="f">0.0</b>°</span>
      <span>yaw 漂移 <b data-cf-err="yaw">0.0</b>°</span>
    </div>
    <div class="cf-peaks"><span data-cf-out="peak">峰值误差：陀螺积分 0.0° · 加速度计 0.0° · 融合 0.0°</span></div>
    <div class="cf-note" data-cf-out="warn"></div>
    <div class="cf-note">yaw 没有重力观测：零偏把估计单调拉开，这就是“不可观”，调增益补不回来。噪声与零偏量级为教学示意，漂移与融合行为是真实的。</div>
  </div>
</figure>

<script>
(function () {
  const D2R = Math.PI / 180;
  const R2D = 180 / Math.PI;
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const fmt1 = (v) => (Math.abs(v) < 0.05 ? "0.0" : (v < 0 ? "−" : "") + Math.abs(v).toFixed(1));

  document.querySelectorAll(".cf-demo").forEach((demo) => {
    if (!(demo instanceof HTMLElement)) return;
    const cfg = JSON.parse(demo.dataset.cf || "{}");
    const ALPHA_DEF = cfg.alpha != null ? cfg.alpha : 0.96;
    const A_MIN = cfg.aMin != null ? cfg.aMin : 0.8;
    const A_MAX = cfg.aMax != null ? cfg.aMax : 0.998;
    const GYRO_N = cfg.gyroN != null ? cfg.gyroN : 0.25;
    const ACC_N = cfg.accN != null ? cfg.accN : 1.5;
    const YAW_BIAS = cfg.yawBias != null ? cfg.yawBias : 0.35;
    const WINDOW = cfg.window != null ? cfg.window : 12;
    const YAW_WINDOW = cfg.yawWindow != null ? cfg.yawWindow : 30;
    const MAXPTS = cfg.maxPts != null ? cfg.maxPts : 600;

    const pick = (name) => demo.querySelector("[data-cf-" + name + "]");
    const alphaEl = pick("alpha");
    const alphaValEl = pick("alpha-val");
    const tauEl = pick("tau");
    const gravityBtn = pick("gravity");
    const biasBtn = pick("bias");
    const pauseBtn = pick("pause");
    const resetBtn = pick("reset");
    const scaleEl = pick("scale");
    const outTrue = pick("out='true'");
    const outFuse = pick("out='fuse'");
    const outYawTrue = pick("out='yawTrue'");
    const outYawEst = pick("out='yawEst'");
    const outPeak = pick("out='peak'");
    const outWarn = pick("out='warn'");
    const errG = pick("err='g'");
    const errA = pick("err='a'");
    const errF = pick("err='f'");
    const errYaw = pick("err='yaw'");
    if (!(alphaEl instanceof HTMLInputElement) || !(gravityBtn instanceof HTMLButtonElement)) return;

    const pathHalo = pick("halo='0'");
    const pathTrue = pick("true='0'");
    const pathGyro = pick("gyro='1'");
    const pathAcc = pick("acc='2'");
    const pathFuseTop = pick("fuse='0'");
    const pathFuseBottom = pick("fuse='2'");

    const X0 = 150;
    const X1 = 940;
    const PLOT_W = X1 - X0;
    const LANES = [
      { top: 66, h: 96, mid: 114 },
      { top: 166, h: 96, mid: 214 },
      { top: 266, h: 84, mid: 314 },
    ];

    let alpha = ALPHA_DEF;
    let gravityOn = true;
    let biasOn = false;
    let paused = false;
    let t = 0;
    let thetaTrue = 0;
    let thetaGyro = 0;
    let thetaFuse = 0;
    let thetaAcc = 0;
    let yawTrue = 0;
    let yawEst = 0;
    let seed = 1234567;
    let hist = { t: [], true: [], gyro: [], acc: [], fuse: [] };
    let yawHist = { true: [], est: [] };
    let peak = { g: 0, a: 0, f: 0 };
    let scaleDeg = 10;
    let lastNow = 0;
    let raf = 0;
    let frame = 0;

    const SAMPLE_T = 0.025;
    const MAIN_WIN_S = WINDOW;
    const YAW_WIN_S = YAW_WINDOW;

    const rnd = () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    };
    const gauss = () => {
      const u = Math.max(rnd(), 1e-9);
      const v = rnd();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    };

    const reset = () => {
      t = 0;
      seed = 1234567;
      thetaTrue = 0;
      thetaGyro = 0;
      thetaFuse = 0;
      thetaAcc = 0;
      yawTrue = 0;
      yawEst = 0;
      hist = { t: [], true: [], gyro: [], acc: [], fuse: [] };
      yawHist = { true: [], est: [] };
      peak = { g: 0, a: 0, f: 0 };
      scaleDeg = 10;
      lastNow = 0;
      paintAll(0, 0, 0, 0);
    };

    const step = (dt) => {
      const wTrue = 25 * (2 * Math.PI / 9) * Math.cos(2 * Math.PI * t / 9) * D2R;
      thetaTrue = 25 * Math.sin(2 * Math.PI * t / 9) * D2R;
      const wMeas = wTrue + (biasOn ? 1.2 * D2R : 0) + gauss() * GYRO_N * D2R * Math.sqrt(dt * 40);
      const motion = Math.min(Math.abs(wTrue) * R2D / 60, 1.5);
      thetaAcc = thetaTrue + gauss() * (ACC_N + 4 * motion) * D2R;
      const dTheta = wMeas * dt;
      thetaGyro += dTheta;
      thetaFuse += dTheta;
      if (gravityOn) thetaFuse = alpha * thetaFuse + (1 - alpha) * thetaAcc;
      yawTrue = 6 * Math.sin(2 * Math.PI * t / 23) * D2R;
      yawEst += (YAW_BIAS * D2R + gauss() * 0.02 * D2R * Math.sqrt(dt * 40)) * dt;
    };

    const trimHist = () => {
      const tCut = t - MAIN_WIN_S - 0.5;
      let drop = 0;
      while (drop < hist.t.length && hist.t[drop] < tCut) drop += 1;
      if (drop > MAXPTS) drop = hist.t.length - MAXPTS;
      if (drop > 0) {
        hist.t.splice(0, drop);
        hist.true.splice(0, drop);
        hist.gyro.splice(0, drop);
        hist.acc.splice(0, drop);
        hist.fuse.splice(0, drop);
      }
      const maxYaw = Math.ceil(YAW_WIN_S / SAMPLE_T);
      if (yawHist.true.length > maxYaw) {
        const d = yawHist.true.length - maxYaw;
        yawHist.true.splice(0, d);
        yawHist.est.splice(0, d);
      }
    };

    const pushHist = () => {
      hist.t.push(t);
      hist.true.push(thetaTrue * R2D);
      hist.gyro.push(thetaGyro * R2D);
      hist.acc.push(thetaAcc * R2D);
      hist.fuse.push(thetaFuse * R2D);
      yawHist.true.push(yawTrue * R2D);
      yawHist.est.push(yawEst * R2D);
      trimHist();
    };

    const pickScale = (maxAbs) => {
      const steps = [5, 10, 20, 50, 100, 200, 500];
      for (const s of steps) if (maxAbs <= s) return s;
      return 1000;
    };

    const toPath = (times, ys, lane, scale, tNow, window) => {
      if (times.length < 2) return "";
      const tStart = tNow - window;
      let d = "";
      for (let i = 0; i < times.length; i += 1) {
        const px = X0 + PLOT_W * (times[i] - tStart) / window;
        if (px < X0 || px > X1) continue;
        const py = lane.mid - (ys[i] / scale) * (lane.h / 2);
        d += (d ? " L " : "M ") + px.toFixed(1) + " " + clamp(py, lane.top + 2, lane.top + lane.h - 2).toFixed(1);
      }
      return d;
    };

    const setPath = (el, d) => { if (el) el.setAttribute("d", d); };

    const renderChart = () => {
      const tNow = hist.t.length ? hist.t[hist.t.length - 1] : 0;
      const dTrue = toPath(hist.t, hist.true, LANES[0], scaleDeg, tNow, MAIN_WIN_S);
      setPath(pathTrue, dTrue);
      setPath(pathHalo, dTrue);
      setPath(pathFuseTop, toPath(hist.t, hist.fuse, LANES[0], scaleDeg, tNow, MAIN_WIN_S));
      setPath(pathGyro, toPath(hist.t, hist.gyro, LANES[1], scaleDeg, tNow, MAIN_WIN_S));
      setPath(pathAcc, toPath(hist.t, hist.acc, LANES[2], scaleDeg, tNow, MAIN_WIN_S));
      setPath(pathFuseBottom, toPath(hist.t, hist.fuse, LANES[2], scaleDeg, tNow, MAIN_WIN_S));
      if (scaleEl) scaleEl.textContent = "纵轴 ±" + scaleDeg + "°";
    };

    const paintAll = (errg, erra, errf, yawErr) => {
      if (outTrue) outTrue.textContent = fmt1(thetaTrue * R2D) + "°";
      if (outFuse) outFuse.textContent = fmt1(thetaFuse * R2D) + "°";
      if (outYawTrue) outYawTrue.textContent = fmt1(yawTrue * R2D) + "°";
      if (outYawEst) outYawEst.textContent = fmt1(yawEst * R2D) + "°";
      if (errG) errG.textContent = fmt1(errg);
      if (errA) errA.textContent = fmt1(erra);
      if (errF) errF.textContent = fmt1(errf);
      if (errYaw) errYaw.textContent = fmt1(yawErr);
      if (outPeak) outPeak.textContent = "峰值误差：陀螺积分 " + fmt1(peak.g) + "° · 加速度计 " + fmt1(peak.a) + "° · 融合 " + fmt1(peak.f) + "°";
      if (outWarn) {
        if (!gravityOn) outWarn.textContent = "重力观测已关闭：融合退化为纯陀螺积分，误差随时间线性增长。";
        else if (biasOn) outWarn.textContent = "已注入陀螺零偏：纯积分持续漂移；融合在 α 较大时也要很久才拉回来。";
        else outWarn.textContent = "";
      }
    };

    const tick = (now) => {
      raf = requestAnimationFrame(tick);
      if (paused) { lastNow = now; return; }
      if (!lastNow) lastNow = now;
      let dt = (now - lastNow) / 1000;
      lastNow = now;
      dt = clamp(dt, 0.001, 0.05);
      step(dt);
      t += dt;
      pushHist();
      const errg = Math.abs(thetaGyro - thetaTrue) * R2D;
      const erra = Math.abs(thetaAcc - thetaTrue) * R2D;
      const errf = Math.abs(thetaFuse - thetaTrue) * R2D;
      const yawErr = Math.abs(yawEst - yawTrue) * R2D;
      peak.g = Math.max(peak.g, errg);
      peak.a = Math.max(peak.a, erra);
      peak.f = Math.max(peak.f, errf);
      const m = Math.max(...hist.true.map(Math.abs), ...hist.fuse.map(Math.abs), 1);
      const want = pickScale(m * 1.4);
      if (want !== scaleDeg) scaleDeg = want;
      frame += 1;
      if (frame % 2 === 0) {
        renderChart();
        paintAll(errg, erra, errf, yawErr);
      }
    };

    alphaEl.addEventListener("input", () => {
      alpha = Number(alphaEl.value) / 1000;
      if (alphaValEl) alphaValEl.textContent = alpha.toFixed(3);
      if (tauEl) tauEl.textContent = "时间常数 ≈ " + ((alpha / (1 - alpha)) * (1 / 30)).toFixed(2) + " s（教学示意）";
    });
    gravityBtn.addEventListener("click", () => {
      gravityOn = !gravityOn;
      gravityBtn.textContent = "重力观测：" + (gravityOn ? "开" : "关");
      gravityBtn.classList.toggle("cf-btn-off", !gravityOn);
      if (!gravityOn) thetaFuse = thetaGyro;
    });
    biasBtn.addEventListener("click", () => {
      biasOn = !biasOn;
      biasBtn.textContent = "陀螺零偏：" + (biasOn ? "开" : "关");
      biasBtn.classList.toggle("cf-btn-off", biasOn);
    });
    pauseBtn.addEventListener("click", () => {
      paused = !paused;
      pauseBtn.textContent = paused ? "继续" : "暂停";
    });
    resetBtn.addEventListener("click", () => { reset(); });
    document.addEventListener("visibilitychange", () => { lastNow = 0; });

    reset();
    if (alphaValEl) alphaValEl.textContent = alpha.toFixed(3);
    if (tauEl) tauEl.textContent = "时间常数 ≈ " + ((alpha / (1 - alpha)) * (1 / 30)).toFixed(2) + " s（教学示意）";
    for (let i = 0; i < 480; i += 1) { step(SAMPLE_T); t += SAMPLE_T; pushHist(); }
    renderChart();
    paintAll(0, 0, 0, 0);
    raf = requestAnimationFrame(tick);
  });
})();
</script>

<style is:global>
  .cf-demo { margin: 1.5rem 0; }
  .cf-demo svg { display: block; width: 100%; max-width: 980px; height: auto; margin: 0 auto; }
  .cf-title { fill: var(--sl-color-text); font-size: 23px; font-weight: 600; }
  .cf-legend { fill: var(--sl-color-gray-2); font-size: 16px; }
  .cf-lane-name { fill: var(--sl-color-text); font-size: 16px; font-weight: 600; }
  .cf-lane-sub { fill: var(--sl-color-gray-3); font-size: 13px; }
  .cf-grid { stroke: var(--sl-color-gray-5); stroke-width: 1; opacity: 0.32; }
  .cf-zero { stroke: var(--sl-color-gray-4); stroke-width: 1; stroke-dasharray: 4 4; opacity: 0.5; }
  .cf-axis, .cf-tick { stroke: var(--sl-color-gray-4); stroke-width: 1.2; }
  .cf-axis-label, .cf-scale-label { fill: var(--sl-color-gray-2); font-size: 15px; }
  .cf-series { fill: none; stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; }
  .cf-true-halo { stroke: var(--sl-color-bg); stroke-width: 6.5; stroke-dasharray: 11 5; opacity: 0.95; }
  .cf-true { stroke: light-dark(#334155, #e2e8f0); stroke-width: 2.4; stroke-dasharray: 11 5; opacity: 0.95; }
  .cf-gyro { stroke: var(--sl-color-accent); }
  .cf-acc { stroke: var(--cf-acc, #b45309); stroke-width: 1.6; opacity: 0.85; }
  .cf-fuse { stroke: var(--cf-fuse, #15803d); stroke-width: 2.6; }

  .cf-controls { display: flex; flex-direction: column; gap: 0.5rem; max-width: 980px; margin: 0.6rem auto 0; }
  .cf-row { display: flex; align-items: center; gap: 0.7rem; margin: 0; flex-wrap: wrap; }
  .cf-row-title { flex: 0 0 10rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.8125rem; }
  .cf-hint { margin: 0; color: var(--sl-color-gray-3); font-size: 0.75rem; }
