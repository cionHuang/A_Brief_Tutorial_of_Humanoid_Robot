---
const urdfUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'models/g1/g1_29dof.urdf';
const cards = [
  { key: 'gyro', title: '只累加陀螺仪读数', note: '跟得上转动，小偏差也会越积越多。', color: '#b879da' },
  { key: 'acc', title: '只看加速度计', note: '能找到倾斜方向，读数会来回波动。', color: '#d18b30' },
  { key: 'fuse', title: '把两者结合起来', note: '跟踪转动，再用重力方向持续校正。', color: '#39a58c' },
];
---
<figure data-urdf={urdfUrl} class="cf-demo" aria-label="身体倾斜时，三种姿态估计的对比演示">
  <header><strong>身体停住了，估计也会停住吗？</strong><p>同一次前倾，三种判断。使用本书的 G1 模型，虚线轮廓是真实姿态，彩色 G1 是估计姿态。</p></header>
  <ol class="cf-steps" aria-label="演示过程">
    <li data-cf-stage="0" aria-current="step">① 向前倾斜</li>
    <li data-cf-stage="1">② 保持不动</li>
    <li data-cf-stage="2">③ 看融合结果</li>
  </ol>
  <div class="cf-scene"><span data-cf-story>身体缓缓向前倾斜，三种估计都在跟随这次转动。</span><strong>真实倾角 <span data-cf-true>0.0°</span></strong></div>
  <div class="cf-cards">
    {cards.map(card => <section class="cf-card" style={`--cf-color:${card.color}`}>
      <h4>{card.title}</h4>
      <div class="cf-model" data-cf-model={card.key} role="img" aria-label={`G1 姿态对照：${card.title}，虚线为真实姿态，实体为估计姿态`}><span data-cf-loading>正在加载 G1…</span></div>
      <div class="cf-reading"><strong data-cf-angle={card.key}>0.0°</strong><span>相差 <b data-cf-error={card.key}>0.0°</b></span></div>
      <p>{card.note}</p>
    </section>)}
  </div>
  <div class="cf-actions"><button type="button" data-cf-play>暂停</button><button type="button" data-cf-replay>从头看</button><span data-cf-time>0 / 18 秒</span></div>
  <figcaption>观察彩色 G1 与虚线的距离：陀螺积分逐渐偏离，加速度计来回摆动，融合结果更贴近真实姿态。这里用 G1 单轴倾斜说明原理，零偏和波动为教学示意；融合权重固定。</figcaption>
  <noscript>例如身体保持前倾 15° 时，陀螺仪的小偏差会不断累积；加速度计给出的倾角在 15° 附近波动。互补滤波结合两者，持续校正倾角。</noscript>
</figure>
<script>
  import { createG1EstimationView } from '../lib/g1-estimation-view.js';
  import { createVisibleRaf } from '../lib/visible-raf.js';
  document.querySelectorAll<HTMLElement>('.cf-demo').forEach(demo => {
    const pick = (s: string) => demo.querySelector<HTMLElement>(s)!;
    const play = pick('[data-cf-play]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const dt = 0.02;
    const alpha = Math.exp(-dt / 0.65);
    const angle = (t: number) => t >= 4 ? 15 : 7.5 * (1 - Math.cos(Math.PI * t / 4));
    let t = 0, truth = 0, gyro = 0, acc = 0, fuse = 0;
    let paused = reduced.matches, last = 0, remainder = 0;
    let view, loading = false;
    const stories = [
      '身体缓缓向前倾斜，三种估计都在跟随这次转动。',
      '身体停在 15°。陀螺仪的小偏差还在累积，紫色 G1 继续向前偏。',
      '看绿色 G1：重力方向持续校正漂移，融合后的姿态保持在真实姿态附近。',
    ];
    function paint() {
      const stage = t < 4 ? 0 : t < 10 ? 1 : 2;
      demo.querySelectorAll<HTMLElement>('[data-cf-stage]').forEach((el, i) => {
        if (i === stage) el.setAttribute('aria-current', 'step'); else el.removeAttribute('aria-current');
      });
      pick('[data-cf-story]').textContent = stories[stage];
      pick('[data-cf-true]').textContent = truth.toFixed(1) + '°';
      view?.render({truth, gyro, acc, fuse});
      Object.entries({gyro, acc, fuse}).forEach(([key, value]) => {
        pick(`[data-cf-angle="${key}"]`).textContent = value.toFixed(1) + '°';
        pick(`[data-cf-error="${key}"]`).textContent = Math.abs(value - truth).toFixed(1) + '°';
      });
      pick('[data-cf-time]').textContent = `${Math.floor(t + 0.001)} / 18 秒`;
      play.textContent = t >= 18 ? '再看一遍' : paused ? '播放' : '暂停';
    }
    // Fixed 50 Hz integration makes the result independent of screen refresh rate.
    function step() {
      const before = truth;
      t = Math.min(18, t + dt);
      truth = angle(t);
      const increment = truth - before + 0.8 * dt;
      gyro += increment;
      acc = truth + (1 - Math.exp(-t * 3)) * (2.8 * Math.sin(t * 13) + 1.2 * Math.sin(t * 23));
      fuse = alpha * (fuse + increment) + (1 - alpha) * acc;
    }
    async function loadModel() {
      if (loading) return;
      loading = true;
      try {
        view = await createG1EstimationView(demo, demo.dataset.urdf);
        demo.querySelectorAll<HTMLElement>('[data-cf-loading]').forEach(el => { el.hidden = true; });
        paint(); if (!paused) loop.start();
      } catch {
        demo.querySelectorAll<HTMLElement>('[data-cf-loading]').forEach(el => { el.textContent = 'G1 加载失败，请刷新重试'; });
      }
    }
    const loop = createVisibleRaf(demo, {rootMargin: '0px', onEnter: () => { last = 0; void loadModel(); }});
    loop.onFrame(now => {
      if (paused || !view) return false;
      if (last) remainder += Math.min((now - last) / 1000, 0.05);
      last = now;
      while (remainder >= dt && t < 18) { step(); remainder -= dt; }
      if (t >= 18) { paused = true; loop.stop(); }
      paint();
      return !paused;
    });
    function restart() {
      t = truth = gyro = acc = fuse = last = remainder = 0;
      paused = false; paint(); loop.start();
    }
    play.addEventListener('click', () => {
      if (t >= 18) return restart();
      paused = !paused; last = 0;
      if (paused) loop.stop(); else loop.start();
      paint();
    });
    pick('[data-cf-replay]').addEventListener('click', restart);
    reduced.addEventListener('change', () => { if (reduced.matches) { paused = true; loop.stop(); paint(); } });
    document.addEventListener('visibilitychange', () => { last = 0; });
    paint();
    if (!paused) loop.start();
  });
</script>
<style>
  .cf-demo { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 14px; background: var(--sl-color-bg); }
  .cf-demo :is(p, h4, ol, li, section, header, figcaption, div) { margin: 0; }
  .cf-demo header strong { font-size: 1.1rem; }
  .cf-demo header p, .cf-demo figcaption { margin-top: .5rem; font-size: .85rem; color: var(--sl-color-gray-2); line-height: 1.7; }
  .cf-steps { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; list-style: none; margin-top: 1rem !important; }
  .cf-steps li { padding: .3rem .6rem; font-size: .8rem; border-radius: 6px; color: var(--sl-color-gray-2); }
  .cf-steps [aria-current] { background: var(--sl-color-accent-low); color: var(--sl-color-text-accent); font-weight: 700; }
  .cf-scene { display: grid; gap: .35rem; margin: .8rem 0 !important; min-height: 5.5rem; font-size: .9rem; }
  .cf-scene strong { font-variant-numeric: tabular-nums; }
  .cf-cards { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .6rem; }
  .cf-card { border: 1px solid var(--sl-color-gray-5); border-top: 3px solid var(--cf-color); border-radius: 8px; padding: .65rem; min-width: 0; }
  .cf-card h4 { font-size: .85rem; line-height: 1.6; }
  .cf-model { width: 100%; height: 210px; position: relative; }
  .cf-model span { position: absolute; inset: 40% 0 auto; text-align: center; font-size: .8rem; }
  .cf-reading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem .5rem; font-variant-numeric: tabular-nums; }
  .cf-reading strong { font-size: 1.3rem; }
  .cf-reading span { font-size: .75rem; color: var(--sl-color-gray-2); }
  .cf-card p { margin-top: .4rem; font-size: .8rem; line-height: 1.6; }
  .cf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin-top: 1rem !important; }
  .cf-actions button { margin: 0; min-height: 44px; padding: .4rem 1rem; border: 1px solid var(--sl-color-gray-4); border-radius: 8px; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; font-size: .85rem; cursor: pointer; }
  .cf-actions button:hover { border-color: var(--sl-color-text-accent); }
  .cf-actions button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .cf-actions span { font-size: .8rem; color: var(--sl-color-gray-2); }
  @media(max-width: 600px) {
    .cf-demo { padding: .75rem; }
    .cf-cards { grid-template-columns: 1fr; }
    .cf-card { display: grid; grid-template-columns: 105px minmax(0,1fr); gap: .3rem .5rem; align-items: center; }
    .cf-card .cf-model { height: 145px; grid-column: 1; grid-row: 1 / 4; }
    .cf-card h4, .cf-card .cf-reading, .cf-card p { grid-column: 2; }
    .cf-card .cf-reading { justify-content: flex-start; }
    .cf-scene { min-height: 7rem; }
  }
</style>
