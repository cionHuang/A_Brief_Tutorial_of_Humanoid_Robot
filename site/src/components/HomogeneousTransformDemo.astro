---
/**
 * 齐次变换与坐标链（Homogeneous Transform）交互演示：一条 2D 侧视的简化腿链
 * W → P → 髋 → 膝 → 踝 → F，每个关节挂一个随关节角旋转的小坐标架，脚端留下
 * 一条淡淡轨迹。
 *
 * 教学要点：
 *   ① 一个齐次变换一次乘法同时完成“旋转 + 平移”，所以一个矩阵就能描述一段位姿；
 *   ② 沿运动链相乘时顺序不能颠倒、下标必须首尾相接：T_WF = T_WP · T_PL1 · T_L1L2 · T_L2F；
 *   ③ 换顺序后矩阵维度仍然能相乘，但物理结果完全错误——这正是仿真里“目标跑偏”的常见原因。
 *
 * 数据模型（教学示意，单位 m 与角度，非 G1 真实尺寸）：
 *   世界原点 W=(0,0)，骨盆相对 W 平移 (0.55, 0.86)；
 *   大腿 l1=0.44、小腿 l2=0.42、脚 l3=0.20；
 *   每段局部变换 = 绕关节旋转 θ，再沿旋转后的 x 轴平移 l（先旋转再平移），
 *   T_WF = T_WP · T_PL1 · T_L1L2 · T_L2F。
 *
 * 交互：默认静止不自动播放；三个滑块调髋/膝/踝角，“顺序颠倒”按钮把链式乘积
 * 换成错误排列并把脚端画到明显错误的位置，“复位”回到默认站立姿态。所有 SVG
 * 图形都写在 markup 里，JS 只用 setAttribute 改属性 / textContent / classList
 * （不改 class 属性、不写死颜色），样式跟随 Starlight 明暗主题。
 *
 * 使用方式（放在 4.1 节“### 位姿（Pose）与齐次变换（Homogeneous Transform）”下方）：
 *   import HomogeneousTransformDemo from '../../../components/HomogeneousTransformDemo.astro';
 *   <HomogeneousTransformDemo />
 */
const WORLD = { x: 110, y: 340 };   // 世界原点 W（左下）
const SCALE = 240;                  // 1 m = 240 px（教学示意）

// 段长与骨盆相对世界的平移（m）
const LINK = { wp: { x: 0.55, y: 0.86 }, l1: 0.44, l2: 0.42, l3: 0.2 };

const JOINTS = [
  { key: 'hip', name: '髋角', min: -45, max: 45, step: 1, def: 15 },
  { key: 'knee', name: '膝角', min: 0, max: 80, step: 1, def: 35 },
  { key: 'ankle', name: '踝角', min: -40, max: 40, step: 1, def: 10 },
];
const DEF = {};
JOINTS.forEach((j) => { DEF[j.key] = j.def; });

// 正常链各段下标首尾相接；颠倒链故意打乱后仍可相乘，但物理结果错误
const ORDER = {
  good: [['wp', 'T_WP'], ['pl1', 'T_PL1'], ['l1l2', 'T_L1L2'], ['l2f', 'T_L2F']],
  bad: [['l1l2', 'T_L1L2'], ['wp', 'T_WP'], ['l2f', 'T_L2F'], ['pl1', 'T_PL1']],
};

// 四个变换标签的文字锚点与引线起点（固定，引线端点随连杆中点更新）
const LABELS = [
  { x: 36, y: 254 },
  { x: 350, y: 156 },
  { x: 350, y: 262 },
  { x: 350, y: 352 },
];
const LEADER_STARTS = [
  { x: 92, y: 250 },
  { x: 346, y: 160 },
  { x: 346, y: 266 },
  { x: 346, y: 348 },
];

const d2r = (d) => (d * Math.PI) / 180;
// 3×3 齐次矩阵（数学坐标，y 向上），[a,b,c, d,e,f, g,h,i] 行优先
const MAT = {
  id: () => [1, 0, 0, 0, 1, 0, 0, 0, 1],
  rot: (deg) => {
    const c = Math.cos(d2r(deg));
    const s = Math.sin(d2r(deg));
    return [c, -s, 0, s, c, 0, 0, 0, 1];
  },
  trans: (x, y) => [1, 0, x, 0, 1, y, 0, 0, 1],
  mul: (A, B) => [
    A[0] * B[0] + A[1] * B[3] + A[2] * B[6], A[0] * B[1] + A[1] * B[4] + A[2] * B[7], A[0] * B[2] + A[1] * B[5] + A[2] * B[8],
    A[3] * B[0] + A[4] * B[3] + A[5] * B[6], A[3] * B[1] + A[4] * B[4] + A[5] * B[7], A[3] * B[2] + A[4] * B[5] + A[5] * B[8],
    A[6] * B[0] + A[7] * B[3] + A[8] * B[6], A[6] * B[1] + A[7] * B[4] + A[8] * B[7], A[6] * B[2] + A[7] * B[5] + A[8] * B[8],
  ],
  apply: (A, p) => [A[0] * p[0] + A[1] * p[1] + A[2], A[3] * p[0] + A[4] * p[1] + A[5]],
};
const toScreen = (p) => ({ x: WORLD.x + p[0] * SCALE, y: WORLD.y - p[1] * SCALE });

// 每段的局部齐次变换：先绕关节旋转 θ，再沿旋转后的 x 轴平移 l
const parts = (hip, knee, ankle) => ({
  wp: MAT.trans(LINK.wp.x, LINK.wp.y),
  pl1: MAT.mul(MAT.rot(-90 + hip), MAT.trans(LINK.l1, 0)),
  l1l2: MAT.mul(MAT.rot(-knee), MAT.trans(LINK.l2, 0)),
  l2f: MAT.mul(MAT.rot(90 + ankle), MAT.trans(LINK.l3, 0)),
});
const chain = (keys, P) => keys.reduce((A, k) => MAT.mul(A, P[k]), MAT.id());

const pose = (hip, knee, ankle) => {
  const P = parts(hip, knee, ankle);
  const mWP = P.wp;
  const mPL1 = MAT.mul(mWP, P.pl1);
  const mL1L2 = MAT.mul(mPL1, P.l1l2);
  const good = MAT.mul(mL1L2, P.l2f);
  const bad = chain(ORDER.bad.map((d) => d[0]), P);
  return {
    W: toScreen([0, 0]),
    P: toScreen(MAT.apply(mWP, [0, 0])),
    knee: toScreen(MAT.apply(mPL1, [0, 0])),
    ankle: toScreen(MAT.apply(mL1L2, [0, 0])),
    foot: toScreen(MAT.apply(good, [0, 0])),
    badFoot: toScreen(MAT.apply(bad, [0, 0])),
    beta: -hip + knee - ankle,   // 末端坐标架在 SVG 里的旋转角
  };
};

const DEF_POSE = pose(DEF.hip, DEF.knee, DEF.ankle);
const BETA = { p: 90 - DEF.hip, knee: 90 - DEF.hip + DEF.knee, foot: DEF_POSE.beta };
const FRAME_DEFS = [
  { role: 'frame-p', point: 'P', beta: BETA.p },
  { role: 'frame-knee', point: 'knee', beta: BETA.knee },
  { role: 'frame-ankle', point: 'ankle', beta: BETA.foot },
  { role: 'frame-foot', point: 'foot', beta: BETA.foot },
];
const SEGS = [
  [DEF_POSE.W, DEF_POSE.P],
  [DEF_POSE.P, DEF_POSE.knee],
  [DEF_POSE.knee, DEF_POSE.ankle],
  [DEF_POSE.ankle, DEF_POSE.foot],
];
const MID = SEGS.map((s) => ({ x: (s[0].x + s[1].x) / 2, y: (s[0].y + s[1].y) / 2 }));

// 轨迹：髋角从 min 扫到 max 时脚端的位置（顺序正确时才有物理意义）
const TRAIL_PTS = [];
for (let i = 0; i <= 30; i++) {
  const h = JOINTS[0].min + ((JOINTS[0].max - JOINTS[0].min) * i) / 30;
  const p = pose(h, DEF.knee, DEF.ankle).foot;
  TRAIL_PTS.push(p.x.toFixed(1) + ',' + p.y.toFixed(1));
}
const trailPoints = TRAIL_PTS.join(' ');

const xf = (pt, deg) => 'translate(' + pt.x.toFixed(1) + ' ' + pt.y.toFixed(1) + ') rotate(' + deg.toFixed(1) + ')';

const CFG = {
  world: WORLD,
  scale: SCALE,
  link: LINK,
  joints: JOINTS,
  def: DEF,
  order: ORDER,
  leaderStarts: LEADER_STARTS,
};
---

<figure class="ht-demo" data-ht={JSON.stringify(CFG)}>
  <svg viewBox="0 0 900 430" role="img" aria-label="齐次变换与坐标链教学示意：一条二维侧视简化腿链从世界原点 W 依次经过骨盆 P、髋、膝到踝和脚端 F，每个关节挂一个随角度旋转的坐标架；上方一行是四段变换矩阵相乘的链式表达式，可切换到顺序颠倒，此时脚端会被画到明显错误的位置">
    <text class="ht-title" x="24" y="28">齐次变换与坐标链：顺序不能颠倒（教学示意）</text>

    <!-- 矩阵链：正常时下标首尾相接，颠倒时整行变警示色 -->
    <g class="ht-chain" data-role="chain">
      <rect class="ht-chain-box" x="16" y="44" width="868" height="42" rx="8"></rect>
      <text class="ht-chain-text" data-role="chain-text" x="30" y="72">T_WF = T_WP · T_PL1 · T_L1L2 · T_L2F</text>
      <text class="ht-chain-badge" data-role="chain-badge" x="870" y="71" text-anchor="end">✅ 首尾相接</text>
    </g>

    <!-- 地面参考线 -->
    <line class="ht-ground" x1="40" y1="340" x2="880" y2="340"></line>

    <!-- 脚端轨迹：髋角扫过时留下的淡淡轨迹 -->
    <polyline class="ht-trail" data-role="trail" points={trailPoints}></polyline>

    <!-- 连杆：W-P、P-膝、膝-踝、踝-F -->
    {SEGS.map((s, i) => (
      <line
        class="ht-link"
        data-role="link"
        data-i={i}
        x1={s[0].x.toFixed(1)}
        y1={s[0].y.toFixed(1)}
        x2={s[1].x.toFixed(1)}
        y2={s[1].y.toFixed(1)}
      ></line>
    ))}

    <!-- 顺序颠倒时的错误连线：踝 → 错误的脚端 -->
    <line
      class="ht-err-link ht-hidden"
      data-role="err-link"
      x1={DEF_POSE.ankle.x.toFixed(1)}
      y1={DEF_POSE.ankle.y.toFixed(1)}
      x2={DEF_POSE.badFoot.x.toFixed(1)}
      y2={DEF_POSE.badFoot.y.toFixed(1)}
    ></line>

    <!-- 世界坐标架（固定不动） -->
    <g class="ht-frame ht-frame-w" transform={xf({ x: WORLD.x, y: WORLD.y }, 0)}>
      <line class="ht-ax" x1="0" y1="0" x2="24" y2="0"></line>
      <line class="ht-ax" x1="0" y1="0" x2="0" y2="-24"></line>
      <circle class="ht-joint-dot" cx="0" cy="0" r="3.4"></circle>
      <text class="ht-ax-label" x="28" y="6">x</text>
      <text class="ht-ax-label" x="-6" y="-28">y</text>
    </g>

    <!-- 关节坐标架：每个随关节角旋转，transform 由 JS 更新 -->
    {FRAME_DEFS.map((f) => (
      <g class="ht-frame" data-role={f.role} transform={xf(DEF_POSE[f.point], f.beta)}>
        <line class="ht-ax" x1="0" y1="0" x2="22" y2="0"></line>
        <line class="ht-ax" x1="0" y1="0" x2="0" y2="-22"></line>
        <circle class="ht-joint-dot" cx="0" cy="0" r="3.2"></circle>
      </g>
    ))}

    <!-- 顺序正确时的脚端“幽灵”位置（仅颠倒模式显示） -->
    <g class="ht-ghost" data-role="ghost" transform={xf(DEF_POSE.foot, BETA.foot)}>
      <circle cx="0" cy="0" r="8"></circle>
      <circle cx="0" cy="0" r="2.4"></circle>
    </g>

    <!-- 四段变换标签：文字锚点固定，引线指向当前连杆中点 -->
    {ORDER.good.map((d, i) => (
      <g>
        <line
          class="ht-leader"
          data-role="leader"
          data-i={i}
          x1={LEADER_STARTS[i].x}
          y1={LEADER_STARTS[i].y}
          x2={MID[i].x.toFixed(1)}
          y2={MID[i].y.toFixed(1)}
        ></line>
        <text class="ht-link-label" data-role="label" data-i={i} x={LABELS[i].x} y={LABELS[i].y}>{d[1]}</text>
      </g>
    ))}

    <!-- 关节名 -->
    <text class="ht-joint-label" x={WORLD.x} y="372" text-anchor="middle">W 世界原点</text>
    <text class="ht-joint-label" x={(DEF_POSE.P.x + 14).toFixed(1)} y={(DEF_POSE.P.y - 16).toFixed(1)}>P 骨盆（髋关节）</text>
    <text class="ht-joint-label" x={(DEF_POSE.knee.x + 14).toFixed(1)} y={(DEF_POSE.knee.y + 18).toFixed(1)}>膝</text>
    <text class="ht-joint-label" x={(DEF_POSE.ankle.x - 14).toFixed(1)} y={(DEF_POSE.ankle.y + 18).toFixed(1)} text-anchor="end">踝</text>
    <text class="ht-foot-label" data-role="foot-label" x={(DEF_POSE.foot.x + 14).toFixed(1)} y={(DEF_POSE.foot.y + 34).toFixed(1)}>F 脚端</text>

    <!-- 教学要点 -->
    <text class="ht-note" x="24" y="400">每一步都是「先旋转，再平移」；矩阵乘法不可交换。</text>
    <text class="ht-note" x="24" y="422">换顺序后维度仍能相乘，但物理结果完全错误——这正是仿真里「目标跑偏」的常见原因。</text>
  </svg>

  <div class="ht-controls">
    <button type="button" class="ht-btn ht-order" data-order aria-pressed="false">顺序颠倒 ✗</button>
    <button type="button" class="ht-btn" data-reset>复位</button>
    {JOINTS.map((j) => (
      <label class="ht-slider-label">{j.name} <span class="ht-val" data-val={j.key}>{j.def}°</span>
        <input class="ht-range" type="range" data-range={j.key} min={j.min} max={j.max} step={j.step} value={j.def} />
      </label>
    ))}
  </div>

  <div class="ht-readout">
    <output class="ht-out ht-out-pose" aria-live="polite"></output>
    <output class="ht-out ht-out-chain" aria-live="polite"></output>
  </div>

  <figcaption>
    拖动髋 / 膝 / 踝三个角度看脚端怎么走；点“顺序颠倒”把式中四段换个位置，脚端立刻跑到不可能的位置。数值为教学示意。
  </figcaption>
</figure>

<script>
  document.querySelectorAll('.ht-demo').forEach((demo) => {
    const cfg = JSON.parse(demo.dataset.ht);
    const world = cfg.world;
    const scale = cfg.scale;
    const link = cfg.link;
    const joints = cfg.joints;
    const def = cfg.def;
    const order = cfg.order;
    const starts = cfg.leaderStarts;

    // 与 frontmatter 完全一致的 2D 齐次变换工具
    const d2r = (d) => (d * Math.PI) / 180;
    const M = {
      id: () => [1, 0, 0, 0, 1, 0, 0, 0, 1],
      rot: (deg) => {
        const c = Math.cos(d2r(deg));
        const s = Math.sin(d2r(deg));
        return [c, -s, 0, s, c, 0, 0, 0, 1];
      },
      trans: (x, y) => [1, 0, x, 0, 1, y, 0, 0, 1],
      mul: (A, B) => [
        A[0] * B[0] + A[1] * B[3] + A[2] * B[6], A[0] * B[1] + A[1] * B[4] + A[2] * B[7], A[0] * B[2] + A[1] * B[5] + A[2] * B[8],
        A[3] * B[0] + A[4] * B[3] + A[5] * B[6], A[3] * B[1] + A[4] * B[4] + A[5] * B[7], A[3] * B[2] + A[4] * B[5] + A[5] * B[8],
        A[6] * B[0] + A[7] * B[3] + A[8] * B[6], A[6] * B[1] + A[7] * B[4] + A[8] * B[7], A[6] * B[2] + A[7] * B[5] + A[8] * B[8],
      ],
      apply: (A, p) => [A[0] * p[0] + A[1] * p[1] + A[2], A[3] * p[0] + A[4] * p[1] + A[5]],
    };
    const toScreen = (p) => ({ x: world.x + p[0] * scale, y: world.y - p[1] * scale });
    const parts = (hip, knee, ankle) => ({
      wp: M.trans(link.wp.x, link.wp.y),
      pl1: M.mul(M.rot(-90 + hip), M.trans(link.l1, 0)),
      l1l2: M.mul(M.rot(-knee), M.trans(link.l2, 0)),
      l2f: M.mul(M.rot(90 + ankle), M.trans(link.l3, 0)),
    });
    const chain = (keys, P) => keys.reduce((A, k) => M.mul(A, P[k]), M.id());
    const pose = (hip, knee, ankle) => {
      const P = parts(hip, knee, ankle);
      const mWP = P.wp;
      const mPL1 = M.mul(mWP, P.pl1);
      const mL1L2 = M.mul(mPL1, P.l1l2);
      const good = M.mul(mL1L2, P.l2f);
      const bad = chain(order.bad.map((d) => d[0]), P);
      return {
        W: toScreen([0, 0]),
        P: toScreen(M.apply(mWP, [0, 0])),
        knee: toScreen(M.apply(mPL1, [0, 0])),
        ankle: toScreen(M.apply(mL1L2, [0, 0])),
        foot: toScreen(M.apply(good, [0, 0])),
        badFoot: toScreen(M.apply(bad, [0, 0])),
        beta: -hip + knee - ankle,
      };
    };

    const el = (sel) => demo.querySelector(sel);
    const trailEl = el('[data-role="trail"]');
    const linkEls = [0, 1, 2, 3].map((i) => el('[data-role="link"][data-i="' + i + '"]'));
    const errEl = el('[data-role="err-link"]');
    const frameP = el('[data-role="frame-p"]');
    const frameKnee = el('[data-role="frame-knee"]');
    const frameAnkle = el('[data-role="frame-ankle"]');
    const frameFoot = el('[data-role="frame-foot"]');
    const ghostEl = el('[data-role="ghost"]');
    const leaderEls = [0, 1, 2, 3].map((i) => el('[data-role="leader"][data-i="' + i + '"]'));
    const footLabel = el('[data-role="foot-label"]');
    const chainGroup = el('[data-role="chain"]');
    const chainText = el('[data-role="chain-text"]');
    const chainBadge = el('[data-role="chain-badge"]');
    const poseOut = el('.ht-out-pose');
    const chainOut = el('.ht-out-chain');
    const orderBtn = el('[data-order]');
    const resetBtn = el('[data-reset]');
    const rangeEls = joints.map((j) => el('[data-range="' + j.key + '"]'));
    const valEls = {};
    joints.forEach((j) => { valEls[j.key] = el('[data-val="' + j.key + '"]'); });

    // 状态：三个关节角 + 是否处于“顺序颠倒”
    const state = { hip: def.hip, knee: def.knee, ankle: def.ankle, bad: false };

    const setLine = (node, a, b) => {
      if (!node) return;
      node.setAttribute('x1', a.x.toFixed(1));
      node.setAttribute('y1', a.y.toFixed(1));
      node.setAttribute('x2', b.x.toFixed(1));
      node.setAttribute('y2', b.y.toFixed(1));
    };
    const xform = (pt, deg) => 'translate(' + pt.x.toFixed(1) + ' ' + pt.y.toFixed(1) + ') rotate(' + deg.toFixed(1) + ')';
    const fmtDeg = (v) => (v < 0 ? '−' + Math.abs(v).toFixed(0) : v.toFixed(0));

    const render = () => {
      const p = pose(state.hip, state.knee, state.ankle);
      const foot = state.bad ? p.badFoot : p.foot;
      const names = order[state.bad ? 'bad' : 'good'].map((d) => d[1]);
      const betaP = 90 - state.hip;
      const betaKnee = 90 - state.hip + state.knee;

      // 连杆：正常时踝→F 是真实连杆；颠倒时隐藏它，改画警示虚线
      setLine(linkEls[0], p.W, p.P);
      setLine(linkEls[1], p.P, p.knee);
      setLine(linkEls[2], p.knee, p.ankle);
      setLine(linkEls[3], p.ankle, p.foot);
      setLine(errEl, p.ankle, p.badFoot);
      linkEls[3].classList.toggle('ht-hidden', state.bad);
      errEl.classList.toggle('ht-hidden', !state.bad);

      // 关节坐标架 + 脚端坐标架（位置随链走，姿态随累计角度转）
      frameP.setAttribute('transform', xform(p.P, betaP));
      frameKnee.setAttribute('transform', xform(p.knee, betaKnee));
      frameAnkle.setAttribute('transform', xform(p.ankle, p.beta));
      frameFoot.setAttribute('transform', xform(foot, p.beta));
      frameFoot.classList.toggle('ht-bad', state.bad);
      ghostEl.setAttribute('transform', xform(p.foot, p.beta));
      ghostEl.classList.toggle('ht-show', state.bad);

      // 轨迹：髋角扫过 31 个采样点的脚端位置
      const pts = [];
      for (let i = 0; i <= 30; i++) {
        const h = joints[0].min + ((joints[0].max - joints[0].min) * i) / 30;
        const fp = pose(h, state.knee, state.ankle).foot;
        pts.push(fp.x.toFixed(1) + ',' + fp.y.toFixed(1));
      }
      trailEl.setAttribute('points', pts.join(' '));
      trailEl.classList.toggle('ht-off', state.bad);

      // 标签引线指向当前连杆中点
      const segs = [[p.W, p.P], [p.P, p.knee], [p.knee, p.ankle], [p.ankle, p.foot]];
      segs.forEach((s, i) => {
        setLine(leaderEls[i], starts[i], { x: (s[0].x + s[1].x) / 2, y: (s[0].y + s[1].y) / 2 });
      });

      // 脚端标签跟随脚端
      footLabel.setAttribute('x', (foot.x + 14).toFixed(1));
      footLabel.setAttribute('y', (foot.y + 34).toFixed(1));
      footLabel.textContent = state.bad ? 'F′ 顺序错' : 'F 脚端';
      footLabel.classList.toggle('ht-bad', state.bad);

      // 链式表达式与下标检查
      chainText.textContent = 'T_WF = ' + names.join(' · ');
      chainBadge.textContent = state.bad ? '❌ 下标断开' : '✅ 首尾相接';
      chainGroup.classList.toggle('ht-bad', state.bad);

      const mx = (foot.x - world.x) / scale;
      const my = (world.y - foot.y) / scale;
      const phi = state.hip - state.knee + state.ankle;
      poseOut.textContent =
        (state.bad ? '脚端相对世界（顺序颠倒）：' : '脚端相对世界：') +
        'x = ' + mx.toFixed(2) + ' m，y = ' + my.toFixed(2) + ' m，姿态角 = ' + fmtDeg(phi) + '°' +
        (state.bad ? ' ❌' : '');
      poseOut.classList.toggle('ht-bad', state.bad);

      chainOut.textContent =
        '下标检查：' + names.join('·') +
        (state.bad ? ' ❌ 下标断开，结果无物理意义' : ' ✅ 首尾相接');
      chainOut.classList.toggle('ht-bad', state.bad);

      orderBtn.textContent = state.bad ? '顺序正确 ✓' : '顺序颠倒 ✗';
      orderBtn.setAttribute('aria-pressed', String(state.bad));
      joints.forEach((j) => { valEls[j.key].textContent = state[j.key] + '°'; });
    };

    orderBtn.addEventListener('click', () => {
      state.bad = !state.bad;
      render();
    });

    resetBtn.addEventListener('click', () => {
      state.hip = def.hip;
      state.knee = def.knee;
      state.ankle = def.ankle;
      state.bad = false;
      rangeEls.forEach((r, i) => { if (r) r.value = def[joints[i].key]; });
      render();
    });

    rangeEls.forEach((r, i) => {
      if (!r) return;
      r.addEventListener('input', () => {
        state[joints[i].key] = Number(r.value);
        render();
      });
    });

    render();
  });
</script>

