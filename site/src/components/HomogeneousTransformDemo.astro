---
/**
 * 位姿与齐次变换（Homogeneous Transform）交互演示：笛卡尔世界坐标系 W 中放一个
 * 可拖动的位姿坐标系 B，右侧用 4×4 齐次变换矩阵 T_WB 的 16 个数字同步显示它的
 * 位置与姿态。
 *
 * 教学要点：
 *   ① 一个 4×4 矩阵 = 左上 3×3 的旋转 R + 右上 3×1 的位置 p + 末行 [0 0 0 1]；
 *   ② 坐标架 B 的原点就是 p=(x,y,z)，三根短轴的方向就是 R 的三列；
 *   ③ 一次矩阵乘法同时完成旋转和平移，所以一个矩阵就描述了一个完整位姿。
 *
 * 数据模型（教学示意）：
 *   位置 x,y ∈ [−0.5, 1.0] m（默认 0.40, 0.10），z ∈ [0, 0.8] m（默认 0.30）；
 *   姿态 roll/pitch/yaw ∈ [−180°, 180°]（默认 0°, 0°, 30°）；
 *   R = Rz(yaw) · Ry(pitch) · Rx(roll)（URDF/ROS 常用的 ZYX 顺序），
 *   T_WB = [[R, p], [0 0 0 1]]。
 *   左区为等距投影：x 基 (0.866, 0.5)、y 基 (−0.866, 0.5)、z 向上 (0, −1)，
 *   比例 140 px/m（约 150），世界原点在屏幕 (250, 273)，地面覆盖 x/y ∈ [−0.5, 1.0] m。
 *
 * 交互：默认静止、无动画；拖任意滑块，坐标架 B 与矩阵 16 个数字实时更新；
 * “只留旋转”把位置归零（右上 3×1 变 0），“只留平移”把姿态归零（左上 3×3 变
 * 单位阵），“复位”回默认。所有 SVG 图形都写在 markup 里，JS 只改属性 /
 * textContent / classList（不 setAttribute('class')、不写死颜色）。
 *
 * 使用方式（放在 4.1 节“### 位姿（Pose）与齐次变换（Homogeneous Transform）”下方）：
 *   import HomogeneousTransformDemo from '../../../components/HomogeneousTransformDemo.astro';
 *   <HomogeneousTransformDemo />
 */
const d2r = (d) => (d * Math.PI) / 180;

// ── 左区：等距投影的三维世界坐标系 W ─────────────────────────────────────────
const WORLD = { x: 250, y: 273 };          // 世界原点在屏幕上的位置
const SCALE = 140;                          // 1 m 对应的屏幕像素
const ISO = { ax: 0.866, ay: 0.5 };         // x/y 等距基；z 用 (0, −1)
const proj = (X, Y, Z) => ({
  x: WORLD.x + SCALE * (ISO.ax * X - ISO.ax * Y),
  y: WORLD.y + SCALE * (ISO.ay * X + ISO.ay * Y - Z),
});

const R_GEO = { xmin: -0.5, xmax: 1.0, ymin: -0.5, ymax: 1.0, zmin: 0, zmax: 0.8 };
const L_AXIS = 0.2;                         // 位姿坐标架三根短轴的长度（m），约 28 px

// ── 滑块（位置 3 个 + 姿态 3 个） ────────────────────────────────────────────
const SLIDERS = [
  { key: 'x', name: 'x', min: -0.5, max: 1.0, step: 0.01, def: 0.4, kind: 'pos' },
  { key: 'y', name: 'y', min: -0.5, max: 1.0, step: 0.01, def: 0.1, kind: 'pos' },
  { key: 'z', name: 'z', min: 0, max: 0.8, step: 0.01, def: 0.3, kind: 'pos' },
  { key: 'roll', name: 'roll', min: -180, max: 180, step: 1, def: 0, kind: 'ang' },
  { key: 'pitch', name: 'pitch', min: -180, max: 180, step: 1, def: 0, kind: 'ang' },
  { key: 'yaw', name: 'yaw', min: -180, max: 180, step: 1, def: 30, kind: 'ang' },
];
const DEF = {};
SLIDERS.forEach((s) => { DEF[s.key] = s.def; });

// ── 旋转与 4×4 齐次变换 ──────────────────────────────────────────────────────
// R = Rz(yaw)·Ry(pitch)·Rx(roll)，返回行优先的 3×3（其列 = 机体轴在世界系中的方向）
const rot = (roll, pitch, yaw) => {
  const cr = Math.cos(d2r(roll)); const sr = Math.sin(d2r(roll));
  const cp = Math.cos(d2r(pitch)); const sp = Math.sin(d2r(pitch));
  const cy = Math.cos(d2r(yaw)); const sy = Math.sin(d2r(yaw));
  return [
    [cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr],
    [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr],
    [-sp, cp * sr, cp * cr],
  ];
};
const poseMatrix = (p) => {
  const R = rot(p.roll, p.pitch, p.yaw);
  return [
    [R[0][0], R[0][1], R[0][2], p.x],
    [R[1][0], R[1][1], R[1][2], p.y],
    [R[2][0], R[2][1], R[2][2], p.z],
    [0, 0, 0, 1],
  ];
};
const fmt2 = (v) => { const r = Math.abs(v) < 0.005 ? 0 : v; return r < 0 ? '−' + Math.abs(r).toFixed(2) : r.toFixed(2); };

// ── 地面网格与三根世界轴 ─────────────────────────────────────────────────────
const GRID_N = 7;
const GX = Array.from({ length: GRID_N }, (_, i) => {
  const X = R_GEO.xmin + (i * (R_GEO.xmax - R_GEO.xmin)) / (GRID_N - 1);
  return { a: proj(X, R_GEO.ymin, 0), b: proj(X, R_GEO.ymax, 0) };
});
const GY = Array.from({ length: GRID_N }, (_, i) => {
  const Y = R_GEO.ymin + (i * (R_GEO.ymax - R_GEO.ymin)) / (GRID_N - 1);
  return { a: proj(R_GEO.xmin, Y, 0), b: proj(R_GEO.xmax, Y, 0) };
});
const GROUND = [
  proj(R_GEO.xmin, R_GEO.ymin, 0), proj(R_GEO.xmax, R_GEO.ymin, 0),
  proj(R_GEO.xmax, R_GEO.ymax, 0), proj(R_GEO.xmin, R_GEO.ymax, 0),
];
const groundPts = GROUND.map((p) => p.x.toFixed(1) + ',' + p.y.toFixed(1)).join(' ');

const WAX = [
  { key: 'x', from: proj(-0.5, 0, 0), to: proj(1.0, 0, 0) },
  { key: 'y', from: proj(0, -0.5, 0), to: proj(0, 1.0, 0) },
  { key: 'z', from: proj(0, 0, 0), to: proj(0, 0, 0.9) },
].map((a) => Object.assign({}, a, {
  lx: a.key === 'y' ? a.to.x - 12 : a.to.x + 12,
  ly: a.key === 'z' ? a.to.y + 6 : a.to.y + 20,
  anchor: a.key === 'y' ? 'end' : 'start',
}));

// ── 默认位姿 —— markup 的初始几何（JS 加载后会立即按同一公式刷新） ───────────
const DEF_M = poseMatrix(DEF);
const DEF_R = rot(DEF.roll, DEF.pitch, DEF.yaw);
const DEF_O = proj(DEF.x, DEF.y, DEF.z);
const DEF_TIPS = [0, 1, 2].map((i) => proj(
  DEF.x + L_AXIS * DEF_R[0][i],
  DEF.y + L_AXIS * DEF_R[1][i],
  DEF.z + L_AXIS * DEF_R[2][i],
));
const pLabelAt = (o) => {
  const dx = o.x - WORLD.x; const dy = o.y - WORLD.y;
  const len = Math.hypot(dx, dy) || 1;
  return { x: WORLD.x + dx / 2 - (dy / len) * 14, y: WORLD.y + dy / 2 + (dx / len) * 14 };
};
const DEF_PL = pLabelAt(DEF_O);
const DEF_GROUND = proj(DEF.x, DEF.y, 0);

// ── 右区：4×4 矩阵排版 ───────────────────────────────────────────────────────
const M_COL = [602, 666, 730, 794];
const M_ROW = [132, 176, 220, 264];
const M_HEAD_Y = 94;
const M_NOTE = { x: 546, y: 306, dy: 22 };
const BRACKET = { top: 112, bottom: 280, left: 584, right: 812, tick: 16 };
const bracketL = 'M ' + (BRACKET.left + BRACKET.tick) + ' ' + BRACKET.top + ' L ' + BRACKET.left + ' ' + BRACKET.top + ' L ' + BRACKET.left + ' ' + BRACKET.bottom + ' L ' + (BRACKET.left + BRACKET.tick) + ' ' + BRACKET.bottom;
const bracketR = 'M ' + (BRACKET.right - BRACKET.tick) + ' ' + BRACKET.top + ' L ' + BRACKET.right + ' ' + BRACKET.top + ' L ' + BRACKET.right + ' ' + BRACKET.bottom + ' L ' + (BRACKET.right - BRACKET.tick) + ' ' + BRACKET.bottom;

const CFG = { world: WORLD, scale: SCALE, iso: ISO, lAxis: L_AXIS, range: R_GEO, sliders: SLIDERS, def: DEF };
---

<figure class="ht-demo" data-ht={JSON.stringify(CFG)}>
  <svg viewBox="0 0 900 470" role="img" aria-label="位姿与齐次变换教学示意：左侧等距投影的世界坐标系 W 中有一个可用滑块拖动的位姿坐标系 B，右侧 4×4 齐次变换矩阵 T_WB 的十六个数字随位置 x y z 与姿态 roll pitch yaw 实时更新，左上 3×3 是旋转、右上 3×1 是位置、末行恒为 0 0 0 1">
    <defs>
      <marker id="ht-mk-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto">
        <path class="ht-mk-w-arm" d="M0,0 L10,5 L0,10 Z"></path>
      </marker>
      <marker id="ht-mk-x" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
        <path class="ht-mk-x-arm" d="M0,0 L10,5 L0,10 Z"></path>
      </marker>
      <marker id="ht-mk-y" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
        <path class="ht-mk-y-arm" d="M0,0 L10,5 L0,10 Z"></path>
      </marker>
      <marker id="ht-mk-z" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto">
        <path class="ht-mk-z-arm" d="M0,0 L10,5 L0,10 Z"></path>
      </marker>
    </defs>

    <text class="ht-title" x="24" y="28">位姿与齐次变换：一个坐标系 + 一个 4×4 矩阵（教学示意）</text>

    <!-- ===== 左区：世界坐标系 W（等距投影，固定不动） ===== -->
    <polygon class="ht-ground-fill" points={groundPts}></polygon>
    {GX.map((l) => (
      <line class="ht-grid" x1={l.a.x.toFixed(1)} y1={l.a.y.toFixed(1)} x2={l.b.x.toFixed(1)} y2={l.b.y.toFixed(1)}></line>
    ))}
    {GY.map((l) => (
      <line class="ht-grid" x1={l.a.x.toFixed(1)} y1={l.a.y.toFixed(1)} x2={l.b.x.toFixed(1)} y2={l.b.y.toFixed(1)}></line>
    ))}

    {WAX.map((a) => (
      <g>
        <line class="ht-waxis" x1={a.from.x.toFixed(1)} y1={a.from.y.toFixed(1)} x2={a.to.x.toFixed(1)} y2={a.to.y.toFixed(1)} marker-end="url(#ht-mk-w)"></line>
        <text class="ht-wax-label" x={a.lx.toFixed(1)} y={a.ly.toFixed(1)} text-anchor={a.anchor}>{a.key}</text>
      </g>
    ))}
    <circle class="ht-w-origin" cx={WORLD.x} cy={WORLD.y} r="4.5"></circle>
    <text class="ht-w-label" x={WORLD.x - 12} y={WORLD.y + 6} text-anchor="end">W</text>

    <text class="ht-legend" x="24" y="62">W 世界坐标系（固定，等距投影）</text>
    <text class="ht-legend" x="24" y="86">B 位姿坐标系（可动：位置 p + 姿态 R）</text>

    <!-- ===== 位姿坐标系 B ===== -->
    <!-- 从 W 原点到 B 原点的位置向量 p -->
    <line class="ht-p" data-role="pvec" x1={WORLD.x} y1={WORLD.y} x2={DEF_O.x.toFixed(1)} y2={DEF_O.y.toFixed(1)}></line>
    <text class="ht-p-label" data-role="plabel" x={DEF_PL.x.toFixed(1)} y={DEF_PL.y.toFixed(1)}>p</text>
    <!-- B 原点到地面的投影虚线（帮助判断三维位置） -->
    <line class="ht-drop" data-role="dropvec" x1={DEF_O.x.toFixed(1)} y1={DEF_O.y.toFixed(1)} x2={DEF_GROUND.x.toFixed(1)} y2={DEF_GROUND.y.toFixed(1)}></line>
    <!-- 三根机体短轴：方向 = 旋转矩阵 R 的三列，颜色区分 -->
    {[0, 1, 2].map((i) => (
      <line
        class={'ht-bax ht-bax-' + ['x', 'y', 'z'][i]}
        data-bax={i}
        x1={DEF_O.x.toFixed(1)}
        y1={DEF_O.y.toFixed(1)}
        x2={DEF_TIPS[i].x.toFixed(1)}
        y2={DEF_TIPS[i].y.toFixed(1)}
        marker-end={'url(#ht-mk-' + ['x', 'y', 'z'][i] + ')'}
      ></line>
    ))}
    <circle class="ht-b-origin" data-role="borigin" cx={DEF_O.x.toFixed(1)} cy={DEF_O.y.toFixed(1)} r="5"></circle>
    <text class="ht-b-label" data-role="blabel" x={(DEF_O.x + 12).toFixed(1)} y={(DEF_O.y - 12).toFixed(1)}>B</text>

    <!-- ===== 右区：4×4 齐次变换矩阵的逐项数值 ===== -->
    <text class="ht-m-label" x="556" y="64">T_WB =</text>
    <text class="ht-m-head ht-m-head-r" x={M_COL[1]} y={M_HEAD_Y} text-anchor="middle">R</text>
    <text class="ht-m-head ht-m-head-p" x={M_COL[3]} y={M_HEAD_Y} text-anchor="middle">p</text>
    <path class="ht-bracket" d={bracketL}></path>
    <path class="ht-bracket" d={bracketR}></path>
    {Array.from({ length: 16 }, (_, i) => {
      const r = Math.floor(i / 4);
      const c = i % 4;
      const cls = r === 3 ? 'ht-m ht-m-row' : c === 3 ? 'ht-m ht-m-pos' : 'ht-m ht-m-rot';
      return (
        <text class={cls} data-m={i} x={M_COL[c]} y={M_ROW[r]} text-anchor="middle">{fmt2(DEF_M[r][c])}</text>
      );
    })}
    <text class="ht-m-note" x={M_NOTE.x} y={M_NOTE.y}>左上 3×3 是旋转 R，右上 3×1 是位置 p，</text>
    <text class="ht-m-note" x={M_NOTE.x} y={M_NOTE.y + M_NOTE.dy}>最后一行恒为 [0 0 0 1]</text>

    <!-- 页脚教学要点 -->
    <text class="ht-note" x="24" y="452">B 的原点 = 矩阵右上 3×1 的位置 p；B 的三根短轴方向来自左上 3×3 的旋转 R。</text>
  </svg>

  <div class="ht-controls">
    {['pos', 'ang'].map((kind) => (
      <div class="ht-row">
        <span class="ht-row-title">{kind === 'pos' ? '位置' : '姿态'}</span>
        {SLIDERS.filter((s) => s.kind === kind).map((s) => (
          <label class="ht-slider-label">{s.name}
            <input class="ht-range" type="range" data-range={s.key} min={s.min} max={s.max} step={s.step} value={s.def} />
            <span class="ht-val" data-val={s.key}>{s.kind === 'pos' ? fmt2(s.def) + ' m' : s.def + '°'}</span>
          </label>
        ))}
      </div>
    ))}
    <div class="ht-row">
      <span class="ht-row-title"></span>
      <button type="button" class="ht-btn" data-reset>复位</button>
      <button type="button" class="ht-btn" data-rot-only>只留旋转（位置归零）</button>
      <button type="button" class="ht-btn" data-trans-only>只留平移（姿态归零）</button>
    </div>
  </div>

  <div class="ht-readout">
    <output class="ht-out ht-out-pose" aria-live="polite"></output>
    <output class="ht-out ht-out-note" aria-live="polite"></output>
  </div>

  <figcaption>
    拖动位置（x / y / z）与姿态（roll / pitch / yaw）六个滑块：左边坐标架 B 实时移动和旋转，右边矩阵 16 个数字同步变化。
    试试“只留旋转”和“只留平移”，看看矩阵里哪一块被清零。数值为教学示意。
  </figcaption>
</figure>

<script>
  document.querySelectorAll('.ht-demo').forEach((demo) => {
    const cfg = JSON.parse(demo.dataset.ht);
    const world = cfg.world;
    const scale = cfg.scale;
    const iso = cfg.iso;
    const L = cfg.lAxis;
    const sliders = cfg.sliders;
    const def = cfg.def;

    // 与 frontmatter 完全一致的投影与旋转工具
    const d2r = (d) => (d * Math.PI) / 180;
    const proj = (X, Y, Z) => ({
      x: world.x + scale * (iso.ax * X - iso.ax * Y),
      y: world.y + scale * (iso.ay * X + iso.ay * Y - Z),
    });
    const rot = (roll, pitch, yaw) => {
      const cr = Math.cos(d2r(roll)); const sr = Math.sin(d2r(roll));
      const cp = Math.cos(d2r(pitch)); const sp = Math.sin(d2r(pitch));
      const cy = Math.cos(d2r(yaw)); const sy = Math.sin(d2r(yaw));
      return [
        [cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr],
        [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr],
        [-sp, cp * sr, cp * cr],
      ];
    };
    const fmt2 = (v) => { const r = Math.abs(v) < 0.005 ? 0 : v; return r < 0 ? '−' + Math.abs(r).toFixed(2) : r.toFixed(2); };
    const fmtDeg = (v) => { const r = Math.abs(v) < 0.5 ? 0 : v; return r < 0 ? '−' + Math.abs(r).toFixed(0) : r.toFixed(0); };

    const el = (sel) => demo.querySelector(sel);
    const mEls = Array.from({ length: 16 }, (_, i) => el('[data-m="' + i + '"]'));
    const baxEls = [0, 1, 2].map((i) => el('[data-bax="' + i + '"]'));
    const bOrigin = el('[data-role="borigin"]');
    const pVec = el('[data-role="pvec"]');
    const pLabel = el('[data-role="plabel"]');
    const dropVec = el('[data-role="dropvec"]');
    const bLabel = el('[data-role="blabel"]');
    const poseOut = el('.ht-out-pose');
    const noteOut = el('.ht-out-note');
    const resetBtn = el('[data-reset]');
    const rotOnlyBtn = el('[data-rot-only]');
    const transOnlyBtn = el('[data-trans-only]');
    const rangeEls = {};
    const valEls = {};
    sliders.forEach((s) => {
      rangeEls[s.key] = el('[data-range="' + s.key + '"]');
      valEls[s.key] = el('[data-val="' + s.key + '"]');
    });

    // 状态 = 3 个位置 + 3 个姿态角
    const state = Object.assign({}, def);

    const setPoint = (node, a, b) => {
      node.setAttribute('x1', a.x.toFixed(1));
      node.setAttribute('y1', a.y.toFixed(1));
      node.setAttribute('x2', b.x.toFixed(1));
      node.setAttribute('y2', b.y.toFixed(1));
    };

    const render = () => {
      const R = rot(state.roll, state.pitch, state.yaw);
      const o = proj(state.x, state.y, state.z);

      // 位姿坐标架：三根短轴 = R 的三列（机体轴在世界系中的方向）
      for (let i = 0; i < 3; i++) {
        const tip = proj(
          state.x + L * R[0][i],
          state.y + L * R[1][i],
          state.z + L * R[2][i],
        );
        setPoint(baxEls[i], o, tip);
      }
      bOrigin.setAttribute('cx', o.x.toFixed(1));
      bOrigin.setAttribute('cy', o.y.toFixed(1));

      // 位置向量 p：W 原点 → B 原点；再画一条 B 到地面的投影虚线
      setPoint(pVec, world, o);
      setPoint(dropVec, o, proj(state.x, state.y, 0));

      // p 标签放在 W→B 中点，沿垂直方向偏 14 px
      const dx = o.x - world.x;
      const dy = o.y - world.y;
      const len = Math.hypot(dx, dy) || 1;
      pLabel.setAttribute('x', (world.x + dx / 2 - (dy / len) * 14).toFixed(1));
      pLabel.setAttribute('y', (world.y + dy / 2 + (dx / len) * 14).toFixed(1));
      pLabel.classList.toggle('ht-p-hidden', len < 24);

      bLabel.setAttribute('x', (o.x + 12).toFixed(1));
      bLabel.setAttribute('y', (o.y - 12).toFixed(1));

      // 4×4 矩阵：左上 3×3 = R，右上 3×1 = p，末行 [0 0 0 1]
      for (let r = 0; r < 4; r++) {
        for (let c = 0; c < 4; c++) {
          const v = r === 3
            ? (c === 3 ? 1 : 0)
            : (c === 3 ? [state.x, state.y, state.z][r] : R[r][c]);
          mEls[r * 4 + c].textContent = fmt2(v);
        }
      }

      poseOut.textContent =
        '位姿：x = ' + fmt2(state.x) + ' m，y = ' + fmt2(state.y) + ' m，z = ' + fmt2(state.z) + ' m；' +
        'roll = ' + fmtDeg(state.roll) + '°，pitch = ' + fmtDeg(state.pitch) + '°，yaw = ' + fmtDeg(state.yaw) + '°';

      const att = (state.roll === 0 && state.pitch === 0)
        ? 'yaw=' + fmtDeg(state.yaw) + '°'
        : 'roll=' + fmtDeg(state.roll) + '°，pitch=' + fmtDeg(state.pitch) + '°，yaw=' + fmtDeg(state.yaw) + '°';
      noteOut.textContent = '左上 3×3 是旋转 R（当前 ' + att + '），右上 3×1 是位置 p；一次乘法同时完成旋转和平移';

      sliders.forEach((s) => {
        if (valEls[s.key]) {
          valEls[s.key].textContent = s.kind === 'pos' ? fmt2(state[s.key]) + ' m' : fmtDeg(state[s.key]) + '°';
        }
      });
    };

    // 拖任意滑块：坐标架与矩阵实时更新
    sliders.forEach((s) => {
      const r = rangeEls[s.key];
      if (!r) return;
      r.addEventListener('input', () => {
        state[s.key] = Number(r.value);
        render();
      });
    });

    resetBtn.addEventListener('click', () => {
      sliders.forEach((s) => {
        state[s.key] = def[s.key];
        if (rangeEls[s.key]) rangeEls[s.key].value = def[s.key];
      });
      render();
    });

    // 只留旋转：位置归零 → 矩阵右上 3×1 变 0
    rotOnlyBtn.addEventListener('click', () => {
      state.x = 0;
      state.y = 0;
      state.z = 0;
      rangeEls.x.value = 0;
      rangeEls.y.value = 0;
      rangeEls.z.value = 0;
      render();
    });

    // 只留平移：姿态归零 → 矩阵左上 3×3 变单位阵
    transOnlyBtn.addEventListener('click', () => {
      state.roll = 0;
      state.pitch = 0;
      state.yaw = 0;
      rangeEls.roll.value = 0;
      rangeEls.pitch.value = 0;
      rangeEls.yaw.value = 0;
      render();
    });

    render();
  });
</script>

