  /* 左区：标题、图例、躯干与坐标架 */
  .fk-title { fill: var(--sl-color-text); font-size: 24px; font-weight: 600; }
  .fk-legend { fill: var(--sl-color-gray-2); font-size: 17px; }
  .fk-torso { stroke: var(--sl-color-gray-3); stroke-width: 1.6; }
  .fk-bax { stroke-width: 2.4; stroke-linecap: round; }
  .fk-bax-x { stroke: var(--sl-color-accent); }
  .fk-bax-y { stroke: var(--fk-ay); }
  .fk-bax-z { stroke: var(--fk-az); }
  .fk-bax-label { font-size: 17px; font-weight: 700; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .fk-bax-label-x { fill: var(--sl-color-accent); }
  .fk-bax-label-y { fill: var(--fk-ay); }
  .fk-bax-label-z { fill: var(--fk-az); }

  /* 左区：链与末端 */
  .fk-mount { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 2; stroke-dasharray: 6 4; stroke-linejoin: round; }
  .fk-arm { fill: none; stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
  .fk-arm-upper { stroke: var(--sl-color-accent); }
  .fk-arm-fore { stroke: var(--fk-ay); }
  .fk-arm-wrist { stroke: var(--fk-az); }
  .fk-joint { fill: var(--sl-color-bg); stroke: var(--sl-color-text); stroke-width: 1.8; }
  .fk-end { fill: var(--fk-end); stroke: var(--sl-color-bg); stroke-width: 1.6; }
  .fk-end-label { fill: var(--sl-color-text); font-size: 17px; font-weight: 700; }
  .fk-eax { stroke-width: 3; stroke-linecap: round; }
  .fk-eax-x { stroke: var(--sl-color-accent); }
  .fk-eax-y { stroke: var(--fk-ay); }
  .fk-eax-z { stroke: var(--fk-az); }
  .fk-trail { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 1.6; stroke-dasharray: 3 4; opacity: 0; }
  .fk-trail.fk-trail-on { opacity: 0.85; }

  /* 右区：末端位姿面板 */
  .fk-panel { fill: light-dark(rgba(148, 163, 184, 0.1), rgba(148, 163, 184, 0.08)); stroke: var(--sl-color-gray-4); stroke-width: 1.4; }
  .fk-panel-title { fill: var(--sl-color-text); font-size: 18px; font-weight: 700; }
  .fk-panel-head { fill: var(--sl-color-gray-2); font-size: 17px; font-weight: 600; }
  .fk-row { font-size: 17px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
  .fk-row-k { fill: var(--sl-color-gray-2); }
  .fk-row-v { fill: var(--fk-end); font-weight: 700; }
  .fk-row-u { fill: var(--sl-color-gray-2); }

  /* 控件：统一 margin: 0 */
  .g1fk-controls { display: flex; flex-direction: column; gap: 0.5rem; max-width: 900px; margin: 0.55rem auto 0; }
  .g1fk-row { display: flex; align-items: center; gap: 0.8rem; margin: 0; }
  .g1fk-row-title { flex: 0 0 3.2rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.8125rem; }
  .g1fk-hint { margin: 0; flex: 0 0 auto; color: var(--sl-color-gray-3); font-size: 0.75rem; white-space: nowrap; }
  .g1fk-slider-label { display: flex; flex: 1 1 0; min-width: 0; align-items: center; gap: 0.4rem; margin: 0; font-size: 0.8125rem; color: var(--sl-color-gray-2); white-space: nowrap; }
  .g1fk-range { flex: 1 1 auto; width: auto; min-width: 3.5rem; margin: 0; accent-color: var(--sl-color-accent); }
  .g1fk-val { flex: 0 0 3.2rem; margin: 0; text-align: right; color: var(--sl-color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .g1fk-btn { display: inline-flex; align-items: center; justify-content: center; height: 2.1rem; margin: 0; padding: 0 0.85rem; box-sizing: border-box; border: 1px solid var(--sl-color-gray-4); border-radius: 6px; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; font-size: 0.8125rem; line-height: 1; cursor: pointer; }

  /* 两条定高读数 */
  .g1fk-readout { max-width: 900px; margin: 0.5rem auto 0; font-size: 0.9rem; line-height: 1.7; }
  .fk-out { display: block; white-space: nowrap; overflow-x: auto; height: 1.7em; line-height: 1.7; margin: 0; }
