---
/**
 * 通用源码节选卡片：逐字引用源码并保留原行号，关键行高亮并附中文注释
 * 标签，其余行压暗；卡片头部文件路径可选做成跳转链接。纯 HTML + CSS。
 *
 * 使用方式：在封装组件中传入 cards 与 caption（仅限 .mdx 小节使用）：
 *   <SourceSnippet cards={[...]} caption="..." />
 *
 * cards: [{ role, file, url?, lines: [{ n, code, hl?, ann? }] }]
 * - n：原文件行号；行号不连续即表示中间有省略；
 * - hl：高亮行（正文提到的字段）；ann：右侧注释标签（灰色为补充说明）。
 */

interface Line {
  n: number;
  code: string;
  hl?: boolean;
  ann?: string;
}

interface Card {
  role: string;
  file: string;
  url?: string;
  /** 可选：链路步骤（序号 + 步骤名）。有则在卡片头部以大字显示，供多步链路场景使用 */
  step?: { no: string; name: string };
  lines: Line[];
}

interface Props {
  cards: Card[];
  caption: string;
}

const { cards, caption } = Astro.props;
---

<figure class="src-snippet">
  {cards.map((card) => (
    <div class="src-card">
      <div class="src-card-head">
        {card.step && (
          <span class="src-step">
            <b class="src-step-no">{card.step.no}</b>
            <span class="src-step-name">{card.step.name}</span>
          </span>
        )}
        <span class="src-role">{card.role}</span>
        {card.url ? (
          <a class="src-file" href={card.url} target="_blank" rel="noopener noreferrer" title="在 GitHub 查看源码">{card.file}</a>
        ) : (
          <span class="src-file">{card.file}</span>
        )}
      </div>
      <div class="src-body">
        {card.lines.map((line) => (
          <div class={line.hl ? 'src-line src-hl' : 'src-line src-dim'}>
            <span class="src-ln">{line.n}</span>
            <code class="src-code">{line.code}</code>
            {line.ann && <span class="src-ann">{line.ann}</span>}
          </div>
        ))}
      </div>
    </div>
  ))}
  <figcaption set:html={caption}></figcaption>
</figure>

<style>
  .src-snippet {
    margin: 1.5rem 0;
  }
  .src-card {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 0.75rem;
    background: var(--sl-color-bg);
  }
  .src-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }
  .src-step {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    flex: 0 0 auto;
  }
  .src-step-no {
    font-size: 1rem;
    font-weight: 800;
    color: var(--sl-color-accent);
    line-height: 1;
  }
  .src-step-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--sl-color-text);
    white-space: nowrap;
  }
  .src-role {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-text);
    white-space: nowrap;
  }
  .src-file {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.src-file {
    text-decoration: none;
    border-bottom: 1px dashed var(--sl-color-gray-4);
  }
  a.src-file:hover {
    color: var(--sl-color-accent);
    border-bottom-color: var(--sl-color-accent);
  }
  .src-body {
    overflow-x: auto;
    padding: 0.25rem 0;
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.75rem;
    line-height: 1.7;
  }
  .src-line {
    display: flex;
    align-items: baseline;
    padding: 0 0.75rem 0 0;
    border-left: 3px solid transparent;
  }
  .src-ln {
    flex: 0 0 2.5rem;
    text-align: right;
    padding-right: 0.75rem;
    color: var(--sl-color-gray-3);
    user-select: none;
  }
  .src-code {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    white-space: pre;
    color: var(--sl-color-text);
    background: none;
    padding: 0;
  }
  .src-ann {
    flex: 0 0 auto;
    margin-left: auto;
    padding-left: 1.5rem;
    white-space: nowrap;
    font-family: var(--sl-font, sans-serif);
    font-size: 0.6875rem;
    color: var(--sl-color-accent);
  }
  .src-dim .src-code {
    opacity: 0.45;
  }
  .src-dim .src-ann {
    color: var(--sl-color-gray-2);
  }
  .src-hl {
    border-left-color: var(--sl-color-accent);
    background: light-dark(rgba(79, 70, 229, 0.07), rgba(139, 131, 255, 0.12));
  }
  .src-hl .src-code {
    font-weight: 600;
  }

  .src-snippet figcaption {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
  }
</style>
