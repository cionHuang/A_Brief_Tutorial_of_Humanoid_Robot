---
import '../styles/math-lessons.css';
---
<figure class="math-lesson" id="vector-action-demo" data-vector-action>
  <header><h4>同样用力，效果为什么不同？</h4><p>先看推力是否顺着运动方向，再看门为什么会转。</p></header>
  <div class="ml-tabs" role="group" aria-label="选择向量运算的例子">
    <button type="button" data-scene="push" aria-pressed="true">内积 · 推小车</button>
    <button type="button" data-scene="door" aria-pressed="false">叉乘 · 推门</button>
  </div>
  <div class="ml-body">
    <svg class="ml-svg" viewBox="0 0 520 260" data-drawing role="img" aria-label="小车向右运动，改变施力方向，比较功率"></svg>
    <div class="ml-readout"><span data-result-label>这股力的功率</span><strong data-result>1.73 W</strong></div>
    <p class="ml-story" data-story aria-live="polite">力和速度越同向，这股力做正功的功率越大。</p>
    <div class="ml-controls" data-door-controls hidden role="group" aria-label="选择推门时改变的因素">
      <button type="button" data-factor="angle" aria-pressed="true">改施力方向</button><button type="button" data-factor="distance" aria-pressed="false">改施力位置</button>
    </div>
    <div class="ml-controls"><label><span data-slider-label>施力夹角</span><input type="range" min="-180" max="180" step="1" value="30" data-angle aria-label="施力夹角"/><output data-value>30°</output></label></div>
    <div class="ml-controls"><button type="button" data-preset="0">同向 0°</button><button type="button" data-preset="90">垂直 90°</button><button type="button" data-preset="180">反向 180°</button></div>
  </div>
  <details><summary>查看对应公式</summary><p data-formula>功率 P = F · v = |F| |v| cos θ。</p></details>
  <figcaption data-caption>固定速度为 0.2 m/s、力为 10 N，只比较这股力的功率，不模拟小车加速。</figcaption>
  <noscript>启用 JavaScript 后可以拖动施力方向。力垂直于速度时，功率为零；力垂直于门时，绕门轴的力矩最大。</noscript>
</figure>
<script>
  import { pushPower, doorTorque, DEG } from '../lib/robot-math-demo-model.js';
  function init() {
    document.querySelectorAll('[data-vector-action]').forEach(root => {
      if(root.dataset.ready) return; root.dataset.ready='true';
      const abort=new AbortController(), q=s=>root.querySelector(s), all=s=>root.querySelectorAll(s);
      let scene='push',factor='angle',angle=30,distance=.8;
      const arrow=(x,y,dx,dy,color,label,offset=0)=>{const ex=x+dx,ey=y+dy,a=Math.atan2(dy,dx)*180/Math.PI;return `<line x1="${x}" y1="${y}" x2="${ex}" y2="${ey}" stroke="${color}" stroke-width="5"/><path d="M 0 0 L -13 -6 L -13 6 Z" fill="${color}" transform="translate(${ex} ${ey}) rotate(${a})"/><text x="${ex+offset}" y="${ey-13}" text-anchor="middle">${label}</text>`;};
      function render(){
        const door=scene==='door', a=angle*DEG;
        const value=door?doorTorque(angle,distance):pushPower(angle);
        root.dataset.scene=scene;root.dataset.result=value.toFixed(4);
        all('[data-scene]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.scene===scene)));
        all('[data-factor]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.factor===factor)));
        q('[data-door-controls]').hidden=!door;
        const pos=door&&factor==='distance', slider=q('[data-angle]');
        slider.min=pos?'10':'-180';slider.max=pos?'100':'180';slider.value=String(pos?distance*100:angle);
        slider.setAttribute('aria-label',pos?'施力点距门轴':'施力夹角');
        q('[data-slider-label]').textContent=pos?'距门轴':'施力夹角';q('[data-value]').textContent=pos?`${Math.round(distance*100)} cm`:`${angle}°`;
        all('[data-preset]').forEach(b=>{b.hidden=pos;b.textContent=door?({'0':'顺着门 0°','90':'垂直门 90°','180':'反向 180°'})[b.dataset.preset]:({'0':'同向 0°','90':'垂直 90°','180':'反向 180°'})[b.dataset.preset];});
        q('[data-result-label]').textContent=door?'绕门轴的力矩':'这股力的功率';
        q('[data-result]').textContent=`${Math.abs(value)<.005?'0.00':value.toFixed(2)} ${door?'N·m':'W'}`;
        q('[data-story]').textContent=door?(Math.abs(value)<.001?'力沿着门板方向，绕门轴的力矩为零。':`${value>0?'逆时针':'顺时针'}转动的趋势。${pos?'力的方向固定；离门轴越远，力矩越大。':'施力位置固定；力越接近垂直于门，力矩的大小越大。'}`):(Math.abs(value)<.001?'力与速度垂直，这股力此刻不做功。':value>0?'力有顺着运动方向的分量，做正功。越接近同向，功率越大。':'力有逆着运动方向的分量，做负功，阻碍当前运动。');
        q('[data-formula]').textContent=door?'力矩 τ = r × F。这里门轴竖直，绕门轴的力矩为 10 × 距门轴的距离 × sin θ；正负号区分转动方向。':'功率 P = F · v = |F| |v| cos θ。力固定为 10 N，速度固定为 0.2 m/s。';
        q('[data-caption]').textContent=door?'俯视一扇门：力固定为 10 N，角度从门轴指向施力点的方向量起。弧形箭头表示转动趋势，不是门的实际运动轨迹。':'固定速度为 0.2 m/s、力为 10 N，只比较这股力的功率，不模拟小车加速。';
        let drawing;
        if(!door){drawing=`<path d="M40 204 H480" stroke="#94a3b8" stroke-width="2"/><g fill="#91a5bc"><circle cx="238" cy="189" r="13"/><circle cx="294" cy="189" r="13"/></g><rect x="224" y="123" width="85" height="55" rx="8" fill="#c4d0df" stroke="#64748b" stroke-width="2"/><path d="M170 148 H205 M148 166 H201" stroke="#94a3b8" stroke-width="3"/>${arrow(235,225,110,0,'#2489d1','速度向右')}${arrow(266,150,95*Math.cos(a),-95*Math.sin(a),'#e58b27','力 10 N')}<circle cx="266" cy="150" r="4" fill="#e58b27"/><text x="22" y="30">只改力的方向，小车速度固定</text>`;}
        else {const x=130+distance*260;const sign=value>=0?1:-1;const sweep=sign>0?0:1;drawing=`<path d="M50 160 H130" stroke="#94a3b8" stroke-width="8"/><rect x="130" y="153" width="260" height="14" rx="4" fill="#c4d0df" stroke="#64748b" stroke-width="2"/><circle cx="130" cy="160" r="9" fill="#435c79"/><text x="115" y="193">门轴</text>${arrow(x,160,78*Math.cos(a),-78*Math.sin(a),'#e58b27','力 10 N')}<circle cx="${x}" cy="160" r="6" fill="#e58b27"/><line x1="130" y1="213" x2="${x}" y2="213" stroke="#2489d1" stroke-width="2"/><text x="${(130+x)/2}" y="249" text-anchor="middle">${Math.round(distance*100)} cm</text><text x="22" y="30">俯视门板 · 改变${pos?'施力位置':'施力方向'}</text>${Math.abs(value)>.001?`<path d="M ${130+65} 160 A65 65 0 0 ${sweep} 130 ${160-sign*65}" fill="none" stroke="#16a084" stroke-width="${2+Math.abs(value)*.45}"/><path d="M 125 ${160-sign*65} l 11 -5 v 10 Z" fill="#16a084"/>`:''}`;}
        q('[data-drawing]').innerHTML=drawing;q('[data-drawing]').setAttribute('aria-label',door?'俯视推门，橙色箭头是力，绿色弧线是转动趋势':'小车向右运动，橙色箭头显示施力方向');
      }
      const on=(el,event,fn)=>el.addEventListener(event,fn,{signal:abort.signal});
      all('[data-scene]').forEach(b=>on(b,'click',()=>{scene=b.dataset.scene;factor='angle';angle=scene==='push'?30:90;distance=.8;render();}));
      all('[data-factor]').forEach(b=>on(b,'click',()=>{factor=b.dataset.factor;angle=90;distance=.8;render();}));
      all('[data-preset]').forEach(b=>on(b,'click',()=>{angle=Number(b.dataset.preset);render();}));
      on(q('[data-angle]'),'input',e=>{if(scene==='door'&&factor==='distance')distance=Number(e.target.value)/100;else angle=Number(e.target.value);render();});
      document.addEventListener('astro:before-swap',()=>abort.abort(),{once:true,signal:abort.signal});render();
    });
  }
  init();document.addEventListener('astro:page-load',init);
</script>
