---
/**
 * 单个关节模组的传动链交互演示。
 *
 * 从左到右：电机（持续旋转）→ 齿轮副减速器（输入小齿轮 / 输出大齿轮）→ 关节输出连杆。
 * 输入齿轮以电机转速旋转，输出齿轮按 N = ωm/ωout 反向减速；输出连杆随输出轴转动。
 * 滑块可调电机转速、减速比 N 和负载力矩，实时显示两侧的转速、力矩、功率、效率损失与发热。
 *
 * 纯 SVG + 原生 JS，无外部依赖；样式跟随 Starlight 明暗主题，
 * 遵循 prefers-reduced-motion（该设置下默认暂停，可手动播放）。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import JointTransmissionDemo from '../../../components/JointTransmissionDemo.astro';
 *   <JointTransmissionDemo />
 */
import Tex from './Tex.astro';
import { katexHtml } from '../lib/tex.js';
---

<figure class="jt-demo">
  <svg viewBox="0 0 820 400" role="img" aria-label="单个关节模组传动链演示：电机经齿轮副减速器驱动关节输出">
    <!-- 电机 -->
    <g class="jt-motor">
      <rect x="46" y="168" width="82" height="64" rx="8"></rect>
      <g class="jt-rotor">
        <line x1="87" y1="182" x2="87" y2="218"></line>
        <circle cx="87" cy="200" r="5"></circle>
      </g>
      <text class="jt-label" x="87" y="258" text-anchor="middle">电机 Motor</text>
    </g>

    <!-- 电机轴 -->
    <line class="jt-shaft" x1="128" y1="200" x2="128" y2="200"></line>

    <!-- 减速器：输入小齿轮 + 输出大齿轮 -->
    <g class="jt-input-gear"><path class="jt-gear"></path></g>
    <g class="jt-output-gear"><path class="jt-gear"></path></g>
    <text class="jt-label" x="356" y="40" text-anchor="middle">减速器 Reducer</text>
    <Tex x={356} y={60} size={13} anchor="middle" color="var(--sl-color-gray-2)" parts={[{ tex: 'N = \\omega_m / \\omega_{out}' }]} />
    <Tex role="ratio" x={0} y={0} size={15} anchor="middle" color="var(--sl-color-accent)" />

    <!-- 输出轴 + 连杆 -->
    <line class="jt-shaft" x1="0" y1="200" x2="0" y2="200" data-out-shaft></line>
    <g class="jt-link">
      <rect class="jt-link-bar" x="-8" y="-9" width="150" height="18" rx="9"></rect>
      <circle class="jt-link-end" cx="142" cy="0" r="9"></circle>
    </g>
    <text class="jt-label" x="650" y="40" text-anchor="middle">关节输出 Joint Output</text>
    <Tex x={650} y={60} size={13} anchor="middle" color="var(--sl-color-gray-2)" parts={[{ tex: '\\tau_{out}' }]} />

    <!-- 输入端 vs 输出端 对比条 -->
    <g class="jt-bars">
      <text class="jt-sub" x="650" y="118" text-anchor="middle">输入端 vs 输出端</text>
      <text class="jt-bars-label" x="556" y="144" text-anchor="end">转速</text>
      <text class="jt-bars-label" x="556" y="170" text-anchor="end">电机</text>
      <rect class="jt-bar-bg" x="566" y="158" width="210" height="12" rx="6"></rect>
      <rect class="jt-bar jt-bar-speed-m" x="566" y="158" width="0" height="12" rx="6"></rect>
      <text class="jt-bars-label" x="556" y="194" text-anchor="end">输出</text>
      <rect class="jt-bar-bg" x="566" y="182" width="210" height="12" rx="6"></rect>
      <rect class="jt-bar jt-bar-speed-o" x="566" y="182" width="0" height="12" rx="6"></rect>

      <text class="jt-bars-label" x="556" y="240" text-anchor="end">力矩</text>
      <text class="jt-bars-label" x="556" y="266" text-anchor="end">电机</text>
      <rect class="jt-bar-bg" x="566" y="254" width="210" height="12" rx="6"></rect>
      <rect class="jt-bar jt-bar-torque-m" x="566" y="254" width="0" height="12" rx="6"></rect>
      <text class="jt-bars-label" x="556" y="290" text-anchor="end">输出</text>
      <rect class="jt-bar-bg" x="566" y="278" width="210" height="12" rx="6"></rect>
      <rect class="jt-bar jt-bar-torque-o" x="566" y="278" width="0" height="12" rx="6"></rect>
    </g>
  </svg>

  <div class="jt-controls">
    <label>电机转速 <input type="range" data-jt-speed min="500" max="6000" step="100" value="3000" /> <output data-jt-speed-out>3000</output> rpm</label>
    <label>减速比 <span set:html={katexHtml('N')}></span> <input type="range" data-jt-ratio min="2" max="5" step="1" value="4" /> <output data-jt-ratio-out>4</output></label>
    <label>负载力矩 <input type="range" data-jt-load min="0" max="60" step="1" value="20" /> <output data-jt-load-out>20</output> N·m</label>
    <button type="button" class="jt-play" data-jt-play aria-pressed="true">暂停</button>
  </div>

  <p class="jt-readout"><output data-jt-out aria-live="polite"></output></p>

  <figcaption>
    电机以转速 <span set:html={katexHtml('\\omega_m')}></span> 转动，经减速比 <span set:html={katexHtml('N')}></span> 的齿轮副后，输出转速降为 <span set:html={katexHtml('\\omega_{out} = \\omega_m / N')}></span>，输出力矩按 <span set:html={katexHtml('\\tau_{out} \\approx \\eta \\cdot N \\cdot \\tau_m')}></span> 放大（<span set:html={katexHtml('\\eta')}></span> 为传动效率，这里取 0.85）。拖动滑块可以看到：减速比越大，输出越慢越有劲，但同样的负载需要的电机力矩更小；负载越大，电机力矩、电流和发热越高。齿轮转速已按比例缩放以便观察，数值按所选工况计算。
  </figcaption>
</figure>

<script>
  import { setParts } from '../lib/tex.js';

  document.querySelectorAll('.jt-demo').forEach((demo) => {
    const svg = demo.querySelector('svg');
    const rotorG = demo.querySelector('.jt-rotor');
    const inputGearG = demo.querySelector('.jt-input-gear');
    const inputPath = demo.querySelector('.jt-input-gear path');
    const outputGearG = demo.querySelector('.jt-output-gear');
    const outputPath = demo.querySelector('.jt-output-gear path');
    const linkG = demo.querySelector('.jt-link');
    const motorShaft = demo.querySelectorAll('.jt-shaft')[0];
    const outShaft = demo.querySelector('[data-out-shaft]');
    const boxOf = (role) => {
      const group = demo.querySelector('[data-role="' + role + '"]');
      return { group: group, box: group ? group.querySelector('.tex-box') : null };
    };
    const speedSlider = demo.querySelector('[data-jt-speed]');
    const ratioSlider = demo.querySelector('[data-jt-ratio]');
    const loadSlider = demo.querySelector('[data-jt-load]');
    const speedOut = demo.querySelector('[data-jt-speed-out]');
    const ratioOut = demo.querySelector('[data-jt-ratio-out]');
    const loadOut = demo.querySelector('[data-jt-load-out]');
    const out = demo.querySelector('[data-jt-out]');
    const ratioLab = boxOf('ratio');
    const playBtn = demo.querySelector('[data-jt-play]');
    const speedBarM = demo.querySelector('.jt-bar-speed-m');
    const speedBarO = demo.querySelector('.jt-bar-speed-o');
    const torqueBarM = demo.querySelector('.jt-bar-torque-m');
    const torqueBarO = demo.querySelector('.jt-bar-torque-o');

    const ETA = 0.85;
    const CY = 200;
    const R1 = 26;
    const N1 = 12;
    const GAP = 4;
    const CX2 = 356;

    let N = 4, r2 = R1 * N, cx1 = CX2 - R1 - r2 - GAP;
    let thetaIn = 0;
    let playing = true;
    let lastTs = 0;
    let raf = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const gearPath = (teeth, rRoot, rTip) => {
      const pts = [];
      const pitch = (Math.PI * 2) / teeth;
      for (let i = 0; i < teeth; i++) {
        const a = i * pitch;
        const add = (ang, r) => pts.push([Math.cos(ang) * r, Math.sin(ang) * r]);
        add(a - pitch * 0.30, rRoot);
        add(a - pitch * 0.14, rTip);
        add(a + pitch * 0.14, rTip);
        add(a + pitch * 0.30, rRoot);
      }
      return 'M' + pts.map((p) => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' L') + ' Z';
    };

    const place = (lab, px, py) => {
      if (lab.group) lab.group.setAttribute('transform', 'translate(' + px.toFixed(1) + ' ' + py.toFixed(1) + ')');
    };

    const layout = () => {
      N = Number(ratioSlider.value);
      r2 = R1 * N;
      cx1 = CX2 - R1 - r2 - GAP;
      inputPath.setAttribute('d', gearPath(N1, R1 - 3, R1 + 3));
      outputPath.setAttribute('d', gearPath(N1 * N, r2 - 3, r2 + 3));
      inputGearG.setAttribute('transform', 'translate(' + cx1 + ' ' + CY + ')');
      outputGearG.setAttribute('transform', 'translate(' + CX2 + ' ' + CY + ')');
      motorShaft.setAttribute('x2', String(cx1));
      outShaft.setAttribute('x1', String(CX2));
      outShaft.setAttribute('x2', String(CX2 + 0.01));
      place(ratioLab, 356, 370);
      setParts(ratioLab.box, [{ tex: 'N = ' + N }]);
    };

    const updateNumbers = () => {
      const rpm = Number(speedSlider.value);
      const tauLoad = Number(loadSlider.value);
      const wm = (rpm * Math.PI * 2) / 60;
      const wout = wm / N;
      const tauOut = tauLoad;
      const tauM = tauLoad / (ETA * N);
      const pOut = tauOut * wout;
      const pIn = pOut / ETA;
      const loss = pIn - pOut;
      const heat = Math.min(1, (tauM / 15) ** 2);
      const SPEED_MAX = 6000, TORQUE_MAX = 60;
      speedBarM.setAttribute('width', (210 * Math.min(1, rpm / SPEED_MAX)).toFixed(1));
      speedBarO.setAttribute('width', (210 * Math.min(1, rpm / N / SPEED_MAX)).toFixed(1));
      torqueBarM.setAttribute('width', (210 * Math.min(1, tauM / TORQUE_MAX)).toFixed(1));
      torqueBarO.setAttribute('width', (210 * Math.min(1, tauOut / TORQUE_MAX)).toFixed(1));
      speedOut.textContent = String(rpm);
      ratioOut.textContent = String(N);
      loadOut.textContent = String(tauLoad);
      setParts(out, [
        { text: '电机 ' },
        { tex: '\\omega_m = ' + Math.round(rpm) + '\\ \\text{rpm}' },
        { text: '、' },
        { tex: '\\tau_m = ' + tauM.toFixed(1) + '\\ \\text{N}\\!\\cdot\\!\\text{m}' },
        { text: '　输出 ' },
        { tex: '\\omega_{out} = ' + Math.round((wout * 60) / (Math.PI * 2)) + '\\ \\text{rpm}' },
        { text: '、' },
        { tex: '\\tau_{out} = ' + tauOut.toFixed(1) + '\\ \\text{N}\\!\\cdot\\!\\text{m}' },
        { text: '　' },
        { tex: 'P_{out} = ' + Math.round(pOut) + '\\ \\text{W}' },
        { text: '、' },
        { tex: 'P_{in} = ' + Math.round(pIn) + '\\ \\text{W}' },
        { text: '、损耗 ' },
        { tex: Math.round(loss) + '\\ \\text{W}' },
        { text: '　电机负载 ' },
        { tex: Math.round((tauM / 15) * 100) + '\\%' },
        { text: '、发热 ' },
        { tex: Math.round(heat * 100) + '\\%' },
      ]);
    };

    const loop = (ts) => {
      if (!playing) { raf = 0; return; }
      if (!lastTs) lastTs = ts;
      const dt = Math.min((ts - lastTs) / 1000, 0.05);
      lastTs = ts;
      const rpm = Number(speedSlider.value);
      const visualRevPerSec = (rpm / 3000) * 2; // 视觉缩放，便于观察
      thetaIn += dt * visualRevPerSec * Math.PI * 2;
      const thetaOut = -thetaIn / N;
      const degIn = (thetaIn * 180) / Math.PI;
      const degOut = (thetaOut * 180) / Math.PI;
      inputGearG.setAttribute('transform', 'translate(' + cx1 + ' ' + CY + ') rotate(' + degIn.toFixed(2) + ')');
      outputGearG.setAttribute('transform', 'translate(' + CX2 + ' ' + CY + ') rotate(' + degOut.toFixed(2) + ')');
      linkG.setAttribute('transform', 'translate(' + CX2 + ' ' + CY + ') rotate(' + degOut.toFixed(2) + ')');
      rotorG.setAttribute('transform', 'translate(87 200) rotate(' + (degIn * 3).toFixed(2) + ') translate(-87 -200)');
      raf = requestAnimationFrame(loop);
    };

    const setPlaying = (v) => {
      playing = v;
      playBtn.setAttribute('aria-pressed', String(v));
      playBtn.textContent = v ? '暂停' : '播放';
      if (v && raf === 0) { lastTs = 0; raf = requestAnimationFrame(loop); }
    };

    ratioSlider.addEventListener('input', () => { layout(); updateNumbers(); });
    speedSlider.addEventListener('input', updateNumbers);
    loadSlider.addEventListener('input', updateNumbers);
    playBtn.addEventListener('click', () => setPlaying(!playing));

    layout();
    updateNumbers();
    if (!reduced) setPlaying(true);
    else { setPlaying(false); layout(); }
  });
</script>

<style>
  .jt-demo { margin: 1.5rem 0; }
  .jt-demo svg {
    display: block;
    width: 100%;
    max-width: 820px;
    height: auto;
    margin: 0 auto;
  }
  .jt-frame { stroke: var(--sl-color-gray-4); stroke-width: 3; }
  .jt-motor rect {
    fill: light-dark(#e2e8f0, #334155);
    stroke: var(--sl-color-gray-3);
    stroke-width: 2;
  }
  .jt-rotor line { stroke: light-dark(#dc2626, #f87171); stroke-width: 4; stroke-linecap: round; }
  .jt-rotor circle { fill: var(--sl-color-gray-2); }
  .jt-shaft { stroke: var(--sl-color-gray-3); stroke-width: 5; stroke-linecap: round; }
  .jt-gear {
    fill: light-dark(#cbd5e1, #475569);
    stroke: light-dark(#64748b, #94a3b8);
    stroke-width: 1.5;
  }
  .jt-input-gear .jt-gear { fill: light-dark(#fde68a, #a16207); stroke: light-dark(#d97706, #fbbf24); }
  .jt-link-bar { fill: light-dark(#0d9488, #2dd4bf); }
  .jt-link-end { fill: light-dark(#0f766e, #5eead4); }
  .jt-label { fill: var(--sl-color-text); font-size: 15px; font-weight: 600; }
  .jt-sub { fill: var(--sl-color-gray-2); font-size: 13px; }
  .jt-ratio { fill: var(--sl-color-accent); font-size: 15px; font-weight: 700; }
  .jt-bars-label { fill: var(--sl-color-gray-2); font-size: 12px; }
  .jt-bar-bg { fill: light-dark(#e2e8f0, #334155); }
  .jt-bar-speed-m, .jt-bar-torque-m { fill: light-dark(#d97706, #fbbf24); }
  .jt-bar-speed-o, .jt-bar-torque-o { fill: light-dark(#0d9488, #2dd4bf); }
  .jt-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    max-width: 820px;
    margin: 0.6rem auto 0;
  }
  .jt-controls label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .jt-controls input[type='range'] { width: 8rem; accent-color: var(--sl-color-accent); }
  .jt-controls output { color: var(--sl-color-accent); font-variant-numeric: tabular-nums; }
  .jt-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.1rem;
    margin: 0;
    padding: 0 0.75rem;
    box-sizing: border-box;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1;
    cursor: pointer;
  }
  .jt-readout {
    max-width: 820px;
    margin: 0.5rem auto 0;
    font-size: 0.8125rem;
    color: var(--sl-color-text);
    line-height: 1.7;
  }
  .jt-readout output { color: var(--sl-color-accent); font-weight: 600; }
  .jt-demo figcaption {
    max-width: 820px;
    margin: 0.6rem auto 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.65;
  }
  @media (prefers-reduced-motion: reduce) {
    .jt-rotor { transition: none; }
  }
</style>
