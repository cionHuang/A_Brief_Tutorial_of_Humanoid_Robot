---
import { gravityTorques } from '../lib/g1-arm-physics.js';
import { GRAVITY_TARGET } from '../lib/arm-lesson-sequences.js';
const initial = gravityTorques(GRAVITY_TARGET);
const urdfUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'models/g1/g1_29dof.urdf';
---
<figure id="g1-gravity-compensation-demo" class="gcarm-demo" data-state="idle" data-urdf-url={urdfUrl}>
  <div class="gcarm-heading"><strong data-gcarm-mode>① 空手，未补偿</strong><span data-gcarm-count>1 / 3</span></div>
  <p class="gcarm-explanation" data-gcarm-explanation aria-live="polite">目标姿势固定。只靠位置反馈支撑时，手臂会留下一些下垂。</p>
  <div class="gcarm-viewport" data-gcarm-viewport role="img" aria-label="固定目标姿势，对照空手、加重物和开启重力补偿后的 G1 左臂">
    <div class="gcarm-loading"><span data-gcarm-status>滚动到此处加载 G1 模型</span></div>
    <div class="gcarm-overlay" data-gcarm-overlay aria-hidden="true">
      <span class="gcarm-tag" data-gcarm-tag="ghost">目标姿势</span>
    </div>
  </div>
  <div class="gcarm-actions"><button type="button" data-gcarm-play disabled>播放演示</button><span>半透明臂：目标姿势 · 实心臂：实际姿势</span></div>
  <div class="gcarm-readout">
    <span>肩部支撑力矩 <b data-gcarm-float-sp>{Math.abs(initial.left_shoulder_pitch_joint).toFixed(1)} N·m</b></span>
    <span>肘部支撑力矩 <b data-gcarm-float-el>{Math.abs(initial.left_elbow_joint).toFixed(1)} N·m</b></span>
    <span>手端位置偏差 <b data-gcarm-error>0.0 cm</b></span>
  </div>
  <figcaption>保持同一目标姿势，依次比较空手、增加 0.5 kg 载荷、开启补偿。支撑力矩取自 G1 模型的质量与质心，下垂用简化关节刚度估算。</figcaption>
</figure>
<script>
import { fk, gravityTorques as calculateGravity } from '../lib/g1-arm-physics.js';
import { G1_PAYLOAD_MOUNT } from '../lib/g1-arm-view.js';
import { createLessonPlayback } from '../lib/lesson-playback.js';
import { PHY } from '../lib/g1-arm-physics.js';
import { GRAVITY_LENGTH, GRAVITY_TARGET, gravityLesson } from '../lib/arm-lesson-sequences.js';
(function () {
  const PIN = new Set(['pelvis', 'pelvis_contour_link', 'waist_yaw_link', 'waist_roll_link', 'torso_link', 'logo_link', 'waist_support_link', 'head_link',
    'left_shoulder_pitch_link', 'left_shoulder_roll_link', 'left_shoulder_yaw_link', 'left_elbow_link',
    'left_wrist_roll_link', 'left_wrist_pitch_link', 'left_wrist_yaw_link', 'left_rubber_hand']);
  const ARM_LINKS = ['left_shoulder_pitch_link', 'left_shoulder_roll_link', 'left_shoulder_yaw_link', 'left_elbow_link', 'left_wrist_roll_link', 'left_wrist_pitch_link', 'left_wrist_yaw_link', 'left_rubber_hand'];
  const WRIST_LINK = 'left_wrist_yaw_link';
  const TORSO_LINK = 'torso_link';

  document.querySelectorAll('.gcarm-demo').forEach((demo) => {
    if (!(demo instanceof HTMLElement)) return;
    const viewport = demo.querySelector('[data-gcarm-viewport]');
    const statusEl = demo.querySelector('[data-gcarm-status]');
    const modeEl = demo.querySelector('[data-gcarm-mode]');
    const tqShoulder = demo.querySelector('[data-gcarm-float-sp]');
    const tqElbow = demo.querySelector('[data-gcarm-float-el]');
    const errorEl = demo.querySelector('[data-gcarm-error]');
    const playBtn = demo.querySelector('[data-gcarm-play]');
    const explanationEl = demo.querySelector('[data-gcarm-explanation]');
    const countEl = demo.querySelector('[data-gcarm-count]');
    const urdfUrl = demo.dataset.urdfUrl;
    if (!(viewport instanceof HTMLElement) || !urdfUrl || !(playBtn instanceof HTMLButtonElement)) return;
    const CHAIN = PHY.chain;
    const D2R = Math.PI / 180;
    const fmt1 = v => Math.abs(v).toFixed(1);
    let payloadMass = 0, payload = null;
    const gravityTorques = q => calculateGravity(q, payloadMass);
    const target = GRAVITY_TARGET;
    let live = target.slice(), compOn = false, lastStep = -1;
    const tags = { sp: demo.querySelector('[data-gcarm-tag="sp"]'), el: demo.querySelector('[data-gcarm-tag="el"]'), wr: demo.querySelector('[data-gcarm-tag="wr"]'), ghost: demo.querySelector('[data-gcarm-tag="ghost"]') };
    let THREE_NS = null;
    let scene; let camera; let renderer; let controls; let grid = null;
    let robot; let ghost; let modelGroup; let torsoLink;
    let playback = null;
    let resizeObserver; let themeObserver; let mediaQuery;
    let probe = null;
    let disposed = false;

    const setState = (s, msg) => { demo.dataset.state = s; if (msg !== undefined && statusEl) statusEl.textContent = msg; };
    const scheduleRender = () => { if (playback) playback.schedule(); };
    const reducedMotion = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const syncOverlay = () => {
      if (!robot || !overlayEl) return;
      const map = [['sp', 'left_shoulder_pitch_joint'], ['el', 'left_elbow_joint'], ['wr', 'left_wrist_yaw_joint']];
      for (const pair of map) {
        const node = tags[pair[0]];
        if (!node) continue;
        const buf = posBuf[pair[0]] || (posBuf[pair[0]] = { x: 0, y: 0, visible: false });
        const vis = project(robot.joints[pair[1]], buf);
        node.style.transform = 'translate(' + buf.x.toFixed(1) + 'px,' + buf.y.toFixed(1) + 'px)';
        node.style.opacity = vis ? '1' : '0';
      }
      const ghostNode = tags.ghost;
      if (ghostNode) {
        const buf = posBuf.ghost || (posBuf.ghost = { x: 0, y: 0, visible: false });
        const vis = !!ghost && ghost.visible && project(ghost.joints['left_wrist_yaw_joint'], buf);
        ghostNode.style.transform = 'translate(' + buf.x.toFixed(1) + 'px,' + buf.y.toFixed(1) + 'px)';
        ghostNode.style.opacity = vis ? '1' : '0';
      }
    };
    const overlayEl = demo.querySelector('[data-gcarm-overlay]');
    const posBuf = {};
    const project = (obj, out) => {
      if (!obj || !camera || !renderer) return false;
      const THREE = THREE_NS;
      const v = new THREE.Vector3();
      obj.getWorldPosition(v);
      v.project(camera);
      const w = renderer.domElement.clientWidth;
      const h = renderer.domElement.clientHeight;
      out.x = (v.x * 0.5 + 0.5) * w;
      out.y = (-v.y * 0.5 + 0.5) * h;
      out.visible = v.z > -1 && v.z < 1;
      return out.visible;
    };

    const frameStep = time => {
      if (disposed) return;
      const s = gravityLesson(time, reducedMotion());
      live = s.angles; payloadMass = s.payloadMass; compOn = s.compensation;
      demo.dataset.step = String(s.index);
      if (s.index !== lastStep) {
        modeEl.textContent = s.title;
        explanationEl.textContent = s.explanation;
        countEl.textContent = `${s.index + 1} / 3`;
        lastStep = s.index;
      }
      if (robot) {
        applyJoints(robot, live);
        applyJoints(ghost, target);
        ghost.visible = true;
        updateReadout();
      }
      if (!renderer || !scene || !camera) return;
      renderer.render(scene, camera); demo.dataset.rendered = 'true'; syncOverlay();
    };

    const resolveCssColor = (expr, fallback) => {
      if (!THREE_NS) return null;
      if (!probe) { probe = document.createElement("span"); probe.setAttribute("aria-hidden", "true"); probe.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;"; demo.appendChild(probe); }
      let computed = "";
      try { probe.style.color = ""; probe.style.color = expr; computed = (getComputedStyle(probe).color || "").trim(); } catch { computed = ""; }
      if (!/^(rgb|rgba|hsl|hsla)\(/i.test(computed) && !/^#[0-9a-f]{3,8}$/i.test(computed)) computed = fallback || "";
      try { return computed ? new THREE_NS.Color(computed) : null; } catch { return fallback ? new THREE_NS.Color(fallback) : null; }
    };

    const buildGrid = () => {
      if (!THREE_NS || !scene) return;
      if (grid) { scene.remove(grid); grid.geometry.dispose(); grid.material.dispose(); }
      const THREE = THREE_NS;
      const c1 = resolveCssColor('var(--sl-color-gray-3)', '#888c96');
      const c2 = resolveCssColor('var(--sl-color-gray-5)', '#555962');
      grid = new THREE.GridHelper(1.2, 12, c1 || 0x888c96, c2 || 0x555962);
      grid.material.transparent = true;
      grid.material.opacity = 0.4;
      scene.add(grid);
    };
    const applyTheme = () => { if (!scene) return; buildGrid(); scheduleRender(); };

    // ── 自检：屏幕几何与手算力矩必须与 URDF 一致 ────────────────────────────
    const verifyPhysics = () => {
      const errs = [];
      if (!robot || !torsoLink) { demo.dataset.selfcheck = "robot 未加载"; return errs; }
      const THREE = THREE_NS;
      const { joints } = fk(CHAIN.map((c) => c.def * D2R));
      [["left_shoulder_pitch_joint", "sp"], ["left_elbow_joint", "el"], ["left_wrist_yaw_joint", "wr"]].forEach((pair) => {
        const jnt = robot.joints[pair[0]];
        if (!jnt) { errs.push(pair[0] + " 缺失"); return; }
        const lp = joints[pair[0]].p;
        const local = new THREE.Vector3(...lp);
        torsoLink.updateMatrixWorld(true);
        const expect = torsoLink.localToWorld(local.clone());
        const got = new THREE.Vector3();
        jnt.getWorldPosition(got);
        const derr = expect.distanceTo(got);
        demo.dataset["err" + pair[1]] = derr.toFixed(5);
        if (derr > 5e-3) errs.push(pair[0] + " 位置偏差 " + derr.toFixed(4) + " m");
      });
      const G = gravityTorques(CHAIN.map((c) => c.def * D2R));
      const g0 = G.left_shoulder_pitch_joint;
      demo.dataset.tauShoulder = g0.toFixed(3);
      if (!(Math.abs(g0) > 0.5 && Math.abs(g0) < 4)) errs.push("肩 pitch 力矩异常 " + g0.toFixed(3));
      demo.dataset.selfcheck = errs.length ? errs.join("; ") : "ok";
      if (errs.length) console.warn("[gcarm] 自检:", errs.join("; "));
      return errs;
    };

    const applyJoints = (obj, q) => {
      if (!obj) return;
      CHAIN.forEach((c, i) => obj.setJointValue(c.name, q[i]));
      obj.updateMatrixWorld(true);
    };
    const applyGhostMaterial = () => {
      ghost.traverse((o) => {
        if (o.isMesh) {
          o.renderOrder = -1;
          o.material = o.material.clone();
          o.material.transparent = true;
          o.material.opacity = 0.34;
          o.material.depthWrite = false;
        }
      });
    };
    const fitCamera = () => {
      if (!camera || !controls || !robot || !THREE_NS) return;
      const THREE = THREE_NS;
      const box = new THREE.Box3();
      ARM_LINKS.forEach((n) => { if (robot.links[n]) box.expandByObject(robot.links[n]); });
      if (box.isEmpty()) return;
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const radius = Math.max(size.x, size.y, size.z, 0.18) * 0.62;
      const dist = radius / Math.tan((camera.fov * Math.PI) / 360);
      controls.target.copy(center);
      camera.near = Math.max(dist / 100, 0.005);
      camera.far = dist * 50;
      camera.position.set(center.x + dist * 0.9, center.y + dist * 0.35, center.z + dist * 1.15);
      camera.updateProjectionMatrix();
      controls.update();
      scheduleRender();
    };
    const resize = () => {
      if (!renderer || !camera) return;
      const w = Math.max(viewport.clientWidth, 1);
      const h = Math.max(viewport.clientHeight, 1);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(w, h, false);
      scheduleRender();
    };

    const updateReadout = () => {
      const G = gravityTorques(target);
      demo.dataset.payloadMass = String(payloadMass);
      demo.dataset.compensation = String(compOn);
      demo.dataset.tauShoulder = String(G.left_shoulder_pitch_joint);
      demo.dataset.tauElbow = String(G.left_elbow_joint);
      if (payload) payload.visible = payloadMass > 0;
      const expected = fk(target).links[WRIST_LINK].p;
      const actual = fk(live).links[WRIST_LINK].p;
      const err = Math.hypot(...actual.map((v,i) => v-expected[i]));
      demo.dataset.handError = String(err);
      tqShoulder.textContent = fmt1(G.left_shoulder_pitch_joint) + ' N·m';
      tqElbow.textContent = fmt1(G.left_elbow_joint) + ' N·m';
      errorEl.textContent = fmt1(err * 100) + ' cm';
    };

    const load = async () => {
      try {
        setState('loading', '加载 Three.js 与 URDF 解析器');
        const mods = await Promise.all([
          import("three"),
          import("three/examples/jsm/controls/OrbitControls.js"),
          import("urdf-loader"),
        ]);
        if (disposed) return;
        const THREE = mods[0];
        const OrbitControls = mods[1].OrbitControls;
        const URDFLoader = mods[2].default;
        THREE_NS = THREE;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(38, 1, 0.005, 50);
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.setClearColor(0x000000, 0);
        renderer.domElement.style.touchAction = "pan-y";
        renderer.domElement.setAttribute("aria-hidden", "true");
        viewport.appendChild(renderer.domElement);

        scene.add(new THREE.HemisphereLight(0xffffff, 0x46505f, 2.3));
        const key = new THREE.DirectionalLight(0xffffff, 2.4);
        key.position.set(2.5, 4, 3);
        const fill = new THREE.DirectionalLight(0xbdd7ff, 0.9);
        fill.position.set(-3, 1.5, -2);
        scene.add(key, fill);

        controls = new OrbitControls(camera, renderer.domElement);
        controls.enabled = false;
        controls.enableDamping = false;
        controls.dampingFactor = 0.09;
        controls.minDistance = 0.25;
        controls.maxDistance = 3.2;
        controls.addEventListener("change", scheduleRender);

        const manager = new THREE.LoadingManager();
        let resolveRes = () => {};
        const resReady = new Promise((res) => { resolveRes = res; });
        manager.onProgress = (_u, loaded, total) => {
          setState("loading", total > 0 ? "加载模型网格 " + loaded + "/" + total : "加载模型网格");
          if (total > 0 && loaded >= total) resolveRes();
        };
        manager.onLoad = () => { resolveRes(); scheduleRender(); };
        manager.onError = (u) => console.warn("G1 网格加载失败：" + u);

        const loader = new URDFLoader(manager);
        loader.workingPath = urdfUrl.slice(0, urdfUrl.lastIndexOf("/") + 1);
        loader.fetchOptions = { cache: "force-cache" };

        setState('loading', '解析 URDF 结构');
        robot = await loader.loadAsync(urdfUrl);
        if (disposed) return;
        ghost = await loader.loadAsync(urdfUrl);
        if (disposed) return;
        robot.rotation.x = -Math.PI / 2;
        ghost.rotation.x = -Math.PI / 2;
        Object.keys(robot.links).forEach((n) => { if (robot.links[n]) robot.links[n].visible = PIN.has(n); });
        Object.keys(ghost.links).forEach((n) => { if (ghost.links[n]) ghost.links[n].visible = PIN.has(n); });
        applyGhostMaterial();
        payload = new THREE.Group();
        const mount = G1_PAYLOAD_MOUNT;
        for (const [size, center, color] of [[mount.traySize, mount.trayCenter, 0x667085], [mount.blockSize, mount.blockCenter, 0xeaa447]]) {
          const mesh = new THREE.Mesh(new THREE.BoxGeometry(...size), new THREE.MeshStandardMaterial({color, roughness:.7}));
          mesh.position.set(...center); payload.add(mesh);
        }
        robot.links[mount.link].add(payload);
        payload.visible = payloadMass > 0;
        modelGroup = new THREE.Group();
        modelGroup.add(robot, ghost);
        scene.add(modelGroup);
        torsoLink = robot.links[TORSO_LINK];
        robot.updateMatrixWorld(true);
        ghost.updateMatrixWorld(true);

        const startTorso = new THREE.Vector3();
        if (torsoLink) torsoLink.getWorldPosition(startTorso);
        buildGrid();
        if (grid) grid.position.y = startTorso.y - 0.02;

        await Promise.race([resReady, new Promise((res) => setTimeout(res, 4000))]);
        if (disposed) return;

        applyJoints(robot, live);
        applyJoints(ghost, target);
        verifyPhysics();

        resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(viewport);
        themeObserver = new MutationObserver(applyTheme);
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
        if (window.matchMedia) {
          mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
          mediaQuery.addEventListener("change", applyTheme);
        }

        setState("ready", "");
        resize();
        fitCamera();
        updateReadout();
        scheduleRender();
      } catch (error) {
        console.error("G1 左臂重力补偿演示加载失败：", error);
        setState("error", "模型加载失败，请检查网络或资源路径");
        disposeAll();
        throw error;
      }
    };

    // 失败路径也要把 WebGL 上下文、观察者与监听还回去（旧实现只清状态文案）
    const disposeAll = () => {
      if (disposed) return;
      disposed = true;
      if (playback) playback.dispose();
      if (resizeObserver) resizeObserver.disconnect();
      if (themeObserver) themeObserver.disconnect();
      if (mediaQuery) mediaQuery.removeEventListener("change", applyTheme);
      if (controls) controls.dispose();
      const geometries = new Set(), materials = new Set();
      scene?.traverse(o => {
        if (o.geometry) geometries.add(o.geometry);
        for (const m of Array.isArray(o.material) ? o.material : [o.material]) if (m) materials.add(m);
      });
      geometries.forEach(g => g.dispose()); materials.forEach(m => m.dispose());
      if (renderer) { renderer.dispose(); renderer.domElement.remove(); }
      renderer = null;
    };

    document.addEventListener('astro:before-swap', disposeAll, { once: true });
    window.addEventListener('pagehide', disposeAll, { once: true });

    playback = createLessonPlayback(demo, playBtn, {duration: GRAVITY_LENGTH, draw: frameStep, load});
  });
})();
</script>

<style is:global>
.gcarm-demo{margin:1.5rem 0;padding:1rem;border:1px solid var(--sl-color-gray-5);border-radius:12px;}
.gcarm-demo :is(div,p,span,button){margin-top:0;}
.gcarm-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;}.gcarm-heading strong{color:var(--sl-color-text-accent);}.gcarm-heading span{font-size:.8rem;color:var(--sl-color-gray-2);}
.gcarm-explanation{min-height:3.2em;margin:.65rem 0!important;font-size:.9rem;line-height:1.6;}
.gcarm-viewport{position:relative;overflow:hidden;width:100%;height:350px;border-radius:8px;background:var(--sl-color-gray-7,var(--sl-color-gray-6));}
.gcarm-viewport canvas{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;touch-action:pan-y;}
.gcarm-loading{position:absolute;inset:45% .6rem auto;text-align:center;font-size:.8rem;}.gcarm-demo[data-state='ready'] .gcarm-loading{display:none;}
.gcarm-overlay{position:absolute;inset:0;pointer-events:none;}.gcarm-tag{position:absolute;top:0;left:0;padding:.1rem .3rem;border:1px dashed var(--sl-color-accent);border-radius:5px;background:var(--sl-color-bg);color:var(--sl-color-text-accent);font-size:.75rem;white-space:nowrap;}
.gcarm-actions{display:flex;align-items:center;gap:1rem;margin:.8rem 0!important;}.gcarm-actions span{font-size:.78rem;color:var(--sl-color-gray-2);}
.gcarm-actions button{flex-shrink:0;font:inherit;font-size:.85rem;padding:.45rem 1rem;border:1px solid var(--sl-color-accent);border-radius:7px;background:var(--sl-color-accent-low);color:var(--sl-color-text-accent);cursor:pointer;}.gcarm-actions button:disabled{opacity:.5;cursor:wait;}.gcarm-actions button:focus-visible{outline:2px solid var(--sl-color-accent);outline-offset:3px;}
.gcarm-readout{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;padding:.7rem;background:var(--sl-color-gray-7,var(--sl-color-gray-6));border-radius:8px;font-size:.75rem;}.gcarm-readout b{display:block;color:var(--sl-color-text-accent);font-size:1rem;font-variant-numeric:tabular-nums;}
.gcarm-demo figcaption{font-size:.78rem;color:var(--sl-color-gray-2);line-height:1.6;margin:.8rem 0 0;}
@media(max-width:40rem){.gcarm-demo{padding:.7rem;}.gcarm-viewport{height:300px;}.gcarm-readout{gap:.3rem;padding:.5rem;font-size:.7rem;}.gcarm-readout b{font-size:.85rem;}}
</style>
