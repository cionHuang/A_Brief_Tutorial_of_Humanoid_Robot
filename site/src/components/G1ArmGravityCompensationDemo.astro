---
/**
 * G1 左臂重力补偿（Gravity Compensation）交互演示 —— 4.3 节“### 重力补偿”之后。
 *
 * 呈现：three.js + urdf-loader 懒加载仓库内 G1 29 DoF URDF（site/public/models/g1/g1_29dof.urdf），
 * 只显示躯干与左臂链；右臂、腰、腿、头 visible = false。
 *
 * 模型（g1_29dof，末端为 29dof 自带的 left_rubber_hand，约 0.17 kg）：
 *   关节 origin xyz / rpy / axis / limit 与各 link 的 <inertial> mass、质心 origin
 *   均逐字取自 g1_29dof.urdf（见 PHY.chain 与 PHY.com）。左臂总质量 ≈ 3.52 kg。
 *
 * 静力学：关节 j 需要承担的重力力矩，等于该关节以远各段“重力矩沿关节轴的分量”之和：
 *   G_j(q) = Σ_{i∈distal(j)} u_j(q) · [ (com_i(q) − p_j(q)) × (0, 0, −m_i g) ]
 * 其中 u_j 为关节轴在世界系（URDF Z-up）的单位向量；加载后与模型坐标做自检。
 *
 * 柔性模型（教学示意，非真机刚度）：忽略重力补偿时，电机只靠位置误差出力，
 *   δ_j = −G_j / K_p（Kp = 8 N·m/rad），限幅 SAG_CAP = 30° 后再夹到 URDF 限位。
 *   于是同一个目标姿态下：开补偿 → 实际姿态贴合目标；关补偿 → 手臂可见下垂，且下垂幅度随姿态变化。
 *   K_p 是演示参数，真机由控制器增益、电流环和负载共同决定，不能当作 G1 的伺服刚度。
 */

import { texParts } from '../lib/tex.js';

const D2R = Math.PI / 180;
const R2D = 180 / Math.PI;
const I3 = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];

const mul3 = (A, B) => A.map((row, i) => [0, 1, 2].map((j) => row[0] * B[0][j] + row[1] * B[1][j] + row[2] * B[2][j]));
const mulVec = (R, v) => R.map((row) => row[0] * v[0] + row[1] * v[1] + row[2] * v[2]);
// URDF RPY：Rz(yaw)·Ry(pitch)·Rx(roll)
const rpyMat = (r, p, y) => {
  const cr = Math.cos(r); const sr = Math.sin(r);
  const cp = Math.cos(p); const sp = Math.sin(p);
  const cy = Math.cos(y); const sy = Math.sin(y);
  return [
    [cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr],
    [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr],
    [-sp, cp * sr, cp * cr],
  ];
};
const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

const SAG_KP = 8; // N·m/rad，教学示意刚度
const SAG_CAP = 30 * D2R; // 单关节偏差限幅

// ── URDF 数据（g1_29dof.urdf 左臂链，逐字抄录）────────────────────────────
const PHY = {
  chain: [
    { name: 'left_shoulder_pitch_joint', key: 'sp', label: '肩 pitch', link: 'left_shoulder_pitch_link', xyz: [0.0039563, 0.10022, 0.23778], rpy: [0.27931, 5.4949e-05, -0.00019159], axis: [0, 1, 0], lo: -3.0892, hi: 2.6704, def: 0, movable: true },
    { name: 'left_shoulder_roll_joint', key: 'sr', label: '肩 roll', link: 'left_shoulder_roll_link', xyz: [0, 0.038, -0.013831], rpy: [-0.27925, 0, 0], axis: [1, 0, 0], lo: -1.5882, hi: 2.2515, def: 20, movable: true },
    { name: 'left_shoulder_yaw_joint', key: 'sy', label: '肩 yaw', link: 'left_shoulder_yaw_link', xyz: [0, 0.00624, -0.1032], rpy: [0, 0, 0], axis: [0, 0, 1], lo: -2.618, hi: 2.618, def: 0, movable: true },
    { name: 'left_elbow_joint', key: 'el', label: '肘', link: 'left_elbow_link', xyz: [0.015783, 0, -0.080518], rpy: [0, 0, 0], axis: [0, 1, 0], lo: -1.0472, hi: 2.0944, def: 40, movable: true },
    { name: 'left_wrist_roll_joint', key: 'wr', label: '腕 roll', link: 'left_wrist_roll_link', xyz: [0.1, 0.00188791, -0.01], rpy: [0, 0, 0], axis: [1, 0, 0], lo: -1.972222054, hi: 1.972222054, def: 0, movable: true },
    { name: 'left_wrist_pitch_joint', key: 'wp', label: '腕 pitch', link: 'left_wrist_pitch_link', xyz: [0.038, 0, 0], rpy: [0, 0, 0], axis: [0, 1, 0], lo: -1.614429558, hi: 1.614429558, def: 0, movable: true },
    { name: 'left_wrist_yaw_joint', key: 'wy', label: '腕 yaw', link: 'left_wrist_yaw_link', xyz: [0.046, 0, 0], rpy: [0, 0, 0], axis: [0, 0, 1], lo: -1.614429558, hi: 1.614429558, def: 0, movable: true },
    { name: 'left_hand_palm_joint', key: 'palm', label: '手', link: 'left_rubber_hand', xyz: [0.0415, 0.003, 0], rpy: [0, 0, 0], axis: [0, 0, 1], lo: 0, hi: 0, def: 0, movable: false, fixed: true },
  ],
  // 每个 link 的 <inertial>：质量与质心（link 系）
  com: {
    left_shoulder_pitch_link: { m: 0.718, c: [0, 0.035892, -0.011628] },
    left_shoulder_roll_link: { m: 0.643, c: [-0.000227, 0.00727, -0.063243] },
    left_shoulder_yaw_link: { m: 0.734, c: [0.010773, -0.002949, -0.072009] },
    left_elbow_link: { m: 0.6, c: [0.064956, 0.004454, -0.010062] },
    left_wrist_roll_link: { m: 0.08544498, c: [0.01713944778, 0.00053759094, 0.00000048864] },
    left_wrist_pitch_link: { m: 0.48404956, c: [0.02299989837, -0.00111685314, -0.00111658096] },
    left_wrist_yaw_link: { m: 0.08457647, c: [0.02200381568, 0.00049485096, 0.00053861123] },
    left_rubber_hand: { m: 0.17, c: [0.05361310808, -0.00295905240, 0.00215413091] },
  },
};

const CH = PHY.chain;
const COM = PHY.com;
const SLIDERS = CH.filter((c) => c.movable);
const DEF_Q = CH.map((c) => c.def * D2R);

// ── URDF 正运动学（Z-up），返回各关节 p/u 与各 link 位姿 ──────────────────
const fk = (q) => {
  const joints = {};
  const links = {};
  let R = I3;
  let p = [0, 0, 0];
  CH.forEach((j, i) => {
    const d = mulVec(R, j.xyz);
    p = [p[0] + d[0], p[1] + d[1], p[2] + d[2]];
    R = mul3(R, rpyMat(j.rpy[0], j.rpy[1], j.rpy[2]));
    if (j.fixed) { joints[j.name] = { p: p.slice(), u: [0, 0, 0] }; links[j.link] = { p: p.slice(), R: R.map((r) => r.slice()) }; return; }
    joints[j.name] = { p: p.slice(), u: mulVec(R, j.axis) };
    const ang = q[i];
    const n = Math.hypot(j.axis[0], j.axis[1], j.axis[2]) || 1;
    const ux = j.axis[0] / n; const uy = j.axis[1] / n; const uz = j.axis[2] / n;
    const c = Math.cos(ang); const s = Math.sin(ang); const t = 1 - c;
    R = mul3(R, [
      [t * ux * ux + c, t * ux * uy - s * uz, t * ux * uz + s * uy],
      [t * ux * uy + s * uz, t * uy * uy + c, t * uy * uz - s * ux],
      [t * ux * uz - s * uy, t * uy * uz + s * ux, t * uz * uz + c],
    ]);
    links[j.link] = { p: p.slice(), R: R.map((r) => r.slice()) };
  });
  return { joints, links };
};
const comWorld = (links) => {
  const out = {};
  for (const [name, info] of Object.entries(COM)) {
    const f = links[name];
    if (!f) continue;
    const c = mulVec(f.R, info.c);
    out[name] = [f.p[0] + c[0], f.p[1] + c[1], f.p[2] + c[2]];
  }
  return out;
};
// G_j(q)：关节 j 以远各段重力矩沿关节轴的分量之和。
// 符号约定与正文 τ_hold ≈ g(q) 一致：返回的是“电机为保持姿态需要承担的力矩”。
// 因此重力力矢量取 +mg ẑ；若写成 −mg ẑ 会整体反号，关掉补偿后手臂会被算成
// 向上升（势能升高），与物理和正文都相反。
const gravityTorques = (q) => {
  const { joints, links } = fk(q);
  const com = comWorld(links);
  const out = {};
  CH.forEach((c, ji) => {
    const j = joints[c.name];
    let acc = 0;
    for (const downstream of CH.slice(ji + 1)) {
      const info = COM[downstream.link];
      if (!info) continue;
      const r = [com[downstream.link][0] - j.p[0], com[downstream.link][1] - j.p[1], com[downstream.link][2] - j.p[2]];
      const gg = cross(r, [0, 0, info.m * 9.81]);
      acc += j.u[0] * gg[0] + j.u[1] * gg[1] + j.u[2] * gg[2];
    }
    out[c.name] = acc;
  });
  return out;
};
// 关补偿：δ = −G/Kp（限幅 + 夹限位）；开补偿：实际 = 目标
const sagFrom = (q) => {
  const G = gravityTorques(q);
  const actual = CH.map((c, i) => clamp(q[i] + clamp(-G[c.name] / SAG_KP, -SAG_CAP, SAG_CAP), c.lo, c.hi));
  return { G, actual };
};

// ── 首屏静态读数（加载 3D 前先写进 markup）────────────────────────────────
const DEF_SAG = sagFrom(DEF_Q);
const DEF_G = gravityTorques(DEF_Q);
const DEF_W = fk(DEF_Q).links.left_wrist_yaw_link.p;
const DEF_W2 = fk(DEF_SAG.actual).links.left_wrist_yaw_link.p;
const DEF_ERR = Math.hypot(DEF_W[0] - DEF_W2[0], DEF_W[1] - DEF_W2[1], DEF_W[2] - DEF_W2[2]);
const fmt1 = (v) => (Math.abs(v) < 0.05 ? '0.0' : (v < 0 ? '−' : '') + Math.abs(v).toFixed(1));
const fmt2 = (v) => (Math.abs(v) < 0.005 ? '0.00' : (v < 0 ? '−' : '') + Math.abs(v).toFixed(2));
const EXPR = (s) => ({ tex: s });
const DEF_TAU_PARTS = [{ text: '需电机承担的重力力矩（正负号表示方向）：' }].concat(
  SLIDERS.map((c, i) => (i ? [{ text: '　' }, { text: c.label + ' ' }, EXPR(fmt1(DEF_G[c.name]) + '\\ \\text{N·m}')] : [{ text: c.label + ' ' }, EXPR(fmt1(DEF_G[c.name]) + '\\ \\text{N·m}')])).flat(),
);
const DEF_SAG_PARTS = [{ text: '关补偿后的实际角（偏差 Δ = −τ_g/K_p）：' }].concat(
  SLIDERS.map((c, i) => {
    const idx = CH.indexOf(c);
    const actual = DEF_SAG.actual[idx] * R2D;
    const dev = actual - c.def;
    const item = [{ text: c.label + ' ' }, EXPR(fmt1(actual) + '^\\circ'), EXPR('(\\Delta ' + fmt1(dev) + '^\\circ)')];
    return i ? [{ text: '　' }].concat(item) : item;
  }).flat(),
);
const DEF_ERR_PARTS = [{ text: '手端位置差 |Δp| = ' }, EXPR(fmt2(DEF_ERR * 100) + '\\ \\text{cm}')];
const DEF_NAMES = SLIDERS.map((c) => c.label).join(' / ');

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const urdfUrl = baseUrl + 'models/g1/g1_29dof.urdf';
---

<figure
  class="gcarm-demo"
  data-state="idle"
  data-urdf-url={urdfUrl}
  data-phy={JSON.stringify({ chain: CH, com: COM, kp: SAG_KP, cap: SAG_CAP, def: CH.map((c) => c.def) })}
>
  <div
    class="gcarm-viewport"
    data-gcarm-viewport
    role="application"
    tabindex="0"
    aria-label="G1 左臂重力补偿三维演示：拖动肩、肘、腕六个关节角滑块设定目标姿态，用真实 G1 URDF 网格渲染的左臂实时显示；关闭重力补偿后手臂会因重力下垂，半透明幽灵臂保留目标姿态"
  >
    <div class="gcarm-loading" data-gcarm-loading>
      <span class="gcarm-spinner" aria-hidden="true"></span>
      <span class="gcarm-status" data-gcarm-status>滚动到此处加载 3D 模型</span>
    </div>
    <div class="gcarm-overlay" data-gcarm-overlay aria-hidden="true">
      <div class="gcarm-tag" data-gcarm-tag="sp">肩</div>
      <div class="gcarm-tag" data-gcarm-tag="el">肘</div>
      <div class="gcarm-tag" data-gcarm-tag="wr">腕</div>
      <div class="gcarm-tag gcarm-tag-target" data-gcarm-tag="ghost">目标姿态（半透明臂）</div>
    </div>
    <div class="gcarm-mode" data-gcarm-mode>重力补偿：开</div>
    <div class="gcarm-torques" data-gcarm-float role="group" aria-label="此刻的重力力矩">
      <div class="gcarm-tq-title">此刻的重力力矩</div>
      <div class="gcarm-tq-row"><span>肩 pitch</span><b data-gcarm-float-sp>—</b></div>
      <div class="gcarm-tq-row"><span>肘</span><b data-gcarm-float-el>—</b></div>
    </div>
  </div>

  <div class="gcarm-controls">
    <div class="gcarm-row">
      <span class="gcarm-row-title">肩</span>
      {SLIDERS.slice(0, 3).map((c) => (
        <label class="gcarm-slider-label">{c.label}
          <input class="gcarm-range" type="range" data-gcarm-joint={c.key} min={(R2D * c.lo).toFixed(1)} max={(R2D * c.hi).toFixed(1)} step="1" value={c.def.toFixed(1)} />
          <span class="gcarm-val" data-gcarm-val={c.key}>{fmt1(c.def)}°</span>
        </label>
      ))}
    </div>
    <div class="gcarm-row">
      <span class="gcarm-row-title">肘 / 腕</span>
      {SLIDERS.slice(3).map((c) => (
        <label class="gcarm-slider-label">{c.label}
          <input class="gcarm-range" type="range" data-gcarm-joint={c.key} min={(R2D * c.lo).toFixed(1)} max={(R2D * c.hi).toFixed(1)} step="1" value={c.def.toFixed(1)} />
          <span class="gcarm-val" data-gcarm-val={c.key}>{fmt1(c.def)}°</span>
        </label>
      ))}
    </div>
    <div class="gcarm-row gcarm-row-btns">
      <span class="gcarm-row-title"></span>
      <div class="gcarm-btnpair">
        <button type="button" class="gcarm-btn" data-gcarm-toggle>重力补偿：开</button>
        <button type="button" class="gcarm-btn" data-gcarm-resetcam disabled>复位视角</button>
      </div>
    </div>
    <div class="gcarm-row">
      <span class="gcarm-row-title"></span>
      <span class="gcarm-hint">只画左臂；半透明臂 = 目标姿态，实心臂 = 实际姿态。K_p = 8 N·m/rad（教学示意）</span>
    </div>
  </div>

  <div class="gcarm-readout">
    <output class="gcarm-out gcarm-out-comp" aria-live="polite"><span data-gcarm-tex="comp" set:html={texParts(DEF_TAU_PARTS)}></span></output>
    <output class="gcarm-out gcarm-out-sag" aria-live="polite"><span data-gcarm-tex="sag" set:html={texParts(DEF_SAG_PARTS)}></span></output>
    <output class="gcarm-out gcarm-out-err" aria-live="polite"><span data-gcarm-tex="err" set:html={texParts(DEF_ERR_PARTS)}></span></output>
  </div>

  <figcaption>
    用 G1 官方 URDF 网格渲染的左臂（<code>g1_29dof.urdf</code>；肩 3 + 肘 1 + 腕 3 共 7 个可动关节，手为无手模型自带的固定橡胶手）：拖动滑块设定目标姿态，半透明幽灵臂停在目标姿态，实心臂按 K_p = 8 N·m/rad 的关节刚度跟随，下垂量按 Δ = −τ_g/K_p 算出后再夹到模型限位。关掉重力补偿，三条读数会同时变化——需电机承担的重力力矩、各关节实际角与偏差、手端位置差 |Δp|。关节顺序、轴线和限位逐字取自模型文件，网格为可视化模型，不代表真实硬件的内部结构；K_p 是演示参数，真机由控制器增益、电流环和负载共同决定，不能当作 G1 的伺服刚度。模型来源：
    <a href="https://github.com/unitreerobotics/unitree_rl_gym/tree/main/resources/robots/g1_description">unitree_rl_gym</a>。
  </figcaption>

</figure>

<script>
import { texParts } from '../lib/tex.js';
import { createVisibleRaf } from '../lib/visible-raf.js';
(function () {
  const PIN = new Set(['pelvis', 'pelvis_contour_link', 'waist_yaw_link', 'waist_roll_link', 'torso_link', 'logo_link', 'waist_support_link', 'head_link',
    'left_shoulder_pitch_link', 'left_shoulder_roll_link', 'left_shoulder_yaw_link', 'left_elbow_link',
    'left_wrist_roll_link', 'left_wrist_pitch_link', 'left_wrist_yaw_link', 'left_rubber_hand']);
  const ARM_LINKS = ['left_shoulder_pitch_link', 'left_shoulder_roll_link', 'left_shoulder_yaw_link', 'left_elbow_link', 'left_wrist_roll_link', 'left_wrist_pitch_link', 'left_wrist_yaw_link', 'left_rubber_hand'];
  const WRIST_LINK = 'left_wrist_yaw_link';
  const TORSO_LINK = 'torso_link';

  document.querySelectorAll('.gcarm-demo').forEach((demo) => {
    if (!(demo instanceof HTMLElement)) return;
    const viewport = demo.querySelector('[data-gcarm-viewport]');
    const statusEl = demo.querySelector('[data-gcarm-status]');
    const modeEl = demo.querySelector('[data-gcarm-mode]');
    const tqEl = demo.querySelector('[data-gcarm-float]');
    const tqShoulder = demo.querySelector('[data-gcarm-float-sp]');
    const tqElbow = demo.querySelector('[data-gcarm-float-el]');
    const toggleBtn = demo.querySelector('[data-gcarm-toggle]');
    const resetBtn = demo.querySelector('[data-gcarm-resetcam]');
    const raw = demo.dataset.phy;
    const urdfUrl = demo.dataset.urdfUrl;
    if (!(viewport instanceof HTMLElement) || !raw || !urdfUrl || !(toggleBtn instanceof HTMLButtonElement)) return;

    const PHY = JSON.parse(raw);
    const CHAIN = PHY.chain;
    const COM = PHY.com;
    const KP = PHY.kp;
    const CAP = PHY.cap;
    const R2D = 180 / Math.PI;
    const D2R = Math.PI / 180;
    const I3 = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
    const mul3 = (A, B) => A.map((row, i) => [0, 1, 2].map((j) => row[0] * B[0][j] + row[1] * B[1][j] + row[2] * B[2][j]));
    const mulVec = (R, v) => R.map((row) => row[0] * v[0] + row[1] * v[1] + row[2] * v[2]);
    const rpyMat = (r, p, y) => {
      const cr = Math.cos(r); const sr = Math.sin(r); const cp = Math.cos(p); const sp = Math.sin(p); const cy = Math.cos(y); const sy = Math.sin(y);
      return [[cy * cp, cy * sp * sr - sy * cr, cy * sp * cr + sy * sr], [sy * cp, sy * sp * sr + cy * cr, sy * sp * cr - cy * sr], [-sp, cp * sr, cp * cr]];
    };
    const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
    const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
    const fmt1 = (v) => (Math.abs(v) < 0.05 ? '0.0' : (v < 0 ? '−' : '') + Math.abs(v).toFixed(1));
    const fmt2 = (v) => (Math.abs(v) < 0.005 ? '0.00' : (v < 0 ? '−' : '') + Math.abs(v).toFixed(2));

    const fk = (q) => {
      const joints = {};
      const links = {};
      let R = I3;
      let p = [0, 0, 0];
      CHAIN.forEach((j, i) => {
        const d = mulVec(R, j.xyz);
        p = [p[0] + d[0], p[1] + d[1], p[2] + d[2]];
        R = mul3(R, rpyMat(j.rpy[0], j.rpy[1], j.rpy[2]));
        if (j.fixed) { joints[j.name] = { p: p.slice(), u: [0, 0, 0] }; links[j.link] = { p: p.slice(), R: R.map((r) => r.slice()) }; return; }
        joints[j.name] = { p: p.slice(), u: mulVec(R, j.axis) };
        const n = Math.hypot(j.axis[0], j.axis[1], j.axis[2]) || 1;
        const ux = j.axis[0] / n; const uy = j.axis[1] / n; const uz = j.axis[2] / n;
        const c = Math.cos(q[i]); const s = Math.sin(q[i]); const t = 1 - c;
        R = mul3(R, [[t * ux * ux + c, t * ux * uy - s * uz, t * ux * uz + s * uy], [t * ux * uy + s * uz, t * uy * uy + c, t * uy * uz - s * ux], [t * ux * uz - s * uy, t * uy * uz + s * ux, t * uz * uz + c]]);
        links[j.link] = { p: p.slice(), R: R.map((r) => r.slice()) };
      });
      return { joints, links };
    };
    const gravityTorques = (q) => {
      const { joints, links } = fk(q);
      const com = {};
      for (const [name, info] of Object.entries(COM)) {
        const f = links[name];
        if (!f) continue;
        const c = mulVec(f.R, info.c);
        com[name] = [f.p[0] + c[0], f.p[1] + c[1], f.p[2] + c[2]];
      }
      const out = {};
      CHAIN.forEach((c, ji) => {
        const j = joints[c.name];
        let acc = 0;
        for (const downstream of CHAIN.slice(ji + 1)) {
          const info = COM[downstream.link];
          if (!info) continue;
          const r = [com[downstream.link][0] - j.p[0], com[downstream.link][1] - j.p[1], com[downstream.link][2] - j.p[2]];
          const gg = cross(r, [0, 0, info.m * 9.81]);
          acc += j.u[0] * gg[0] + j.u[1] * gg[1] + j.u[2] * gg[2];
        }
        out[c.name] = acc;
      });
      return out;
    };
    const sagFrom = (q) => {
      const G = gravityTorques(q);
      const actual = CHAIN.map((c, i) => clamp(q[i] + clamp(-G[c.name] / KP, -CAP, CAP), c.lo, c.hi));
      return { G, actual };
    };

    const target = CHAIN.map((c) => c.def * D2R);
    const live = target.slice();
    let compOn = true;
    let dirty = true;
    let ghostDirty = true; // 幽灵臂需要重新贴合“当前目标姿态”
    let desired = target.slice();
    const recompute = () => { desired = compOn ? target.slice() : sagFrom(target).actual; dirty = true; };
    recompute();

    const ranges = {};
    const vals = {};
    CHAIN.filter((c) => c.movable).forEach((c) => {
      ranges[c.key] = demo.querySelector('[data-gcarm-joint="' + c.key + '"]');
      vals[c.key] = demo.querySelector('[data-gcarm-val="' + c.key + '"]');
    });
    const tags = { sp: demo.querySelector('[data-gcarm-tag="sp"]'), el: demo.querySelector('[data-gcarm-tag="el"]'), wr: demo.querySelector('[data-gcarm-tag="wr"]'), ghost: demo.querySelector('[data-gcarm-tag="ghost"]') };
    const tex = { comp: demo.querySelector('[data-gcarm-tex="comp"]'), sag: demo.querySelector('[data-gcarm-tex="sag"]'), err: demo.querySelector('[data-gcarm-tex="err"]') };

    let THREE_NS = null;
    let started = false;
    let scene; let camera; let renderer; let controls; let grid = null;
    let robot; let ghost; let modelGroup; let torsoLink;
    let loop = null; // 由 visible-raf 统一调度：离屏/后台自动暂停
    let resizeObserver; let themeObserver; let mediaQuery;
    let probe = null;
    let disposed = false;

    const setState = (s, msg) => { demo.dataset.state = s; if (msg !== undefined && statusEl) statusEl.textContent = msg; };
    const scheduleRender = () => { if (loop) loop.schedule(); };
    const reducedMotion = () => window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const syncOverlay = () => {
      if (!robot || !overlayEl) return;
      const map = [['sp', 'left_shoulder_pitch_joint'], ['el', 'left_elbow_joint'], ['wr', 'left_wrist_yaw_joint']];
      for (const pair of map) {
        const node = tags[pair[0]];
        if (!node) continue;
        const buf = posBuf[pair[0]] || (posBuf[pair[0]] = { x: 0, y: 0, visible: false });
        const vis = project(robot.joints[pair[1]], buf);
        node.style.transform = 'translate(' + buf.x.toFixed(1) + 'px,' + buf.y.toFixed(1) + 'px)';
        node.style.opacity = vis ? '1' : '0';
      }
      const ghostNode = tags.ghost;
      if (ghostNode) {
        const buf = posBuf.ghost || (posBuf.ghost = { x: 0, y: 0, visible: false });
        const vis = !!ghost && ghost.visible && project(ghost.joints['left_wrist_yaw_joint'], buf);
        ghostNode.style.transform = 'translate(' + buf.x.toFixed(1) + 'px,' + buf.y.toFixed(1) + 'px)';
        ghostNode.style.opacity = vis ? '1' : '0';
      }
    };
    const overlayEl = demo.querySelector('[data-gcarm-overlay]');
    const posBuf = {};
    const project = (obj, out) => {
      if (!obj || !camera || !renderer) return false;
      const THREE = THREE_NS;
      const v = new THREE.Vector3();
      obj.getWorldPosition(v);
      v.project(camera);
      const w = renderer.domElement.clientWidth;
      const h = renderer.domElement.clientHeight;
      out.x = (v.x * 0.5 + 0.5) * w;
      out.y = (-v.y * 0.5 + 0.5) * h;
      out.visible = v.z > -1 && v.z < 1;
      return out.visible;
    };

    // 每帧只跑一条 rAF（由 visible-raf 统一调度）：先推进关节动画，再渲染一帧。
    // 元素滚出视口或标签页切到后台时整条循环自动暂停，回来自动续。
    const frameStep = () => {
      if (disposed) return;
      const step = reducedMotion() ? 1 : 0.16;
      let moving = false;
      for (let i = 0; i < live.length; i += 1) {
        const d = desired[i] - live[i];
        if (Math.abs(d) > 1e-4) { live[i] += d * step; moving = true; } else { live[i] = desired[i]; }
      }
      if (robot && (moving || dirty || ghostDirty)) {
        applyJoints(robot, live);
        if (ghost) {
          // 幽灵臂必须停在“当前目标姿态”：只在加载时设一次的话，
          // 拖动滑块后再关补偿，会看到一条姿态对不上的手臂
          if (ghostDirty) { applyJoints(ghost, target); ghostDirty = false; }
          ghost.visible = !compOn;
        }
        updateReadout();
        dirty = false;
      } else if (robot && ghost) {
        ghost.visible = !compOn;
      }
      if (!renderer || !scene || !camera) return;
      if (controls) controls.update();
      renderer.render(scene, camera);
      demo.dataset.rendered = 'true';
      syncOverlay();
    };

    const resolveCssColor = (expr, fallback) => {
      if (!THREE_NS) return null;
      if (!probe) { probe = document.createElement("span"); probe.setAttribute("aria-hidden", "true"); probe.style.cssText = "position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;"; demo.appendChild(probe); }
      let computed = "";
      try { probe.style.color = ""; probe.style.color = expr; computed = (getComputedStyle(probe).color || "").trim(); } catch { computed = ""; }
      if (!/^(rgb|rgba|hsl|hsla)\(/i.test(computed) && !/^#[0-9a-f]{3,8}$/i.test(computed)) computed = fallback || "";
      try { return computed ? new THREE_NS.Color(computed) : null; } catch { return fallback ? new THREE_NS.Color(fallback) : null; }
    };

    const buildGrid = () => {
      if (!THREE_NS || !scene) return;
      if (grid) { scene.remove(grid); grid.geometry.dispose(); grid.material.dispose(); }
      const THREE = THREE_NS;
      const c1 = resolveCssColor('var(--sl-color-gray-3)', '#888c96');
      const c2 = resolveCssColor('var(--sl-color-gray-5)', '#555962');
      grid = new THREE.GridHelper(1.2, 12, c1 || 0x888c96, c2 || 0x555962);
      grid.material.transparent = true;
      grid.material.opacity = 0.4;
      scene.add(grid);
    };
    const applyTheme = () => { if (!scene) return; buildGrid(); scheduleRender(); };

    // ── 自检：屏幕几何与手算力矩必须与 URDF 一致 ────────────────────────────
    const verifyPhysics = () => {
      const errs = [];
      if (!robot || !torsoLink) { demo.dataset.selfcheck = "robot 未加载"; return errs; }
      const THREE = THREE_NS;
      const { joints } = fk(CHAIN.map((c) => c.def * D2R));
      [["left_shoulder_pitch_joint", "sp"], ["left_elbow_joint", "el"], ["left_wrist_yaw_joint", "wr"]].forEach((pair) => {
        const jnt = robot.joints[pair[0]];
        if (!jnt) { errs.push(pair[0] + " 缺失"); return; }
        const lp = joints[pair[0]].p;
        const local = new THREE.Vector3(lp[0], lp[2], -lp[1]);
        torsoLink.updateMatrixWorld(true);
        const expect = torsoLink.localToWorld(local.clone());
        const got = new THREE.Vector3();
        jnt.getWorldPosition(got);
        const derr = expect.distanceTo(got);
        demo.dataset["err" + pair[1]] = derr.toFixed(5);
        if (derr > 5e-3) errs.push(pair[0] + " 位置偏差 " + derr.toFixed(4) + " m");
      });
      const G = gravityTorques(CHAIN.map((c) => c.def * D2R));
      const g0 = G.left_shoulder_pitch_joint;
      demo.dataset.tauShoulder = g0.toFixed(3);
      if (!(Math.abs(g0) > 0.5 && Math.abs(g0) < 4)) errs.push("肩 pitch 力矩异常 " + g0.toFixed(3));
      demo.dataset.selfcheck = errs.length ? errs.join("; ") : "ok";
      if (errs.length) console.warn("[gcarm] 自检:", errs.join("; "));
      return errs;
    };

    const applyJoints = (obj, q) => {
      if (!obj) return;
      CHAIN.forEach((c, i) => obj.setJointValue(c.name, q[i]));
      obj.updateMatrixWorld(true);
    };
    const applyGhostMaterial = () => {
      ghost.traverse((o) => {
        if (o.isMesh) {
          o.renderOrder = -1;
          o.material = o.material.clone();
          o.material.transparent = true;
          o.material.opacity = 0.34;
          o.material.depthWrite = false;
        }
      });
    };
    const fitCamera = () => {
      if (!camera || !controls || !robot || !THREE_NS) return;
      const THREE = THREE_NS;
      const box = new THREE.Box3();
      ARM_LINKS.forEach((n) => { if (robot.links[n]) box.expandByObject(robot.links[n]); });
      if (box.isEmpty()) return;
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const radius = Math.max(size.x, size.y, size.z, 0.18) * 0.62;
      const dist = radius / Math.tan((camera.fov * Math.PI) / 360);
      controls.target.copy(center);
      camera.near = Math.max(dist / 100, 0.005);
      camera.far = dist * 50;
      camera.position.set(center.x + dist * 0.9, center.y + dist * 0.35, center.z + dist * 1.15);
      camera.updateProjectionMatrix();
      controls.update();
      scheduleRender();
    };
    const resize = () => {
      if (!renderer || !camera) return;
      const w = Math.max(viewport.clientWidth, 1);
      const h = Math.max(viewport.clientHeight, 1);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.setSize(w, h, false);
      scheduleRender();
    };

    // ── 读数：KaTeX 由 4.1 节的 tex.js 渲染 ─────────────────────────────────
    const setParts = (el, parts) => {
      if (!el) return;
      el.innerHTML = texParts(parts);
    };
    const updateReadout = () => {
      const G = gravityTorques(target);
      const wTarget = fk(target).links[WRIST_LINK].p;
      const wActual = fk(live).links[WRIST_LINK].p;
      const err = Math.hypot(wTarget[0] - wActual[0], wTarget[1] - wActual[1], wTarget[2] - wActual[2]);
      const compParts = [{ text: "需电机承担的重力力矩（正负号表示方向）：" }];
      CHAIN.filter((c) => c.movable).forEach((c, i) => {
        if (i) compParts.push({ text: "　" });
        compParts.push({ text: c.label + " " });
        compParts.push({ tex: fmt1(G[c.name]) + "\\ \\text{N·m}" });
      });
      const sagParts = [{ text: compOn ? "实际角 = 目标角（补偿把重力力矩全包了）：" : "实际角（偏差 Δ = −τ_g/K_p）：" }];
      CHAIN.filter((c) => c.movable).forEach((c, i) => {
        if (i) sagParts.push({ text: "　" });
        const idx = CHAIN.indexOf(c);
        const dev = (live[idx] - target[idx]) * R2D;
        sagParts.push({ text: c.label + " " });
        sagParts.push({ tex: fmt1(live[idx] * R2D) + "^\\circ" + (compOn ? "" : "(\\Delta " + fmt1(dev) + "^\\circ)") });
      });
      const errParts = [{ text: "手端位置差 |Δp| = " }, { tex: fmt2(err * 100) + "\\ \\text{cm}" }];
      setParts(tex.comp, compParts);
      setParts(tex.sag, sagParts);
      setParts(tex.err, errParts);
      if (modeEl) modeEl.textContent = '重力补偿：' + (compOn ? '开' : '关');
      if (modeEl) modeEl.classList.toggle('gcarm-mode-off', !compOn);
      if (tqShoulder) tqShoulder.textContent = fmt1(G.left_shoulder_pitch_joint) + ' N·m';
      if (tqElbow) tqElbow.textContent = fmt1(G.left_elbow_joint) + ' N·m';
      CHAIN.filter((c) => c.movable).forEach((c) => {
        const node = vals[c.key];
        if (node) node.textContent = fmt1(target[CHAIN.indexOf(c)] * R2D) + "°";
      });
    };

    const load = async () => {
      try {
        setState('loading', '加载 Three.js 与 URDF 解析器');
        const mods = await Promise.all([
          import("three"),
          import("three/examples/jsm/controls/OrbitControls.js"),
          import("urdf-loader"),
        ]);
        if (disposed) return;
        const THREE = mods[0];
        const OrbitControls = mods[1].OrbitControls;
        const URDFLoader = mods[2].default;
        THREE_NS = THREE;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(38, 1, 0.005, 50);
        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.setClearColor(0x000000, 0);
        renderer.domElement.style.touchAction = "none";
        viewport.appendChild(renderer.domElement);

        scene.add(new THREE.HemisphereLight(0xffffff, 0x46505f, 2.3));
        const key = new THREE.DirectionalLight(0xffffff, 2.4);
        key.position.set(2.5, 4, 3);
        const fill = new THREE.DirectionalLight(0xbdd7ff, 0.9);
        fill.position.set(-3, 1.5, -2);
        scene.add(key, fill);

        controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.09;
        controls.minDistance = 0.25;
        controls.maxDistance = 3.2;
        controls.addEventListener("change", scheduleRender);
        controls.listenToKeyEvents(viewport);

        const manager = new THREE.LoadingManager();
        let resolveRes = () => {};
        const resReady = new Promise((res) => { resolveRes = res; });
        manager.onProgress = (_u, loaded, total) => {
          setState("loading", total > 0 ? "加载模型网格 " + loaded + "/" + total : "加载模型网格");
          if (total > 0 && loaded >= total) resolveRes();
        };
        manager.onLoad = () => { resolveRes(); scheduleRender(); };
        manager.onError = (u) => console.warn("G1 网格加载失败：" + u);

        const loader = new URDFLoader(manager);
        loader.workingPath = urdfUrl.slice(0, urdfUrl.lastIndexOf("/") + 1);
        loader.fetchOptions = { cache: "force-cache" };

        setState('loading', '解析 URDF 结构');
        robot = await loader.loadAsync(urdfUrl);
        if (disposed) return;
        ghost = await loader.loadAsync(urdfUrl);
        if (disposed) return;
        robot.rotation.x = -Math.PI / 2;
        ghost.rotation.x = -Math.PI / 2;
        Object.keys(robot.links).forEach((n) => { if (robot.links[n]) robot.links[n].visible = PIN.has(n); });
        Object.keys(ghost.links).forEach((n) => { if (ghost.links[n]) ghost.links[n].visible = PIN.has(n); });
        ghost.position.y += 0.018;
        applyGhostMaterial();
        modelGroup = new THREE.Group();
        modelGroup.add(robot, ghost);
        scene.add(modelGroup);
        torsoLink = robot.links[TORSO_LINK];
        robot.updateMatrixWorld(true);
        ghost.updateMatrixWorld(true);

        const startTorso = new THREE.Vector3();
        if (torsoLink) torsoLink.getWorldPosition(startTorso);
        buildGrid();
        if (grid) grid.position.y = startTorso.y - 0.02;

        await Promise.race([resReady, new Promise((res) => setTimeout(res, 4000))]);
        if (disposed) return;

        applyJoints(robot, live);
        applyJoints(ghost, target);
        verifyPhysics();

        resizeObserver = new ResizeObserver(resize);
        resizeObserver.observe(viewport);
        themeObserver = new MutationObserver(applyTheme);
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
        if (window.matchMedia) {
          mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
          mediaQuery.addEventListener("change", applyTheme);
        }

        if (resetBtn instanceof HTMLButtonElement) { resetBtn.disabled = false; resetBtn.addEventListener("click", fitCamera); }
        setState("ready", "");
        resize();
        fitCamera();
        updateReadout();
        dirty = true;
        if (loop) loop.start(); // 连续渲染：离屏自动暂停，回来自动续
        scheduleRender();
      } catch (error) {
        console.error("G1 左臂重力补偿演示加载失败：", error);
        setState("error", "模型加载失败，请检查网络或资源路径");
        disposeAll();
      }
    };

    CHAIN.filter((c) => c.movable).forEach((c) => {
      const el = ranges[c.key];
      if (!(el instanceof HTMLInputElement)) return;
      el.addEventListener("input", () => {
        target[CHAIN.indexOf(c)] = Number(el.value) * D2R;
        ghostDirty = true;
        recompute();
        updateReadout();
        scheduleRender();
      });
    });
    toggleBtn.addEventListener("click", () => {
      compOn = !compOn;
      toggleBtn.textContent = '重力补偿：' + (compOn ? '开' : '关');
      toggleBtn.classList.toggle('gcarm-btn-off', !compOn);
      recompute();
      updateReadout();
      dirty = true;
      scheduleRender();
    });

    // 失败路径也要把 WebGL 上下文、观察者与监听还回去（旧实现只清状态文案）
    const disposeAll = () => {
      if (disposed) return;
      disposed = true;
      if (loop) loop.dispose();
      if (resizeObserver) resizeObserver.disconnect();
      if (themeObserver) themeObserver.disconnect();
      if (mediaQuery) mediaQuery.removeEventListener("change", applyTheme);
      if (controls) controls.dispose();
      if (renderer) { renderer.dispose(); renderer.domElement.remove(); }
      renderer = null;
    };

    const start = () => {
      if (started || disposed) return;
      started = true;
      load();
    };
    // 唯一的观察者与 visibilitychange 由 visible-raf 统一持有：
    // 进视口才加载模型，离屏即停渲染，回来自动续（不再各自 observe）。
    loop = createVisibleRaf(demo, { rootMargin: '240px', onEnter: () => start() });
    loop.onFrame(frameStep);
  });
})();
</script>

<style is:global>
  .gcarm-demo { margin: 1.5rem 0; }
  .gcarm-viewport { position: relative; overflow: hidden; width: 100%; min-height: 420px; aspect-ratio: 16 / 10; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; background: var(--sl-color-gray-7, var(--sl-color-gray-6)); }
  .gcarm-viewport canvas { position: absolute; inset: 0; display: block; width: 100% !important; height: 100% !important; touch-action: none; }
  .gcarm-loading { position: absolute; inset: 0; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 0.7rem; padding: 1rem; color: var(--sl-color-gray-2); font-size: 0.9375rem; text-align: center; }
  .gcarm-demo[data-state='ready'] .gcarm-loading { display: none; }
  .gcarm-spinner { flex: 0 0 auto; width: 1.15rem; height: 1.15rem; border: 2px solid var(--sl-color-gray-4); border-top-color: var(--sl-color-accent); border-radius: 50%; animation: gcarm-spin 0.9s linear infinite; }
  .gcarm-demo[data-state='error'] .gcarm-spinner { display: none; }
  .gcarm-demo[data-state='error'] .gcarm-status { color: var(--sl-color-danger, #dc2626); }

  .gcarm-overlay { position: absolute; inset: 0; pointer-events: none; }
  .gcarm-tag { position: absolute; top: 0; left: 0; padding: 0.05rem 0.3rem; border-radius: 5px; background: color-mix(in srgb, var(--sl-color-bg) 78%, transparent); color: var(--sl-color-accent); font-size: 0.8125rem; font-weight: 700; white-space: nowrap; transition: opacity 0.15s linear; }
  .gcarm-tag-target { padding: 0.05rem 0.35rem; border-style: dashed; border-color: var(--sl-color-orange, #ea580c); color: var(--sl-color-orange, #ea580c); white-space: nowrap; }
  .gcarm-torques { position: absolute; left: 0.65rem; top: 0.65rem; min-width: 8.5rem; padding: 0.4rem 0.55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; background: color-mix(in srgb, var(--sl-color-bg) 88%, transparent); font-size: 0.75rem; line-height: 1.45; }
  .gcarm-mode { position: absolute; right: 0.65rem; top: 0.65rem; padding: 0.15rem 0.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; background: color-mix(in srgb, var(--sl-color-bg) 86%, transparent); color: var(--sl-color-accent); font-size: 0.75rem; }
  .gcarm-mode.gcarm-mode-off { border-color: var(--sl-color-orange, #ea580c); color: var(--sl-color-orange, #ea580c); }

  .gcarm-controls { display: flex; flex-direction: column; gap: 0.5rem; max-width: 900px; margin: 0.6rem auto 0; }
  .gcarm-row { display: flex; align-items: center; gap: 0.7rem; margin: 0; flex-wrap: wrap; }
  .gcarm-row-btns { gap: 0; }
  .gcarm-btnpair { display: grid; grid-auto-flow: column; grid-auto-columns: 10.5rem; align-items: stretch; justify-content: start; gap: 0.7rem; margin-left: 0.7rem; }
  .gcarm-tq-title { color: var(--sl-color-gray-2); margin-bottom: 0.1rem; }
  .gcarm-tq-row { display: flex; justify-content: space-between; gap: 0.6rem; color: var(--sl-color-gray-2); }
  .gcarm-tq-row b { color: var(--sl-color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .gcarm-row-title { flex: 0 0 3.4rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.8125rem; }
  .gcarm-hint { margin: 0; color: var(--sl-color-gray-3); font-size: 0.75rem; }
  .gcarm-slider-label { display: flex; flex: 1 1 8.5rem; min-width: 0; align-items: center; gap: 0.35rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.8125rem; white-space: nowrap; }
