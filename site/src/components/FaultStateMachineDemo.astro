---
const urdfUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'models/g1/g1_29dof.urdf';
---

<figure class="recovery-demo" id="g1-fault-recovery-demo" data-fault-recovery data-urdf={urdfUrl}>
  <header class="fr-heading">
    <div><h4>故障消失了，G1 为什么还不动？</h4><p>让左臂抬起来，再试一次保护与恢复。</p></div>
    <button type="button" class="fr-text-button" data-action="reset">重置演示</button>
  </header>
  <ol class="fr-steps" aria-label="保护与恢复的四个阶段">
    <li data-step="0"><span>1</span>抬臂运行</li>
    <li data-step="1"><span>2</span>保护锁存</li>
    <li data-step="2"><span>3</span>确认检查</li>
    <li data-step="3"><span>4</span>单独启动</li>
  </ol>
  <div class="fr-scene">
    <div class="fr-model-pane">
      <div class="fr-model" data-arm-view role="group" aria-label="G1 左臂教学模型：前臂由电机保持姿态。">
        <div class="fr-loading" data-loading role="status"><span data-loading-text>正在加载 G1 左臂…</span><button type="button" class="fr-text-button" data-retry hidden>重新加载模型</button></div>
        <div class="fr-view-caption"><span>G1 左臂</span><span data-target-note>浅色轮廓：目标位置</span></div>
        <button type="button" class="fr-camera fr-text-button" data-camera disabled>还原视角</button>
        <div class="fr-power"><i aria-hidden="true"></i><span data-power>动力保留 · 电机保持姿态</span></div>
      </div>
      <div class="fr-view-tools">
        <span>拖动可旋转视角</span>
        <button type="button" class="fr-text-button" data-pause disabled>暂停演示</button>
        <button type="button" class="fr-text-button" data-step-time hidden>单步观察</button>
      </div>
    </div>
    <div class="fr-panel">
      <div class="fr-status"><span data-state-label>待命</span><span class="fr-angle" data-angle aria-live="off">20°</span></div>
      <dl class="fr-signals">
        <div><dt>故障信号</dt><dd data-fault>无</dd></div>
        <div><dt>运动许可</dt><dd data-permit>等待启动</dd></div>
      </dl>
      <p class="fr-story" data-story role="status" aria-live="polite">点击“开始抬臂”，在运动途中触发保护。</p>
      <div class="fr-actions" role="group" aria-label="体验保护与恢复">
        <button type="button" class="fr-start" data-action="start">开始抬臂</button>
        <button type="button" class="fr-trip" data-action="trip" disabled>触发保护</button>
        <button type="button" data-action="clear" disabled>排除故障</button>
        <button type="button" data-action="check" disabled>确认并检查</button>
      </div>
      <div class="fr-compare"><span>可选对照</span><button type="button" class="fr-text-button" data-limit disabled>限制速度</button><span data-limit-note>限制后仍可运动</span></div>
    </div>
  </div>
  <details class="fr-details">
    <summary>查看状态细节</summary>
    <p>本例从已完成上电和自检的待命状态开始：待命（SAFE_IDLE）→ 启动与运行（ENABLED / RUNNING）→ 故障锁存（FAULT_LATCHED）→ 恢复检查（RECOVERY）→ 待命。初次上电的 OFF、INIT、SELF_TEST 省略在动效之外；限速对照对应降级运行（DEGRADED）。</p>
    <p>恢复检查会读取当前关节状态、清理旧的运动目标。检查通过只解除运动禁令；再次点击启动后，才从当前位置生成新的抬臂动作。“重置演示”仅用于重放这个例子。</p>
  </details>
  <figcaption>用 G1 的 URDF 模型演示运动许可：保护后仍由电机保持姿态。流程与时间为教学示例，不代表 G1 固件的保护或急停策略。</figcaption>
  <noscript><p class="fr-no-script">交互需要启用 JavaScript。故障信号消失后，保护仍保持锁存；检查通过先回到待命，另行启动才恢复运动。</p></noscript>
</figure>

<script>
  import { createVisibleRaf } from '../lib/visible-raf.js';
  import { createFaultRecoveryState, actFaultRecovery, stepFaultRecovery, faultRecoverySnapshot } from '../lib/fault-recovery-model.js';

  document.querySelectorAll<HTMLElement>('[data-fault-recovery]').forEach((demo) => {
    if (demo.dataset.initialized) return;
    demo.dataset.initialized = 'true';
    const el = (selector: string) => demo.querySelector<HTMLElement>(selector)!;
    const button = (selector: string) => demo.querySelector<HTMLButtonElement>(selector)!;
    const text = (selector: string, value: string) => { const node = el(selector); if (node.textContent !== value) node.textContent = value; };
    const viewport = el('[data-arm-view]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const events = new AbortController();
    const on = (target: EventTarget, name: string, handler: EventListener) => target.addEventListener(name, handler, { signal: events.signal });
    let state = createFaultRecoveryState();
    let view: any, loading = false, failed = false, disposed = false, last = 0, paused = reduced.matches;
    const active = () => ['running', 'degraded', 'stopping', 'checking'].includes(state.phase);
    const loop = createVisibleRaf(demo, { onEnter: () => { last = 0; void loadArm(); } });

    async function loadArm(retry = false) {
      if (disposed || view || loading || (failed && !retry)) return;
      loading = true; failed = false;
      el('[data-loading]').hidden = false; el('[data-retry]').hidden = true;
      text('[data-loading-text]', '正在加载 G1 左臂…');
      try {
        const { createG1ArmView } = await import('../lib/g1-arm-view.js');
        if (disposed) return;
        const next = await createG1ArmView(viewport, { urdfUrl: demo.dataset.urdf, profile: 'safety', onInvalidate: () => { if (!disposed) loop.schedule(); } });
        if (disposed) { next.dispose(); return; }
        view = next;
        el('[data-loading]').hidden = true;
        button('[data-camera]').disabled = false;
        render(); loop.schedule();
      } catch (error) {
        if (disposed) return;
        failed = true;
        text('[data-loading-text]', '模型暂时无法显示，仍可用右侧按钮观察保护流程。');
        el('[data-retry]').hidden = false;
        console.error('G1 故障恢复演示加载失败：', error);
      } finally { loading = false; }
    }

    function render() {
      const snap = faultRecoverySnapshot(state);
      const phase = state.phase;
      const locked = ['stopping', 'latched', 'checking'].includes(phase);
      const moving = ['running', 'degraded'].includes(phase);
      const status = locked ? 'fault' : state.limited ? 'limited' : moving ? 'normal' : 'ready';
      const stage = locked ? phase === 'checking' ? 2 : 1 : state.checked ? 3 : moving || phase === 'complete' ? 0 : -1;
      demo.dataset.phase = phase; demo.dataset.fault = String(state.faultPresent); demo.dataset.limited = String(state.limited);
      demo.dataset.angle = String(state.angle); demo.dataset.paused = String(paused); demo.dataset.checked = String(state.checked);
      demo.dataset.status = status;
      for (const node of demo.querySelectorAll<HTMLElement>('[data-step]')) {
        const current = Number(node.dataset.step) === stage;
        node.dataset.active = String(current);
        if (current) node.setAttribute('aria-current', 'step'); else node.removeAttribute('aria-current');
      }
      text('[data-state-label]', snap.stateLabel);
      text('[data-angle]', `${Math.round(snap.angleDegrees)}°`);
      text('[data-fault]', state.faultPresent ? '存在' : locked ? '已消失' : '无');
      text('[data-permit]', locked ? '禁止运动' : moving ? state.limited ? '允许 · 已限速' : '允许' : phase === 'complete' ? '动作完成' : '等待启动');
      text('[data-story]', snap.story);
      text('[data-power]', moving || phase === 'stopping' ? '动力保留 · 电机出力' : '动力保留 · 电机保持姿态');
      text('[data-target-note]', state.checked && phase === 'ready' ? '旧目标已清理 · 等待新指令' : state.checked ? '浅色轮廓：重新下发的目标' : '浅色轮廓：目标位置');
      text('[data-action="start"]', locked ? '尝试继续抬臂' : state.checked ? '启动抬臂' : '开始抬臂');
      button('[data-action="start"]').disabled = !snap.canStart;
      button('[data-action="trip"]').disabled = !snap.canTrip;
      button('[data-action="clear"]').disabled = !snap.canClear;
      button('[data-action="check"]').disabled = !snap.canCheck;
      button('[data-limit]').disabled = state.limited ? !snap.canUnlimit : !snap.canLimit;
      button('[data-limit]').setAttribute('aria-pressed', String(state.limited));
      text('[data-limit]', state.limited ? '恢复速度' : '限制速度');
      text('[data-limit-note]', state.limited ? '降级运行 · 仍允许运动' : '限制后仍可运动');
      button('[data-pause]').disabled = !active();
      button('[data-pause]').hidden = reduced.matches;
      text('[data-pause]', paused ? '继续演示' : '暂停演示');
      button('[data-pause]').setAttribute('aria-pressed', String(paused));
      button('[data-step-time]').hidden = !reduced.matches;
      button('[data-step-time]').disabled = !active();
      viewport.setAttribute('aria-label', `G1 左臂：${snap.stateLabel}，前臂抬起约 ${Math.round(snap.angleDegrees)} 度。动力保留。`);
      view?.update({ angle: state.angle, target: state.target, payload: false, pushing: false, status, showTarget: !(state.checked && phase === 'ready') });
      view?.render();
    }

    function schedule() {
      last = 0;
      if (active() && !paused) loop.start(); else { loop.stop(); loop.schedule(); }
    }
    function dispatch(action: string) {
      const before = state.phase;
      state = actFaultRecovery(state, action);
      if (action === 'reset') paused = reduced.matches;
      else if (state.phase !== before && active()) paused = reduced.matches;
      render(); schedule();
    }
    loop.onFrame((now: number) => {
      const dt = last ? Math.min(Math.max(0, (now - last) / 1000), .05) : 0;
      last = now;
      if (!paused && active()) state = stepFaultRecovery(state, dt);
      render();
      return active() && !paused;
    });
    for (const node of demo.querySelectorAll<HTMLElement>('[data-action]')) on(node, 'click', () => dispatch(node.dataset.action!));
    on(button('[data-limit]'), 'click', () => dispatch(state.limited ? 'unlimit' : 'limit'));
    on(button('[data-pause]'), 'click', () => { paused = !paused; render(); schedule(); });
    on(button('[data-step-time]'), 'click', () => { state = stepFaultRecovery(state, .75); render(); loop.schedule(); });
    on(button('[data-camera]'), 'click', () => view?.resetCamera());
    on(button('[data-retry]'), 'click', () => { void loadArm(true); });
    on(reduced, 'change', () => { paused = true; render(); schedule(); });
    on(document, 'visibilitychange', () => { last = 0; });
    const dispose = () => {
      if (disposed) return;
      disposed = true; events.abort(); loop.dispose(); view?.dispose(); view = null;
    };
    on(document, 'astro:before-swap', dispose);
    on(window, 'pagehide', ((event: PageTransitionEvent) => { if (!event.persisted) dispose(); }) as EventListener);
    render(); loop.schedule();
  });
</script>

<style>
  .recovery-demo { --fr-green: #237546; --fr-yellow: #8e650e; --fr-red: #b53846; margin: 1.5rem 0; border: 1px solid var(--sl-color-gray-5); border-radius: 14px; background: var(--sl-color-bg); overflow: hidden; scroll-margin-top: 8rem; }
  :global([data-theme='dark']) .recovery-demo { --fr-green: #8bd5a8; --fr-yellow: #ebc871; --fr-red: #ff98a2; }
  .recovery-demo :global(*) { box-sizing: border-box; }
  .recovery-demo :where(p, h4, ol, li, dl, dt, dd, button, div, span) { margin: 0; }
  .fr-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; padding: .9rem 1rem .7rem; }
  .fr-heading h4 { font-size: 1.07rem; line-height: 1.45; }
  .fr-heading p { margin-top: .25rem; font-size: .76rem; color: var(--sl-color-gray-2); }
  .fr-text-button { border: 0; padding: .2rem .15rem; background: transparent; color: var(--sl-color-text-accent); font: inherit; font-size: .7rem; cursor: pointer; }
  .fr-heading > button { flex-shrink: 0; }
  .fr-steps { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .3rem; padding: 0 1rem .7rem; }
  .fr-steps li { display: flex; align-items: center; justify-content: center; gap: .3rem; padding: .38rem .1rem; border-radius: 6px; background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); font-size: .69rem; line-height: 1.4; }
  .fr-steps span { font-variant-numeric: tabular-nums; opacity: .65; }
  .fr-steps [data-active='true'] { color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); font-weight: 600; }
  .fr-scene { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: .85rem; padding: 0 1rem .7rem; }
  .fr-model-pane { min-width: 0; }
  .fr-model { position: relative; height: 295px; overflow: hidden; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; background: radial-gradient(ellipse at 50% 45%, var(--sl-color-bg), var(--sl-color-gray-6)); }
  .fr-model :global(canvas) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .fr-view-caption { position: absolute; left: .5rem; top: .5rem; z-index: 2; pointer-events: none; font-size: .62rem; line-height: 1.7; color: var(--sl-color-gray-2); }
  .fr-view-caption > span { display: block; }
  .fr-view-caption > span:first-child { font-size: .71rem; font-weight: 600; color: var(--sl-color-text); }
  .fr-camera { position: absolute; top: .45rem; right: .4rem; z-index: 2; padding: .15rem .25rem; background: color-mix(in srgb, var(--sl-color-bg) 90%, transparent); font-size: .61rem; border-radius: 4px; }
  .fr-power { display: flex; align-items: center; justify-content: center; gap: .35rem; position: absolute; bottom: .5rem; left: .45rem; right: .45rem; z-index: 2; padding: .3rem; border-radius: 5px; background: color-mix(in srgb, var(--sl-color-bg) 92%, transparent); color: var(--sl-color-gray-2); font-size: .63rem; line-height: 1.4; pointer-events: none; }
  .fr-power i { width: 6px; height: 6px; border-radius: 50%; background: var(--fr-green); }
  .fr-view-tools { display: flex; align-items: center; justify-content: space-between; gap: .3rem; margin-top: .3rem; font-size: .61rem; color: var(--sl-color-gray-3); }
  .fr-view-tools button { font-size: .63rem; }
  .fr-loading { position: absolute; inset: 0; z-index: 4; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: .5rem; padding: 1rem; text-align: center; background: var(--sl-color-bg); font-size: .76rem; color: var(--sl-color-gray-2); }
  .fr-panel { display: flex; flex-direction: column; min-width: 0; }
  .fr-status { display: flex; justify-content: space-between; align-items: baseline; gap: .35rem; font-size: .91rem; font-weight: 650; padding: .2rem 0 .45rem; }
  .fr-angle { font-size: .8rem; font-weight: 400; font-variant-numeric: tabular-nums; color: var(--sl-color-gray-2); }
  .fr-signals { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .fr-signals div { border: 1px solid var(--sl-color-gray-5); border-radius: 6px; padding: .35rem .5rem; }
  .fr-signals dt { font-size: .61rem; color: var(--sl-color-gray-2); }
  .fr-signals dd { font-size: .75rem; margin-top: .2rem; line-height: 1.4; }
  .fr-story { margin-top: .55rem; min-height: 5.1em; padding: .5rem .6rem; border-left: 3px solid var(--sl-color-accent); background: var(--sl-color-accent-low); font-size: .76rem; line-height: 1.65; }
  [data-status='fault'] .fr-status { color: var(--fr-red); }
  [data-status='fault'] .fr-story { border-color: var(--fr-red); background: color-mix(in srgb, var(--fr-red) 7%, var(--sl-color-bg)); }
  [data-status='limited'] .fr-status { color: var(--fr-yellow); }
  [data-fault='true'] [data-fault] { color: var(--fr-red); }
  .fr-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; margin-top: .65rem; }
  .fr-actions button { border: 1px solid var(--sl-color-gray-4); border-radius: 6px; padding: .45rem .25rem; min-height: 36px; color: var(--sl-color-text); background: var(--sl-color-bg); font: inherit; font-size: .7rem; line-height: 1.35; cursor: pointer; }
  .fr-actions .fr-start { border-color: var(--sl-color-accent); color: var(--sl-color-text-accent); background: var(--sl-color-accent-low); }
  .fr-actions .fr-trip:not(:disabled) { border-color: var(--fr-red); color: var(--fr-red); }
  .recovery-demo button:disabled { opacity: .4; cursor: default; }
  .recovery-demo button:focus-visible, .recovery-demo summary:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .fr-compare { display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .45rem; margin-top: .5rem; color: var(--sl-color-gray-2); font-size: .6rem; }
  .fr-compare button { font-size: .65rem; }
  .fr-details { border-top: 1px solid var(--sl-color-gray-5); padding: .55rem 1rem; margin: 0; font-size: .7rem; color: var(--sl-color-gray-2); }
  .fr-details summary { cursor: pointer; font-size: .71rem; }
  .fr-details p { margin-top: .45rem; line-height: 1.65; }
  .recovery-demo figcaption { padding: .5rem 1rem .7rem; font-size: .63rem; line-height: 1.65; color: var(--sl-color-gray-2); }
  .fr-no-script { padding: .7rem 1rem; }
  .recovery-demo [hidden] { display: none !important; }
  @media (max-width: 580px) {
    .fr-heading { padding: .8rem .75rem .65rem; }
    .fr-heading h4 { font-size: .98rem; }
    .fr-steps { padding-inline: .75rem; gap: .2rem; }
    .fr-steps li { font-size: .63rem; gap: .15rem; }
    .fr-scene { grid-template-columns: 1fr; padding-inline: .75rem; gap: .4rem; }
    .fr-model { height: 225px; }
    .fr-model-pane { position: relative; }
    .fr-view-tools { font-size: .6rem; }
    .fr-status { padding-top: 0; }
    .fr-signals div { display: flex; gap: .35rem; align-items: baseline; padding: .3rem .45rem; }
    .fr-signals dd { margin-top: 0; }
    .fr-story { min-height: 3.4em; margin-top: .45rem; }
    .fr-actions { margin-top: .5rem; }
    .fr-actions button { min-height: 40px; font-size: .75rem; }
    .fr-details, .recovery-demo figcaption { padding-inline: .75rem; }
  }
</style>
