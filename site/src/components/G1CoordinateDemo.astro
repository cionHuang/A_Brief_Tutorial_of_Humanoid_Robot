---
import '../styles/math-lessons.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/,'/');
---
<figure class="math-lesson g1-coordinate-demo" id="g1-coordinate-demo" data-g1-coordinate data-urdf={`${base}models/g1/g1_29dof.urdf`}>
  <header><h4>G1 的“向前”，以谁为准？</h4><p>先换坐标表达，再改变位姿，最后比较同一条指令的两种结果。</p></header>
  <div class="ml-tabs" role="group" aria-label="选择坐标教学步骤">
    <button type="button" data-step="1" id="g1-coordinate-step-1" aria-pressed="true">1 · 换坐标看</button>
    <button type="button" data-step="2" id="g1-coordinate-step-2" aria-pressed="false">2 · 改位置朝向</button>
    <button type="button" data-step="3" id="g1-coordinate-step-3" aria-pressed="false">3 · 按谁的轴动</button>
  </div>
  <div class="gc-layout">
    <div class="gc-model-pane">
      <div class="gc-viewport" data-coordinate-view role="img" aria-label="G1 模型与世界、骨盆坐标系">
        <span class="gc-label" data-coordinate-label="world" hidden>世界 W</span><span class="gc-label" data-coordinate-label="body" hidden>骨盆 P</span><span class="gc-label gc-point-label" data-coordinate-label="point" hidden>左脚上的点</span>
        <div class="gc-loading" data-loading role="status"><span data-loading-text>正在加载 G1…</span><button type="button" data-retry hidden>重新加载</button></div>
      </div>
      <div class="gc-tools"><span data-legend>x 红 · y 绿 · z 蓝</span><button type="button" data-camera>还原视角</button></div>
    </div>
    <div class="gc-panel">
      <h5 data-question>同一个点，为什么有两组坐标？</h5>
      <div data-panel="1">
        <div class="ml-controls" role="group" aria-label="选择坐标读数的参考系"><button type="button" data-frame="world" aria-pressed="true">世界坐标</button><button type="button" data-frame="body" aria-pressed="false">骨盆坐标</button></div>
        <div class="gc-value"><span data-coordinate-name>左脚上的点 · 在世界中</span><strong data-coordinate-value>等待模型</strong><small>依次为 x、y、z，单位 m</small></div>
      </div>
      <div data-panel="2" hidden>
        <div class="ml-controls" role="group" aria-label="选择改变位置还是朝向"><button type="button" data-kind="translate" aria-pressed="true">只改位置</button><button type="button" data-kind="rotate" aria-pressed="false">只改朝向</button></div>
        <div class="ml-controls"><label><span data-amount-label>沿世界 x</span><input type="range" min="0" max="30" step="1" value="0" data-amount aria-label="沿世界 x 平移"/><output data-amount-value>0 cm</output></label></div>
        <div class="gc-blocks"><div data-rotation-block><b>R · 朝向</b><span>三根轴指向哪里</span></div><div data-position-block><b>p · 位置</b><span>原点在哪里</span></div></div>
        <p class="ml-small" data-change>移动模型时，矩阵的位置部分 p 改变。</p>
      </div>
      <div data-panel="3" hidden>
        <div class="ml-controls" role="group" aria-label="选择要执行的指令"><button type="button" data-kind="translate" aria-pressed="true">沿 x 移动 10 cm</button><button type="button" data-kind="rotate" aria-pressed="false">绕 z 转 90°</button></div>
        <div class="ml-controls" role="group" aria-label="选择指令所用的坐标系"><button type="button" data-basis="world" aria-pressed="true">按世界轴 · 左乘</button><button type="button" data-basis="body" aria-pressed="false">按自身轴 · 右乘</button></div>
        <div class="gc-targets"><div><span>紫 · 按世界轴的目标</span><b data-world-target>—</b></div><div><span>绿 · 按自身轴的目标</span><b data-body-target>—</b></div></div>
        <p class="ml-small">目标骨盆原点的 (x, y)，单位 m</p>
        <div class="ml-controls"><button type="button" data-play>播放移动</button><button type="button" data-restart>回到同一起点</button></div>
      </div>
      <p class="ml-story" data-story aria-live="polite">模型和脚上的点保持不动；只换一个坐标系来描述它。</p>
    </div>
  </div>
  <details data-matrix-details hidden><summary>查看 4 × 4 矩阵</summary><p data-matrix-caption>当前骨盆坐标系在世界中的位姿 T_WP</p><div class="gc-matrix" data-matrix aria-label="当前位姿矩阵"></div></details>
  <figcaption>使用 G1 的 URDF 模型。演示只改变整体位姿，不计算步态；紫色和绿色标记表示两种指令的目标，不是机器人将同时经过的路线。</figcaption>
  <noscript>启用 JavaScript 后可以切换三步演示。换坐标系只改变读数；左乘按世界轴施加变换，右乘按自身轴施加变换。</noscript>
</figure>
<script>
  import { composeLesson, poseMatrix, DEG } from '../lib/robot-math-demo-model.js';
  import { createG1CoordinateView } from '../lib/g1-coordinate-view.js';
  function init(){document.querySelectorAll('[data-g1-coordinate]').forEach(root=>{
    if(root.dataset.ready)return;root.dataset.ready='true';
    const q=s=>root.querySelector(s),all=s=>root.querySelectorAll(s),abort=new AbortController();
    let view,loading=false,disposed=false,visible=false,raf=0,last=0,playing=false,sample;
    const state={step:1,frame:'world',kind:'translate',amount:0,basis:'world',progress:0};
    const fmt=v=>Math.abs(v)<.0005?'0.000':v.toFixed(3),coords=p=>`(${p.map(fmt).join(', ')})`;
    function readSample(s){sample=s;const p=state.frame==='world'?s.footWorld:s.footBody;q('[data-coordinate-value]').textContent=coords(p);
      q('[data-coordinate-name]').textContent=`左脚上的点 · 在${state.frame==='world'?'世界':'骨盆'}中`;
      q('[data-coordinate-view]').setAttribute('aria-label',`G1 第 ${state.step} 步，骨盆位置 ${coords(s.pose.p)} 米，偏航角 ${(s.pose.yaw/DEG).toFixed(0)} 度`);
      const matrix=poseMatrix(s.pose);q('[data-matrix]').innerHTML=matrix.map((row,i)=>row.map((v,j)=>`<span class="${i===3?'gc-constant':j===3?'gc-p':'gc-r'}">${fmt(v)}</span>`).join('')).join('');
    }
    function schedule(){if(!disposed&&visible&&!document.hidden&&!raf)raf=requestAnimationFrame(tick);}
    function tick(time){raf=0;if(disposed||!visible||document.hidden){last=0;return;}
      if(playing){state.progress=Math.min(1,state.progress+(last?Math.min((time-last)/1400,.08):0));last=time;if(state.progress===1){playing=false;last=0;}q('[data-play]').textContent=playing?'暂停演示':'再看一次';}
      view?.render(state);root.dataset.progress=String(state.progress);if(playing)schedule();
    }
    function stop(){playing=false;last=0;state.progress=0;}
    function update(){
      root.dataset.step=String(state.step);root.dataset.kind=state.kind;root.dataset.basis=state.basis;
      all('[data-step]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.step)===state.step)));
      all('[data-panel]').forEach(p=>p.hidden=Number(p.dataset.panel)!==state.step);
      for(const key of ['frame','kind','basis'])all(`[data-${key}]`).forEach(b=>b.setAttribute('aria-pressed',String(b.dataset[key]===state[key])));
      q('[data-question]').textContent=['','同一个点，为什么有两组坐标？','位置和朝向，分别改了什么？','“向前”，是朝哪边？'][state.step];
      const rotation=state.kind==='rotate',slider=q('[data-amount]');slider.max=rotation?'90':'30';slider.value=String(state.amount);slider.setAttribute('aria-label',rotation?'改变偏航角':'沿世界 x 平移');
      q('[data-amount-label]').textContent=rotation?'改变偏航角':'沿世界 x';q('[data-amount-value]').textContent=`${state.amount}${rotation?'°':' cm'}`;
      q('[data-rotation-block]').classList.toggle('gc-active',rotation);q('[data-position-block]').classList.toggle('gc-active',!rotation);
      q('[data-change]').textContent=rotation?'原点位置不变，三根轴转向，矩阵中的 R 改变。':'朝向不变，模型平移，矩阵中的 p 改变。';
      q('[data-story]').textContent=state.step===1?'模型和脚上的点保持不动；只换一个坐标系来描述它。':state.step===2?(rotation?'只转动模型，观察朝向部分 R。位置部分 p 保持原来的值。':'只移动模型，观察位置部分 p。朝向部分 R 保持原来的值。'):rotation?(state.basis==='world'?'左乘纯旋转：绕世界原点转动，原有位置也随之旋转。':'右乘纯旋转：绕自身原点转动，骨盆原点的位置不变。'):(state.basis==='world'?'左乘平移：沿世界 x 轴前进。即使 G1 已经转身，这个方向也不变。':'右乘平移：沿 G1 当前的 x 轴前进。它面向哪里，就沿哪里移动。');
      for(const basis of ['world','body'])q(`[data-${basis}-target]`).textContent=coords(composeLesson(basis,state.kind).p.slice(0,2));
      q('[data-matrix-details]').hidden=state.step===1;q('[data-play]').textContent=rotation?'播放转动':'播放移动';
      q('[data-legend]').textContent=state.step===3?'目标：紫色按世界轴 · 绿色按自身轴':'x 红 · y 绿 · z 蓝';
      q('[data-camera]').disabled=!view;q('[data-play]').disabled=!view;
      schedule();
    }
    async function load(){if(loading||view||disposed)return;loading=true;q('[data-loading]').hidden=false;q('[data-retry]').hidden=true;q('[data-loading-text]').textContent='正在加载 G1…';
      try{const next=await createG1CoordinateView(q('[data-coordinate-view]'),{urdfUrl:root.dataset.urdf,onInvalidate:schedule,onSample:readSample});if(disposed){next.dispose();return;}view=next;q('[data-loading]').hidden=true;update();}
      catch(error){if(!disposed){q('[data-loading-text]').textContent='模型暂未加载，请重试。';q('[data-retry]').hidden=false;root.dataset.loadError='true';}}
      finally{loading=false;}
    }
    const on=(el,type,fn)=>el.addEventListener(type,fn,{signal:abort.signal});
    const chooseStep=n=>{stop();state.step=n;state.kind='translate';state.amount=0;update();};
    all('[data-step]').forEach(b=>on(b,'click',()=>chooseStep(Number(b.dataset.step))));
    all('[data-frame]').forEach(b=>on(b,'click',()=>{state.frame=b.dataset.frame;update();}));
    all('[data-kind]').forEach(b=>on(b,'click',()=>{stop();state.kind=b.dataset.kind;state.amount=0;update();}));
    all('[data-basis]').forEach(b=>on(b,'click',()=>{stop();state.basis=b.dataset.basis;update();}));
    on(q('[data-amount]'),'input',e=>{state.amount=Number(e.target.value);update();});
    on(q('[data-play]'),'click',()=>{if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){state.progress=1;playing=false;last=0;schedule();q('[data-play]').textContent='再看一次';return;}if(playing){playing=false;last=0;q('[data-play]').textContent='继续演示';}else{if(state.progress>=1)state.progress=0;playing=true;last=0;schedule();}});
    on(q('[data-restart]'),'click',()=>{stop();update();});on(q('[data-camera]'),'click',()=>view?.resetCamera());on(q('[data-retry]'),'click',load);
    const hash=()=>{const m=location.hash.match(/^#g1-coordinate-step-([123])$/);if(m)chooseStep(Number(m[1]));};on(window,'hashchange',hash);
    on(document,'visibilitychange',()=>{last=0;if(document.hidden){cancelAnimationFrame(raf);raf=0;}else schedule();});
    const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible){load();schedule();}else{cancelAnimationFrame(raf);raf=0;last=0;}},{rootMargin:'150px'});observer.observe(root);
    on(document,'astro:before-swap',()=>{disposed=true;observer.disconnect();cancelAnimationFrame(raf);view?.dispose();abort.abort();});
    update();hash();
  });}init();document.addEventListener('astro:page-load',init);
</script>
<style>
  .gc-layout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:.85rem;padding:0 1rem .9rem;}
  .gc-model-pane,.gc-panel{min-width:0;}
  .gc-viewport{height:350px;position:relative;overflow:hidden;border:1px solid var(--sl-color-gray-5);border-radius:8px;background:linear-gradient(145deg,var(--sl-color-gray-6),var(--sl-color-bg));}
  .gc-label{position:absolute;z-index:2;transform:translate(-50%,-100%);pointer-events:none;background:color-mix(in srgb,var(--sl-color-bg) 88%,transparent);border:1px solid var(--sl-color-gray-4);border-radius:4px;padding:2px 5px;font-size:.58rem;white-space:nowrap;}
  .gc-point-label{color:var(--sl-color-text);border-color:#d7972d;}
  .gc-loading{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.7rem;z-index:5;background:var(--sl-color-bg);font-size:.78rem;}
  .gc-tools{display:flex;align-items:center;justify-content:space-between;gap:.4rem;font-size:.59rem;color:var(--sl-color-gray-2);padding-top:.4rem;}
  .gc-tools button{font-size:.6rem;padding:.2rem .35rem;min-height:28px;}
  .gc-panel h5{font-size:.88rem;margin:0 0 .4rem;}
  .gc-panel .ml-controls{padding-top:.3rem;gap:.3rem;}
  .gc-panel button{font-size:.76rem;padding:.4rem .5rem;}
  .gc-panel .ml-story{margin-top:.65rem;font-size:.75rem;}
  .gc-value{padding:.8rem 0;display:flex;flex-direction:column;gap:.4rem;}
  .gc-value span,.gc-value small{font-size:.75rem;color:var(--sl-color-gray-2);}
  .gc-value strong{font-size:.91rem;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .gc-blocks{display:grid;grid-template-columns:2fr 1fr;gap:.25rem;margin:.7rem 0!important;}
  .gc-blocks div{border:1px solid var(--sl-color-gray-4);border-radius:5px;padding:.6rem .4rem;display:flex;flex-direction:column;gap:.25rem;background:var(--sl-color-gray-6);}
  .gc-blocks b{font-size:.78rem;}.gc-blocks span{font-size:.62rem;}
  .gc-blocks .gc-active{border-color:var(--sl-color-accent);background:var(--sl-color-accent-low);}
  .gc-targets{display:grid;gap:.45rem;padding-top:.65rem;}
  .gc-targets div{border-left:3px solid #9864ce;padding-left:.5rem;display:flex;flex-direction:column;gap:.1rem;}
  .gc-targets div+div{border-left-color:#179c93;}.gc-targets span{font-size:.61rem;}.gc-targets b{font-size:.82rem;font-variant-numeric:tabular-nums;}
  .gc-matrix{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));max-width:390px;margin:.5rem auto!important;padding:.3rem;border-inline:2px solid var(--sl-color-gray-3);gap:2px;}
  .gc-matrix span{text-align:center;font-variant-numeric:tabular-nums;padding:.25rem;font-size:.75rem;}
  .gc-r{background:color-mix(in srgb,#298ab6 12%,var(--sl-color-bg));}.gc-p{background:color-mix(in srgb,#df9c24 18%,var(--sl-color-bg));}.gc-constant{color:var(--sl-color-gray-3);}
  @media(max-width:650px){.gc-layout{grid-template-columns:1fr;padding-inline:.7rem;gap:.5rem;}.gc-viewport{height:275px;}.gc-panel .ml-controls{flex-wrap:wrap;}.gc-panel button{font-size:.72rem;}.gc-value{padding:.4rem 0;}.gc-value strong{font-size:1rem;}.gc-targets{grid-template-columns:1fr 1fr;}.gc-panel .ml-story{min-height:3em;}.gc-blocks{margin:.5rem 0!important;}.gc-blocks div{padding:.4rem;}}
</style>
