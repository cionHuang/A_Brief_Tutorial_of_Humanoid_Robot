---
/**
 * 传动比（Gear Ratio）聚焦演示。
 *
 * 与「一条关节传动链」里的减速器是同一对齿轮，这里只保留最核心的关系：
 * 齿数比 z2/z1 = 传动比 N = ωm/ωout；输出转速降为 1/N，输出力矩放大约 ηN 倍。
 * 输入齿轮持续旋转，输出齿轮按 1/N 反向旋转；右侧公式与实时数值、下方的
 * 「输入转 N 圈 = 输出转 1 圈」计数一起把抽象公式变成可看的关系。
 *
 * 纯 SVG + 原生 JS，无外部依赖；样式跟随 Starlight 明暗主题，
 * 遵循 prefers-reduced-motion（该设置下默认暂停）。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import GearRatioDemo from '../../../components/GearRatioDemo.astro';
 *   <GearRatioDemo />
 */
import Tex from './Tex.astro';
import { katexHtml } from '../lib/tex.js';
---

<figure class="gr-demo">
  <svg viewBox="0 0 760 300" role="img" aria-label="传动比演示：两个啮合齿轮的齿数比决定转速与力矩的转换">
    <g class="gr-input-gear"><path class="gr-gear"></path></g>
    <g class="gr-output-gear"><path class="gr-gear"></path></g>
    <Tex role="z1" x={0} y={0} size={13} anchor="middle" color="var(--sl-color-gray-2)" />
    <Tex role="z2" x={0} y={0} size={13} anchor="middle" color="var(--sl-color-gray-2)" />

    <Tex x={440} y={54} size={15} anchor="start" color="var(--sl-color-text)" parts={[{ text: '传动比 ' }, { tex: 'N = z_2 / z_1 = \\omega_m / \\omega_{out}' }]} />
    <Tex role="live1" x={440} y={104} size={14} anchor="start" color="var(--sl-color-accent)" />
    <Tex role="live2" x={440} y={148} size={14} anchor="start" color="var(--sl-color-accent)" />
    <Tex role="live3" x={440} y={192} size={14} anchor="start" color="var(--sl-color-accent)" />
    <Tex role="count" x={440} y={244} size={13} anchor="start" color="var(--sl-color-text)" />
    <Tex x={440} y={272} size={11} anchor="start" color="var(--sl-color-gray-3)" parts={[{ tex: '\\eta' }, { text: ' 为传动效率，此处取 0.85' }]} />
  </svg>

  <div class="gr-controls">
    <label>输出齿数 <span set:html={katexHtml('z_2')}></span> <input type="range" data-gr-ratio min="2" max="5" step="1" value="4" /> <output data-gr-ratio-out>4</output> 倍</label>
    <button type="button" class="gr-play" data-gr-play aria-pressed="true">暂停</button>
  </div>

  <figcaption>
    输入齿轮有 <span set:html={katexHtml('z_1 = 10')}></span> 个齿，输出齿轮有 <span set:html={katexHtml('z_2 = 10N')}></span> 个齿，因此传动比 <span set:html={katexHtml('N = z_2 / z_1')}></span>：输入转 <span set:html={katexHtml('N')}></span> 圈，输出才转 1 圈。转速按 <span set:html={katexHtml('\\omega_{out} = \\omega_m / N')}></span> 降低，力矩按 <span set:html={katexHtml('\\tau_{out} \\approx \\eta \\cdot N \\cdot \\tau_m')}></span> 放大——这就是前面传动链演示里那对齿轮的定量关系。拖动滑块改变 <span set:html={katexHtml('N')}></span>，可以看到齿数、转速和力矩如何一起变化。
  </figcaption>
</figure>

<script>
  import { setParts } from '../lib/tex.js';
  import { createVisibleRaf } from '../lib/visible-raf.js';

  document.querySelectorAll('.gr-demo').forEach((demo) => {
    const inputGearG = demo.querySelector('.gr-input-gear');
    const outputGearG = demo.querySelector('.gr-output-gear');
    const inputPath = demo.querySelector('.gr-input-gear path');
    const outputPath = demo.querySelector('.gr-output-gear path');
    const boxOf = (role) => {
      const group = demo.querySelector('[data-role="' + role + '"]');
      return { group: group, box: group ? group.querySelector('.tex-box') : null };
    };
    const z1Lab = boxOf('z1');
    const z2Lab = boxOf('z2');
    const live1 = boxOf('live1');
    const live2 = boxOf('live2');
    const live3 = boxOf('live3');
    const countLab = boxOf('count');
    const ratioSlider = demo.querySelector('[data-gr-ratio]');
    const ratioOut = demo.querySelector('[data-gr-ratio-out]');
    const playBtn = demo.querySelector('[data-gr-play]');

    const ETA = 0.85;
    const CY = 150;
    const R1 = 22;
    const Z1 = 10;
    const GAP = 4;
    const CX1 = 150;

    let N = 4, r2 = R1 * N, cx2 = CX1 + R1 + r2 + GAP;
    let thetaIn = 0;
    let playing = true;
    let lastTs = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const gearPath = (teeth, rRoot, rTip) => {
      const pts = [];
      const pitch = (Math.PI * 2) / teeth;
      for (let i = 0; i < teeth; i++) {
        const a = i * pitch;
        const add = (ang, r) => pts.push([Math.cos(ang) * r, Math.sin(ang) * r]);
        add(a - pitch * 0.30, rRoot);
        add(a - pitch * 0.14, rTip);
        add(a + pitch * 0.14, rTip);
        add(a + pitch * 0.30, rRoot);
      }
      return 'M' + pts.map((p) => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' L') + ' Z';
    };

    const place = (lab, px, py) => {
      if (lab.group) lab.group.setAttribute('transform', 'translate(' + px.toFixed(1) + ' ' + py.toFixed(1) + ')');
    };

    const layout = () => {
      N = Number(ratioSlider.value);
      r2 = R1 * N;
      cx2 = CX1 + R1 + r2 + GAP;
      inputPath.setAttribute('d', gearPath(Z1, R1 - 3, R1 + 3));
      outputPath.setAttribute('d', gearPath(Z1 * N, r2 - 3, r2 + 3));
      inputGearG.setAttribute('transform', 'translate(' + CX1 + ' ' + CY + ')');
      outputGearG.setAttribute('transform', 'translate(' + cx2 + ' ' + CY + ')');
      place(z1Lab, CX1, CY + R1 + 34);
      setParts(z1Lab.box, [{ tex: 'z_1 = ' + Z1 }]);
      place(z2Lab, cx2, CY + r2 + 34);
      setParts(z2Lab.box, [{ tex: 'z_2 = ' + Z1 * N }]);
      ratioOut.textContent = String(N);
      setParts(live1.box, [{ tex: 'N = ' + (Z1 * N) + ' / ' + Z1 + ' = ' + N }]);
      setParts(live2.box, [{ tex: '\\omega_{out} = \\omega_m / N = ' + (1 / N).toFixed(2) + '\\ \\omega_m' }]);
      setParts(live3.box, [{ tex: '\\tau_{out} \\approx \\eta N \\tau_m = ' + (ETA * N).toFixed(2) + '\\ \\tau_m' }]);
    };

    const updateCount = () => {
      const inCycle = (thetaIn / (Math.PI * 2)) % N;
      const outCycle = inCycle / N;
      setParts(countLab.box, [{ text: '本轮：输入 ' }, { tex: inCycle.toFixed(1) + ' / ' + N }, { text: ' 圈　输出 ' }, { tex: outCycle.toFixed(1) + ' / 1' }, { text: ' 圈' }]);
    };

    const loop = createVisibleRaf(demo);
    loop.onFrame((ts) => {
      if (!playing) return false; // 暂停：不再排帧，交回连续模式
      if (!lastTs) lastTs = ts;
      const dt = Math.min((ts - lastTs) / 1000, 0.05);
      lastTs = ts;
      // 在一个周期（输入 N 圈）内取模：既避免角度无限增大，也让计数按圈复位
      thetaIn = (thetaIn + dt * Math.PI * 2 * 0.9) % (Math.PI * 2 * N);
      const thetaOut = -thetaIn / N;
      const degIn = (thetaIn * 180) / Math.PI;
      const degOut = (thetaOut * 180) / Math.PI;
      inputGearG.setAttribute('transform', 'translate(' + CX1 + ' ' + CY + ') rotate(' + degIn.toFixed(2) + ')');
      outputGearG.setAttribute('transform', 'translate(' + cx2 + ' ' + CY + ') rotate(' + degOut.toFixed(2) + ')');
      updateCount();
    });

    const setPlaying = (v) => {
      playing = v;
      playBtn.setAttribute('aria-pressed', String(v));
      playBtn.textContent = v ? '暂停' : '播放';
      if (v) { lastTs = 0; loop.start(); }
    };

    ratioSlider.addEventListener('input', () => { layout(); updateCount(); });
    playBtn.addEventListener('click', () => setPlaying(!playing));

    layout();
    updateCount();
    if (reduced) { setPlaying(false); } else { setPlaying(true); }
  });
</script>

<style>
  .gr-demo { margin: 1.5rem 0; }
  .gr-demo svg {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    margin: 0 auto;
  }
  .gr-gear {
    fill: light-dark(#cbd5e1, #475569);
    stroke: light-dark(#64748b, #94a3b8);
    stroke-width: 1.5;
  }
  .gr-input-gear .gr-gear { fill: light-dark(#fde68a, #a16207); stroke: light-dark(#d97706, #fbbf24); }
  .gr-gear-label { fill: var(--sl-color-gray-2); font-size: 13px; font-weight: 600; }
  .gr-title { fill: var(--sl-color-text); font-size: 15px; font-weight: 700; }
  .gr-live { fill: var(--sl-color-accent); font-size: 14px; font-variant-numeric: tabular-nums; }
  .gr-count { fill: var(--sl-color-text); font-size: 13px; }
  .gr-note { fill: var(--sl-color-gray-3); font-size: 11px; }
  .gr-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    max-width: 760px;
    margin: 0.6rem auto 0;
  }
  .gr-controls label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .gr-controls input[type='range'] { width: 9rem; accent-color: var(--sl-color-accent); }
  .gr-controls output { color: var(--sl-color-accent); font-variant-numeric: tabular-nums; }
  .gr-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.1rem;
    margin: 0;
    padding: 0 0.75rem;
    box-sizing: border-box;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 6px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1;
    cursor: pointer;
  }
  .gr-demo figcaption {
    max-width: 760px;
    margin: 0.6rem auto 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.65;
  }
</style>
