---
/**
 * EtherCAT“一帧传阅”交互演示：主站每个周期只发一个数据帧，帧沿链路依次经过
 * 四个从站，每个从站从同一帧里取走自己的输出数据（OUT）、把输入数据（IN）
 * 写回同一帧；一圈跑完，所有从站同时完成一次更新。
 *
 * 教学要点：EtherCAT 不需要主站与每个节点建立独立点对点连接——一帧在环路上
 * “传阅”，从站在帧经过时本地读写属于自己的过程数据（PDO），因此多轴可以
 * 严格同步。
 *
 * 交互：默认静止在主站；点“播放”开始传阅，“暂停”冻结，“单步”推进到下一个
 * 从站中心停住，“复位”回到主站并清空所有从站状态。所有 SVG 图形元素都写在
 * markup 里，JS 只用 requestAnimationFrame 改属性/文本/classList；样式跟随
 * Starlight 明暗主题，并遵循 prefers-reduced-motion。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import EthercatFrameDemo from '../../../components/EthercatFrameDemo.astro';
 *   <EthercatFrameDemo />
 */
const STATIONS = [330, 470, 610, 750];
const STATION_NAMES = ['左髋俯仰', '左膝', '左踝俯仰', '左踝侧摆'];

const GEOM = {
  masterX: 104,
  master: { x: 30, y: 80, w: 148, h: 92 },
  node: { w: 112, h: 92, y: 80 },
  link: { x0: 178, x1: 850, y: 210 },
  frame: { w: 76, h: 30, y: 195 },
  slot: { w: 76, h: 40, y: 268 },
};

const NODES = STATIONS.map((cx, i) => ({
  i,
  cx,
  boxX: cx - GEOM.node.w / 2,
  slotX: cx - GEOM.slot.w / 2,
}));

const CFG = { stations: STATIONS, names: STATION_NAMES, geom: GEOM };
---

<figure class="ec-demo" data-ec={JSON.stringify(CFG)}>
  <svg viewBox="0 0 900 400" role="img" aria-label="EtherCAT 一帧传阅教学示意：主站每周期发一帧，帧沿链路依次经过四个从站，每个从站取走输出数据并把输入数据写回同一帧">
    <text class="ec-title" x="24" y="28">EtherCAT 一帧传阅（教学示意）</text>

    <!-- 主站 -->
    <rect class="ec-box ec-box-master" x={GEOM.master.x} y={GEOM.master.y} width={GEOM.master.w} height={GEOM.master.h} rx="10"></rect>
    <text class="ec-box-name" x={GEOM.masterX} y="121" text-anchor="middle">主站 Master</text>
    <text class="ec-box-sub" x={GEOM.masterX} y="150" text-anchor="middle">每周期发一帧</text>

    <!-- 主站到链路的竖线 -->
    <line class="ec-link" x1={GEOM.masterX} y1="172" x2={GEOM.masterX} y2="210"></line>

    <!-- 主干链路 -->
    <line class="ec-link" x1={GEOM.link.x0} y1={GEOM.link.y} x2={GEOM.link.x1} y2={GEOM.link.y}></line>

    <!-- 4 个从站 -->
    {NODES.map((n) => (
      <g class="ec-node-g" data-node={n.i}>
        <rect class="ec-box ec-node" x={n.boxX} y={GEOM.node.y} width={GEOM.node.w} height={GEOM.node.h} rx="10"></rect>
        <text class="ec-node-name" x={n.cx} y="121" text-anchor="middle">{STATION_NAMES[n.i]}</text>
        <text class="ec-node-status" data-status={n.i} x={n.cx} y="150" text-anchor="middle">待访问</text>
      </g>
    ))}

    <!-- 帧内数据槽（每个从站一格，被访问后点亮） -->
    {NODES.map((n) => (
      <g class="ec-slot-g" data-slot={n.i}>
        <rect class="ec-slot" x={n.slotX} y={GEOM.slot.y} width={GEOM.slot.w} height={GEOM.slot.h} rx="8"></rect>
        <text class="ec-slot-label" x={n.cx} y="284" text-anchor="middle">目标</text>
        <text class="ec-slot-label" x={n.cx} y="302" text-anchor="middle">状态</text>
      </g>
    ))}

    <!-- 移动的帧：整组平移，帧中心 x 即 fx -->
    <g class="ec-frame" data-role="frame" transform="translate(104 0)">
      <rect class="ec-frame-body" x="-38" y="195" width="76" height="30" rx="8"></rect>
      <text class="ec-frame-text" x="0" y="216" text-anchor="middle">帧</text>
      <text class="ec-frame-tag" x="44" y="216">OUT+IN</text>
    </g>

    <text class="ec-note" x="24" y="352">四个从站（左腿关节驱动器）：主站只发一帧，所有从站按顺序在同一帧上读写。</text>
  </svg>

  <div class="ec-controls">
    <button type="button" class="ec-btn ec-play" data-play aria-pressed="false">播放</button>
    <button type="button" class="ec-btn" data-step>单步</button>
    <button type="button" class="ec-btn" data-reset>复位</button>
  </div>

  <div class="ec-readout">
    <output class="ec-out ec-out-state" aria-live="polite"></output>
    <output class="ec-out ec-out-slot" aria-live="polite"></output>
  </div>

  <figcaption>
    玩法：点“播放”看一帧怎么依次经过四个从站；单步可以一站一站看。数值为教学示意。
  </figcaption>
</figure>

<script>
  document.querySelectorAll('.ec-demo').forEach((demo) => {
    const cfg = JSON.parse(demo.dataset.ec);
    const stations = cfg.stations;
    const names = cfg.names;
    const geom = cfg.geom;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const frameEl = demo.querySelector('[data-role="frame"]');
    const stateOut = demo.querySelector('.ec-out-state');
    const slotOut = demo.querySelector('.ec-out-slot');
    const playBtn = demo.querySelector('[data-play]');
    const stepBtn = demo.querySelector('[data-step]');
    const resetBtn = demo.querySelector('[data-reset]');
    const nodeEls = stations.map((_, i) => demo.querySelector('[data-node="' + i + '"]'));
    const statusEls = stations.map((_, i) => demo.querySelector('[data-status="' + i + '"]'));
    const slotEls = stations.map((_, i) => demo.querySelector('[data-slot="' + i + '"]'));

    const ZONE = 30;          // 访问区半宽：从站中心 ±30
    const SPEED = 240;        // 帧移动速度 px/s
    const DWELL = 0.7;        // 帧返回主站后的停留时间 s
    const MASTER_X = geom.masterX;
    const START_X = geom.link.x0;
    const END_X = geom.link.x1;

    let fx = MASTER_X;        // 帧中心 x
    let playing = false;
    let returned = false;     // 是否刚从链路末端返回主站
    let dwell = 0;
    let raf = 0;
    let last = 0;

    // 状态机：0 待访问 / 1 取目标 / 2 写状态 / 3 已更新（由帧位置纯函数推出）
    const stateOf = (i) => {
      const c = stations[i];
      if (fx < c - ZONE) return 0;
      if (fx > c + ZONE) return 3;
      const rel = fx - (c - ZONE);
      if (rel < (ZONE * 2) / 3) return 1;
      if (rel < (ZONE * 4) / 3) return 2;
      return 3;
    };

    const phaseLabel = (s) => (s === 3 ? '已更新' : s === 2 ? '写状态' : '取目标');
    const doneCount = () => stations.reduce((n, _, i) => n + (stateOf(i) === 3 ? 1 : 0), 0);

    const describe = () => {
      if (fx <= MASTER_X + 4) return returned ? '帧返回主站' : '帧在主站';
      for (let i = 0; i < stations.length; i++) {
        const c = stations[i];
        if (fx >= c - ZONE && fx <= c + ZONE) {
          return '帧到达 ' + names[i] + '：' + phaseLabel(stateOf(i));
        }
      }
      const next = stations.find((c) => c > fx);
      if (next != null) return '帧在链路中，前往 ' + names[stations.indexOf(next)];
      return '帧即将返回主站';
    };

    const render = () => {
      frameEl.setAttribute('transform', 'translate(' + fx.toFixed(1) + ' 0)');
      stations.forEach((_, i) => {
        const s = stateOf(i);
        nodeEls[i].classList.toggle('ec-node-on', s >= 1);
        nodeEls[i].classList.toggle('ec-node-done', s >= 3);
        slotEls[i].classList.toggle('ec-slot-on', s >= 1);
        slotEls[i].classList.toggle('ec-slot-done', s >= 3);
        statusEls[i].textContent = s === 3 ? '已更新' : s === 2 ? '写状态…' : s === 1 ? '取目标…' : '待访问';
      });
      stateOut.textContent = describe() + (reduced ? '　（系统已开启减弱动态效果：保持静止，可单步查看）' : '');
      slotOut.textContent = '已更新 ' + doneCount() + ' / ' + stations.length + ' 个从站';
    };

    const syncPlayLabel = () => {
      playBtn.textContent = playing ? '暂停' : '播放';
      playBtn.setAttribute('aria-pressed', String(playing));
    };

    const stop = () => {
      playing = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    const advance = (dt) => {
      if (dwell > 0) {
        dwell -= dt;
        if (dwell <= 0) {
          dwell = 0;
          returned = false;
          fx = START_X;
        }
        return;
      }
      fx += SPEED * dt;
      if (fx >= END_X) {
        fx = MASTER_X;   // 回到主站，准备下一轮
        returned = true;
        dwell = DWELL;
      }
    };

    const tick = (ts) => {
      if (!last) last = ts;
      const dt = Math.min((ts - last) / 1000, 0.05);
      last = ts;
      advance(dt);
      render();
      if (playing) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
      }
    };

    const start = () => {
      if (raf) return;
      if (fx <= MASTER_X + 4) {
        fx = START_X;
        returned = false;
      }
      last = 0;
      playing = true;
      raf = requestAnimationFrame(tick);
    };

    playBtn.addEventListener('click', () => {
      if (reduced) return;
      if (playing) stop(); else start();
      syncPlayLabel();
      render();
    });

    stepBtn.addEventListener('click', () => {
      stop();
      syncPlayLabel();
      const nextIdx = stations.findIndex((c) => c > fx + 1);
      if (nextIdx === -1) {
        fx = MASTER_X;   // 最后一站之后回到主站
        returned = true;
      } else {
        fx = stations[nextIdx];
        returned = false;
      }
      dwell = 0;
      render();
    });

    resetBtn.addEventListener('click', () => {
      stop();
      syncPlayLabel();
      fx = MASTER_X;
      returned = false;
      dwell = 0;
      render();
    });

    if (reduced) playBtn.disabled = true;
    syncPlayLabel();
    render();
  });
</script>

<style>
  .ec-demo { margin: 1.5rem 0; }
  .ec-demo svg { display: block; width: 100%; max-width: 900px; height: auto; margin: 0 auto; }

  .ec-title { fill: var(--sl-color-text); font-size: 24px; font-weight: 600; }
  .ec-note { fill: var(--sl-color-gray-2); font-size: 17px; }

  .ec-box { fill: light-dark(rgba(148, 163, 184, 0.14), rgba(148, 163, 184, 0.12)); stroke: var(--sl-color-gray-4); stroke-width: 1.6; }
  .ec-box-master { stroke: var(--sl-color-accent); }
  .ec-box-name { fill: var(--sl-color-text); font-size: 21px; font-weight: 600; }
  .ec-box-sub { fill: var(--sl-color-gray-2); font-size: 17px; }

  .ec-node-name { fill: var(--sl-color-text); font-size: 20px; font-weight: 600; }
  .ec-node-status { fill: var(--sl-color-gray-2); font-size: 17px; }
  .ec-node-g.ec-node-on .ec-node { stroke: var(--sl-color-accent); stroke-width: 2.4; }
  .ec-node-g.ec-node-done .ec-node { fill: light-dark(rgba(79, 70, 229, 0.12), rgba(139, 131, 255, 0.16)); stroke: var(--sl-color-accent); }
  .ec-node-g.ec-node-on .ec-node-name { fill: var(--sl-color-accent); }
  .ec-node-g.ec-node-on .ec-node-status { fill: var(--sl-color-accent); font-weight: 600; }

  .ec-link { stroke: var(--sl-color-gray-3); stroke-width: 2; }

  .ec-slot { fill: light-dark(rgba(148, 163, 184, 0.12), rgba(148, 163, 184, 0.1)); stroke: var(--sl-color-gray-4); stroke-width: 1.4; }
  .ec-slot-label { fill: var(--sl-color-gray-2); font-size: 17px; }
  .ec-slot-g.ec-slot-on .ec-slot { stroke: var(--sl-color-accent); stroke-width: 2.2; }
  .ec-slot-g.ec-slot-on .ec-slot-label { fill: var(--sl-color-text); }
  .ec-slot-g.ec-slot-done .ec-slot { fill: light-dark(rgba(79, 70, 229, 0.14), rgba(139, 131, 255, 0.18)); stroke: var(--sl-color-accent); }
  .ec-slot-g.ec-slot-done .ec-slot-label { font-weight: 600; }

  .ec-frame-body { fill: light-dark(rgba(79, 70, 229, 0.16), rgba(139, 131, 255, 0.22)); stroke: var(--sl-color-accent); stroke-width: 2.2; }
  .ec-frame-text { fill: var(--sl-color-text); font-size: 20px; font-weight: 600; }
  .ec-frame-tag { fill: var(--sl-color-gray-2); font-size: 17px; }

  .ec-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; max-width: 900px; margin: 0.55rem auto 0; }
  .ec-btn { display: inline-flex; align-items: center; justify-content: center; height: 2.1rem; margin: 0; padding: 0 0.85rem; box-sizing: border-box; border: 1px solid var(--sl-color-gray-4); border-radius: 6px; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; font-size: 0.8125rem; line-height: 1; cursor: pointer; }
  .ec-btn[aria-pressed='true'] { border-color: var(--sl-color-accent); color: var(--sl-color-accent); background: light-dark(rgba(79, 70, 229, 0.08), rgba(139, 131, 255, 0.14)); font-weight: 600; }
  .ec-btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .ec-readout { max-width: 900px; margin: 0.5rem auto 0; font-size: 0.9rem; color: var(--sl-color-text); line-height: 1.7; }
  .ec-out { display: block; white-space: nowrap; overflow-x: auto; height: 1.7em; line-height: 1.7; }
  .ec-readout output { color: var(--sl-color-accent); font-weight: 600; }
  .ec-demo figcaption { max-width: 900px; margin: 0.6rem auto 0; color: var(--sl-color-gray-2); font-size: 0.9rem; line-height: 1.65; }
</style>
