---
import { katexHtml } from '../lib/tex.js';
const phases = [{ key: 'a', angle: 0 }, { key: 'b', angle: 120 }, { key: 'c', angle: 240 }];
const coils = phases.flatMap((phase) => [0, 180].map((offset) => ({ ...phase, angle: phase.angle + offset })));
const steps = ['看电机', '看出力', '跟随转子看'];
---

<figure class="foc-demo" data-foc-motor>
  <header class="foc-header">
    <span class="foc-eyebrow">放大肘关节里的电机</span>
    <h4>转子换了位置，三相电流怎样跟着变？</h4>
    <p>先认出线圈和转子，再换一个观察角度。</p>
  </header>
  <div class="foc-steps" role="group" aria-label="电机演示的三个观察步骤">
    {steps.map((name, i) => <button type="button" data-step={i + 1} aria-pressed={i === 0 ? 'true' : 'false'}><span>{i + 1}</span>{name}</button>)}
  </div>
  <div class="foc-scene">
    <div class="foc-motor-pane">
      <div class="foc-view-label" data-view-label>从外壳看 · 线圈固定，转子转动</div>
      <svg class="foc-motor" viewBox="0 0 400 400" role="img" aria-label="电机剖面：外圈是固定的三组线圈，中间是带 N、S 磁极的转子">
        <defs>
          <marker id="foc-rotor-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10Z" class="foc-rotor-fill" /></marker>
          <marker id="foc-stator-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10Z" class="foc-stator-fill" /></marker>
        </defs>
        <circle cx="200" cy="200" r="188" class="foc-shell-outline" />
        <g data-world>
          <circle cx="200" cy="200" r="176" class="foc-shell" />
          <circle cx="200" cy="200" r="146" class="foc-stator-core" />
          {Array.from({ length: 24 }, (_, i) => <path d="M200 30V44" transform={`rotate(${i * 15} 200 200)`} class="foc-lamination" />)}
          {coils.map((coil) => {
            const r = coil.angle * Math.PI / 180;
            return <g class={'foc-coil foc-phase-' + coil.key} data-coil={coil.key} transform={`translate(${200 + 132 * Math.cos(r)} ${200 - 132 * Math.sin(r)})`}>
              <g transform={`rotate(${-coil.angle})`}>
                <rect x="-26" y="-22" width="52" height="44" rx="7" class="foc-coil-core" />
                <rect x="-22" y="-20" width="44" height="40" rx="5" class="foc-coil-copper" data-coil-fill />
                {[-15, -5, 5, 15].map((x) => <path d={`M${x} -20V20`} class="foc-coil-wire" />)}
              </g>
              <g data-coil-label><rect x="-17" y="-14" width="34" height="28" rx="8" class="foc-coil-tag" /><text x="0" y="6" text-anchor="middle">{coil.key}</text></g>
            </g>;
          })}
          <circle cx="200" cy="200" r="95" class="foc-air-gap" />
          <g data-rotor>
            <circle cx="200" cy="200" r="78" class="foc-rotor-disk" />
            <path d="M200 130A70 70 0 0 1 200 270Z" class="foc-magnet-n" />
            <path d="M200 270A70 70 0 0 1 200 130Z" class="foc-magnet-s" />
            <text x="242" y="207" class="foc-pole-label" text-anchor="middle">N</text>
            <text x="158" y="207" class="foc-pole-label" text-anchor="middle">S</text>
          </g>
          <g class="foc-dq-axes" data-dq-axes opacity="0">
            <line x1="88" y1="200" x2="312" y2="200" /><line x1="200" y1="312" x2="200" y2="88" />
            <text x="315" y="192">d</text><text x="210" y="90">q</text>
          </g>
          <g data-fields opacity="0">
            <line x1="200" y1="200" x2="292" y2="200" class="foc-field-rotor" data-rotor-field marker-end="url(#foc-rotor-arrow)" />
            <line x1="200" y1="200" x2="200" y2="106" class="foc-field-stator" data-stator-field marker-end="url(#foc-stator-arrow)" />
          </g>
          <circle cx="200" cy="200" r="13" class="foc-shaft" /><circle cx="200" cy="200" r="4" class="foc-shaft-center" />
        </g>
      </svg>
      <div class="foc-field-legend" data-field-legend hidden><span><i class="foc-rotor-key"></i>转子磁场</span><span><i class="foc-stator-key"></i>绕组合成磁场</span></div>
      <p class="foc-scene-note" data-scene-note>三种颜色对应三组线圈；线圈越亮，电流越大。</p>
    </div>
    <div class="foc-observation">
      <span class="foc-eyebrow">这一刻，看这里</span>
      <h5 data-observe-title>线圈不动，电流在变</h5>
      <p data-observe-text>外圈的三组线圈固定在外壳上。改变转子位置，观察各相电流怎样改变大小和方向。</p>
      <div class="foc-phase-readings" aria-label="三相电流，相对值" aria-live="off">
        {phases.map((phase) => <div class={'foc-phase-reading foc-phase-' + phase.key}>
          <span>{phase.key} 相</span><div class="foc-phase-track"><span class="foc-phase-zero"></span><span class="foc-phase-bar" data-phase-bar={phase.key}></span></div><output data-phase-value={phase.key} aria-live="off">0.00</output>
        </div>)}
        <small>左负右正；正负号表示电流方向。</small>
      </div>
      <div class="foc-torque-card" data-torque-card hidden aria-live="off"><span>此刻的转矩（相对值）</span><strong data-torque-value>+0.75</strong><p data-torque-text>电流随转子调整，转矩保持不变。</p></div>
      <div class="foc-dq-readings" data-dq-readings hidden aria-live="off">
        <div><span set:html={katexHtml('i_d')}></span><output data-id aria-live="off">0.00</output></div><div><span set:html={katexHtml('i_q')}></span><output data-iq aria-live="off">+0.75</output></div>
        <p>还是同一组三相电流，换个坐标，读数就稳定了。</p>
      </div>
    </div>
  </div>
  <div class="foc-controls">
    <div class="foc-actions"><button class="foc-button foc-primary" type="button" data-play aria-pressed="false">播放观察</button><button class="foc-button" type="button" data-reset>复位</button></div>
    <label class="foc-slider-label"><span>转子位置 <output data-angle-output aria-live="off">30°</output></span><input type="range" min="0" max="360" step="1" value="30" data-angle aria-label="转子位置，角度" /></label>
    <label class="foc-slider-label"><span>出力大小 <output data-effort-output aria-live="off">75%</output></span><input type="range" min="0" max="100" step="1" value="75" data-effort aria-label="出力大小，相对值" /></label>
  </div>
  <p class="foc-play-note" data-play-note>播放只把转子依次放到不同位置，让你观察所需电流；不是电机加速过程。</p>
  <span class="foc-sr-only" data-announcement role="status" aria-live="polite"></span>
  <details class="foc-experiment" data-experiment>
    <summary>试一试：如果三相电流不再跟着转子调整呢？</summary>
    <div class="foc-details-body"><p>固定此刻的三相电流，再手动拖动“转子位置”。合成磁场不再跟随，你会看到转矩减小、归零，甚至反向。</p><button class="foc-button" type="button" data-freeze aria-pressed="false">固定现在的三相电流</button><p data-fixed-result>这是外力转动转子的对照实验，固定电流时不能播放。</p></div>
  </details>
  <details class="foc-formulas">
    <summary>对应到 Clarke / Park 变换</summary>
    <div class="foc-details-body">
      <p>三相电流之和为零时，Clarke 变换用静止坐标系的两个分量表示它们；Park 变换再把坐标转到转子磁场方向。</p>
      <div class="foc-formula" set:html={katexHtml('i_\\alpha=i_a,\\quad i_\\beta=\\frac{i_b-i_c}{\\sqrt{3}}')}></div>
      <div class="foc-formula" set:html={katexHtml('i_d=i_\\alpha\\cos\\theta+i_\\beta\\sin\\theta')}></div>
      <div class="foc-formula" set:html={katexHtml('i_q=-i_\\alpha\\sin\\theta+i_\\beta\\cos\\theta')}></div>
      <p>本演示正常运行时取 <span set:html={katexHtml('i_d=0')}></span>；出力大小对应 <span set:html={katexHtml('i_q')}></span>。绕组合成磁场与转子磁场垂直，在这一理想模型中，转矩与 <span set:html={katexHtml('i_q')}></span> 成正比。固定电流的对照实验会改变它们的相对方向。</p>
    </div>
  </details>
  <figcaption>一对磁极的理想表贴永磁电机，电流与转矩均为相对值。这里是电机转子角，非关节角；剖面是教学示意，不代表 G1 电机的真实内部结构。跟随视角只改变观察方向，线圈仍固定在电机外壳上。</figcaption>
</figure>

<script>
  import { motorSample } from '../lib/foc-model.js';
  import { createVisibleRaf } from '../lib/visible-raf.js';
  document.querySelectorAll('[data-foc-motor]').forEach((demo) => {
    if (demo.hasAttribute('data-ready')) return;
    demo.setAttribute('data-ready', 'true');
    const $ = (selector) => demo.querySelector(selector);
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const loop = createVisibleRaf(demo);
    const angleInput = $('[data-angle]'), effortInput = $('[data-effort]');
    const play = $('[data-play]'), freeze = $('[data-freeze]');
    const phaseBars = {}, phaseValues = {};
    ['a', 'b', 'c'].forEach((k) => { phaseBars[k] = $(`[data-phase-bar="${k}"]`); phaseValues[k] = $(`[data-phase-value="${k}"]`); });
    const coils = Array.from(demo.querySelectorAll('[data-coil]'));
    const labels = Array.from(demo.querySelectorAll('[data-coil-label]'));
    const steps = Array.from(demo.querySelectorAll('[data-step]'));
    const DEG = Math.PI / 180;
    let angle = 30, effort = 0.75, step = 1, playing = false;
    let camera = 0, cameraRemaining = 0, last = 0, fixed = null, fixedAt = 0;
    const signed = (n) => Math.abs(n) < 0.005 ? '0.00' : (n > 0 ? '+' : '−') + Math.abs(n).toFixed(2);
    const difference = (to, from) => ((to - from + 540) % 360) - 180;
    const announce = (text) => { $('[data-announcement]').textContent = text; };
    const explanations = {
      1: ['线圈不动，电流在变', '外圈的三组线圈固定在外壳上。改变转子位置，观察各相电流怎样改变大小和方向。'],
      2: ['保持合适的方向，持续出力', '转子换了位置，三相电流随之调整，让绕组合成磁场始终与转子磁场垂直。拖动出力大小，看看转矩怎样变化。'],
      3: ['跟着转子看，读数稳定下来', '现在视角随转子转动：d 轴沿转子磁场，q 轴与它垂直。三相电流还在变，同一组电流的 d、q 分量却保持不变。'],
    };
    function render() {
      const s = motorSample(angle * DEG, effort, fixed);
      const fields = step > 1 || fixed !== null;
      $('[data-world]').setAttribute('transform', `rotate(${camera} 200 200)`);
      $('[data-rotor]').setAttribute('transform', `rotate(${-angle} 200 200)`);
      labels.forEach((label) => label.setAttribute('transform', `rotate(${-camera})`));
      $('[data-dq-axes]').setAttribute('transform', `rotate(${-angle} 200 200)`);
      $('[data-dq-axes]').setAttribute('opacity', step === 3 ? '1' : '0');
      $('[data-fields]').setAttribute('opacity', fields ? '1' : '0');
      $('[data-rotor-field]').setAttribute('x2', String(200 + 103 * Math.cos(angle * DEG)));
      $('[data-rotor-field]').setAttribute('y2', String(200 - 103 * Math.sin(angle * DEG)));
      $('[data-stator-field]').setAttribute('x2', String(200 + 119 * s.vector.alpha));
      $('[data-stator-field]').setAttribute('y2', String(200 - 119 * s.vector.beta));
      $('[data-stator-field]').setAttribute('opacity', s.fieldSize < 0.001 ? '0' : '1');
      coils.forEach((coil) => { coil.querySelector('[data-coil-fill]').style.opacity = String(0.13 + 0.87 * Math.abs(s.phases[coil.getAttribute('data-coil')])); });
      ['a', 'b', 'c'].forEach((k) => {
        const n = s.phases[k];
        phaseValues[k].textContent = signed(n);
        phaseBars[k].style.left = (n < 0 ? 50 + n * 50 : 50) + '%';
        phaseBars[k].style.width = Math.abs(n) * 50 + '%';
      });
      $('[data-angle-output]').textContent = Math.round(angle) + '°';
      angleInput.setAttribute('aria-valuetext', Math.round(angle) + ' 度');
      $('[data-effort-output]').textContent = Math.round(effort * 100) + '%';
      $('[data-torque-value]').textContent = signed(s.torque);
      $('[data-id]').textContent = signed(s.dq.d); $('[data-iq]').textContent = signed(s.dq.q);
      $('[data-field-legend]').hidden = !fields; $('[data-torque-card]').hidden = !fields;
      $('[data-dq-readings]').hidden = step !== 3;
      $('[data-observe-title]').textContent = fixed ? '电流固定后，转矩不再固定' : explanations[step][0];
      $('[data-observe-text]').textContent = fixed ? '此时由你手动改变转子位置。绕组合成磁场固定在外壳方向，转子换了位置，出力的大小和方向也会改变。' : explanations[step][1];
      $('[data-view-label]').textContent = step === 3 ? '跟随转子看 · 外壳在画面里转动' : '从外壳看 · 线圈固定，转子转动';
      $('[data-scene-note]').textContent = step === 3 ? '视角在转，线圈没有相对外壳移动。' : '三种颜色对应三组线圈；线圈越亮，电流越大。';
      $('[data-torque-text]').textContent = fixed ? (Math.abs(s.torque) < 0.015 ? '此刻转矩接近零。' : s.torque > 0 ? '仍沿原来的方向出力。' : '转矩已经反向。') : effort < 0.005 ? '电流为零，此模型中的电磁转矩也为零。' : '电流随转子调整，转矩保持不变。';
      $('[data-dq-readings] p').textContent = fixed ? '电流不再随转子调整，d、q 分量也随角度变化。' : '还是同一组三相电流，换个坐标，读数就稳定了。';
      $('[data-fixed-result]').textContent = fixed
        ? s.fieldSize < 0.001 ? '当前三相电流为零，任何转子位置的转矩都为零；恢复跟随后增大出力，再做比较。'
          : `三相电流已固定在 ${Math.round(fixedAt)}° 时的取值。现在转矩为 ${signed(s.torque)}；拖动位置，看看何时归零或反向。关闭本实验也会恢复电流跟随。`
        : '这是外力转动转子的对照实验，固定电流时不能播放。';
      play.disabled = fixed !== null; effortInput.disabled = fixed !== null;
      play.textContent = fixed ? '手动观察中' : motion.matches ? '前进 15°' : playing ? '暂停' : '播放观察';
      play.setAttribute('aria-pressed', String(playing));
      freeze.textContent = fixed ? '恢复电流跟随' : '固定现在的三相电流';
      freeze.setAttribute('aria-pressed', String(fixed !== null));
      $('[data-play-note]').textContent = fixed ? '电流已经固定：用位置滑块手动转动转子，播放与出力调节暂时停用。' : motion.matches ? '已按减少动态效果的设置暂停动画；可逐步前进，或用滑块改变位置。' : '播放只把转子依次放到不同位置，让你观察所需电流；不是电机加速过程。';
      steps.forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.step) === step)));
    }
    function update() {
      const target = step === 3 ? angle : 0;
      if (motion.matches) { camera = target; cameraRemaining = 0; }
      else if (Math.abs(difference(target, camera)) > 0.05) cameraRemaining = 0.4;
      render(); last = 0;
      if (playing || Math.abs(difference(target, camera)) > 0.05) loop.start(); else loop.stop();
    }
    loop.onFrame((now) => {
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 1 / 60;
      last = now;
      if (playing && !fixed && !motion.matches) {
        angle = (angle + 25 * dt) % 360; angleInput.value = String(angle);
      }
      const target = step === 3 ? angle : 0, delta = difference(target, camera);
      // A finite transition catches a moving target, then follows the rotor exactly.
      // Exponential pursuit alone would leave a permanent angle lag during playback.
      if (cameraRemaining > dt) { camera = (camera + delta * dt / cameraRemaining + 360) % 360; cameraRemaining -= dt; }
      else { camera = target; cameraRemaining = 0; }
      render();
      if (!playing && Math.abs(difference(target, camera)) < 0.05) { last = 0; return false; }
      return true;
    });
    steps.forEach((button) => button.addEventListener('click', () => { step = Number(button.dataset.step); announce(`第 ${step} 步，${button.textContent.slice(1)}。`); update(); }));
    play.addEventListener('click', () => {
      if (fixed) return;
      if (motion.matches) { angle = (angle + 15) % 360; angleInput.value = String(angle); } else playing = !playing;
      announce(motion.matches ? `转子位置 ${Math.round(angle)} 度。` : playing ? '开始观察电流随转子位置变化。' : '观察已暂停。'); update();
    });
    angleInput.addEventListener('input', () => { playing = false; angle = Number(angleInput.value); update(); });
    angleInput.addEventListener('change', () => { announce(`转子位置 ${Math.round(angle)} 度，转矩 ${signed(motorSample(angle * DEG, effort, fixed).torque)}。`); });
    effortInput.addEventListener('input', () => { effort = Number(effortInput.value) / 100; render(); });
    freeze.addEventListener('click', () => {
      playing = false;
      if (fixed) fixed = null;
      else { fixed = { ...motorSample(angle * DEG, effort).vector }; fixedAt = angle; if (step === 1) step = 2; }
      announce(fixed ? '三相电流已固定，请手动改变转子位置。' : '已恢复电流随转子位置调整。'); update();
    });
    $('[data-experiment]').addEventListener('toggle', () => { if (!$('[data-experiment]').open && fixed) { fixed = null; update(); } });
    $('[data-reset]').addEventListener('click', () => {
      playing = false; fixed = null; angle = 30; effort = 0.75; step = 1;
      angleInput.value = '30'; effortInput.value = '75'; $('[data-experiment]').open = false;
      announce('已复位，回到第 1 步。'); update();
    });
    motion.addEventListener('change', () => { playing = false; update(); });
    render();
  });
</script>

<style>
  .foc-demo { --foc-rotor: #c4513d; --foc-field: #087f82; margin: 1.6rem 0; border: 1px solid var(--sl-color-gray-5); border-radius: 16px; overflow: hidden; background: var(--sl-color-bg); color: var(--sl-color-text); }
  :global([data-theme='dark']) .foc-demo { --foc-rotor: #ff9b86; --foc-field: #5bd7c9; }
  .foc-demo :where(p, h4, h5) { margin: 0; }
  .foc-header { padding: 1.2rem 1.35rem 1rem; }
  .foc-eyebrow { display: block; color: var(--sl-color-text-accent); font-size: .78rem; font-weight: 650; letter-spacing: .025em; }
  .foc-header h4 { font-size: 1.2rem; line-height: 1.45; margin: .35rem 0; }
  .foc-header p { color: var(--sl-color-gray-2); font-size: .88rem; line-height: 1.6; }
  .foc-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: .35rem; padding: 0 1.25rem 1rem; }
  .foc-steps button { display: flex; gap: .45rem; justify-content: center; align-items: center; padding: .7rem .35rem; margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 9px; background: var(--sl-color-bg); color: var(--sl-color-gray-2); font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; }
  .foc-steps button span { display: inline-grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--sl-color-gray-6); font-size: .74rem; }
  .foc-steps button[aria-pressed='true'] { color: var(--sl-color-text-accent); border-color: var(--sl-color-accent); background: var(--sl-color-accent-low); }
  .foc-steps button[aria-pressed='true'] span { color: var(--sl-color-bg); background: var(--sl-color-text-accent); }
  .foc-scene { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 1rem; border-block: 1px solid var(--sl-color-gray-5); padding: 1rem 1.25rem 1.2rem; background: color-mix(in srgb, var(--sl-color-gray-6) 38%, var(--sl-color-bg)); }
  .foc-motor-pane { min-width: 0; }
  .foc-view-label { text-align: center; color: var(--sl-color-gray-2); font-size: .76rem; line-height: 1.6; }
  .foc-motor { display: block; width: 100%; max-width: 430px; margin: .3rem auto 0; overflow: visible; }
  .foc-shell-outline { fill: none; stroke: var(--sl-color-gray-5); stroke-width: 1; }
  .foc-shell { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 5; }
  .foc-stator-core { fill: var(--sl-color-bg); stroke: var(--sl-color-gray-5); stroke-width: 17; }
  .foc-lamination { stroke: var(--sl-color-gray-4); stroke-width: 3; }
