---
/**
 * FOC 坐标变换交互演示：三相逆变器 → 三相电流 → Clarke(αβ) → Park(dq)。
 *
 * 教学要点：三根线上的交流电流，经过 Clarke 到静止 αβ、再经 Park 旋转到随转子
 * 转动的 dq 后，变成两个近似直流量：i_d ≈ 0、i_q = 给定值 i_q*。这就是
 * “交流电流调节变成两个直流量控制”。
 *
 * 左面板：上半是一个电周期（θe 0..360°）的三相电流波形 i_a/i_b/i_c（标幺值，
 *   幅值随 i_q* 变化），竖直游标表示当前 θe；下半是静止 αβ 平面（α/β 轴、单位圆、
 *   电流矢量），叠加随 θe 旋转的 d/q 轴与矢量在 d/q 上的投影；右侧小图是 dq 平面里
 *   的工作点，它不随 θe 走动——这就是“直流量”。
 * 右面板：三相逆变器 PWM 示意——a/b/c 三条占空比条（0.5 + 0.5·归一化调制波）、
 *   三角载波与三相参考波、载波游标和“参考 > 载波 → 开通”比较。
 *
 * 模型（教学示意，归一化，固定 i_d* = 0，i_q* 由滑块给定 0..1）：
 *   α = -i_q*·sin θe，β = i_q*·cos θe；
 *   反 Clarke：i_a = α，i_b = -α/2 + (√3/2)β，i_c = -α/2 - (√3/2)β；
 *   Clarke：  α = (2/3)(i_a - i_b/2 - i_c/2)，β = (1/√3)(i_b - i_c)；
 *   Park：    i_d = α cos θe + β sin θe，i_q = -α sin θe + β cos θe。
 *   代入可得 i_d ≈ 0、i_q = i_q*。
 *
 * 纯 SVG + 原生 JS；所有图形元素都写在 markup 里，JS 只改属性/文本/class；
 * 样式跟随 Starlight 明暗主题，并遵循 prefers-reduced-motion。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import FocTransformDemo from '../../../components/FocTransformDemo.astro';
 *   <FocTransformDemo />
 */
import { katexHtml } from '../lib/tex.js';

const PHASES = [
  { key: 'a', name: 'a 相' },
  { key: 'b', name: 'b 相' },
  { key: 'c', name: 'c 相' },
];

const GEOM = {
  wave: { x0: 78, x1: 452, y0: 145, amp: 46 },
  ab: { cx: 165, cy: 352, r: 72 },
  dq: { cx: 345, cy: 406, scale: 84 },
  pwm: { x0: 546, x1: 832, y0: 64, rowGap: 60, barH: 26, barW: 286 },
  carrier: { x0: 546, x1: 862, cy: 330, amp: 34, cycles: 3 },
};

const { wave, ab, dq, pwm, carrier } = GEOM;

// 三角载波路径是静态的，直接在 frontmatter 里算好写进 markup。
const CARRIER_PATH = (() => {
  const step = (carrier.x1 - carrier.x0) / carrier.cycles;
  let d = 'M ' + carrier.x0 + ' ' + (carrier.cy + carrier.amp);
  for (let i = 0; i < carrier.cycles; i++) {
    d += ' L ' + (carrier.x0 + (i + 0.5) * step).toFixed(1) + ' ' + (carrier.cy - carrier.amp);
    d += ' L ' + (carrier.x0 + (i + 1) * step).toFixed(1) + ' ' + (carrier.cy + carrier.amp);
  }
  return d;
})();

const CFG = { phases: PHASES.map((p) => p.key), geom: GEOM };
---

<figure class="foc-demo" data-foc={JSON.stringify(CFG)}>
  <svg viewBox="0 0 900 470" role="img" aria-label="FOC 坐标变换交互演示：三相正弦电流经 Clarke 变换到静止 αβ 坐标，再经 Park 变换到随转子旋转的 dq 坐标，得到近似直流的 i_d 与 i_q">
    <defs>
      <marker id="foc-mk-vec" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="foc-mk-vec" d="M0 0 L10 5 L0 10 Z"></path></marker>
      <marker id="foc-mk-d" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="foc-mk-d" d="M0 0 L10 5 L0 10 Z"></path></marker>
      <marker id="foc-mk-q" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="foc-mk-q" d="M0 0 L10 5 L0 10 Z"></path></marker>
      <marker id="foc-mk-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="foc-mk-a" d="M0 0 L10 5 L0 10 Z"></path></marker>
    </defs>

    <!-- 标题 -->
    <text class="foc-title" x="24" y="26">FOC 坐标变换：三相电流 → αβ → dq</text>
    <text class="foc-title" x="500" y="26">三相逆变器 PWM（示意）</text>

    <!-- 左上：三相电流波形 -->
    <text class="foc-subtitle" x="24" y="54">三相电流（标幺值，一个电周期）</text>
    <text class="foc-legend foc-pha" x="92" y="78">i<tspan class="foc-sub" dy="4">a</tspan></text>
    <text class="foc-legend foc-phb" x="142" y="78">i<tspan class="foc-sub" dy="4">b</tspan></text>
    <text class="foc-legend foc-phc" x="192" y="78">i<tspan class="foc-sub" dy="4">c</tspan></text>

    <line class="foc-axis" x1="78" y1="198" x2="78" y2="98" marker-end="url(#foc-mk-a)"></line>
    <line class="foc-axis" x1="78" y1="145" x2="452" y2="145" marker-end="url(#foc-mk-a)"></line>
    <text class="foc-small" x="72" y="105" text-anchor="end">+1</text>
    <text class="foc-small" x="72" y="151" text-anchor="end">0</text>
    <text class="foc-small" x="72" y="197" text-anchor="end">−1</text>
    <text class="foc-small" x="78" y="216" text-anchor="middle">0°</text>
    <text class="foc-small" x="203" y="216" text-anchor="middle">120°</text>
    <text class="foc-small" x="327" y="216" text-anchor="middle">240°</text>
    <text class="foc-small" x="452" y="216" text-anchor="middle">360°</text>

    {PHASES.map((p) => (
      <path class={'foc-wave foc-wave-' + p.key + ' foc-ph' + p.key} data-wave={p.key} d=""></path>
    ))}
    {PHASES.map((p) => (
      <circle class={'foc-dot foc-ph' + p.key} data-dot={p.key} cx="78" cy="145" r="4.5"></circle>
    ))}
    <line class="foc-cursor" data-role="wave-cursor" x1="78" y1="96" x2="78" y2="198"></line>

    <!-- 左下：静止 αβ 平面 + 旋转 dq 轴 -->
    <text class="foc-subtitle" x="24" y="240">αβ 平面：电流矢量与旋转 dq 轴</text>
    <line class="foc-axis" x1="79" y1="352" x2="251" y2="352" marker-end="url(#foc-mk-a)"></line>
    <line class="foc-axis" x1="165" y1="438" x2="165" y2="266" marker-end="url(#foc-mk-a)"></line>
    <text class="foc-axis-lab" x="100" y="344">α</text>
    <text class="foc-axis-lab" x="172" y="290">β</text>
    <circle class="foc-circle" cx="165" cy="352" r="72"></circle>

    <path class="foc-arc" data-role="theta-arc" d=""></path>
    <text class="foc-arc-lab" data-role="theta-arc-lab" x="165" y="322" text-anchor="middle">θe</text>

    <g class="foc-dq" data-role="dq-group" transform="rotate(0 165 352)">
      <line class="foc-d-axis" x1="81" y1="352" x2="249" y2="352" marker-end="url(#foc-mk-d)"></line>
      <line class="foc-q-axis" x1="165" y1="436" x2="165" y2="268" marker-end="url(#foc-mk-q)"></line>
    </g>
    <text class="foc-dq-lab" data-role="d-lab" x="249" y="357" text-anchor="middle">d</text>
    <text class="foc-dq-lab" data-role="q-lab" x="165" y="273" text-anchor="middle">q</text>

    <line class="foc-proj" data-role="proj-d" x1="165" y1="352" x2="165" y2="352"></line>
    <line class="foc-proj" data-role="proj-q" x1="165" y1="352" x2="165" y2="352"></line>
    <line class="foc-comp-d" data-role="comp-d" x1="165" y1="352" x2="165" y2="352" marker-end="url(#foc-mk-d)"></line>
    <line class="foc-comp-q" data-role="comp-q" x1="165" y1="352" x2="165" y2="352" marker-end="url(#foc-mk-q)"></line>
    <line class="foc-ivec" data-role="ivec" x1="165" y1="352" x2="165" y2="352" marker-end="url(#foc-mk-vec)"></line>
    <circle class="foc-foot" data-role="foot-d" cx="165" cy="352" r="4.5"></circle>
    <circle class="foc-foot" data-role="foot-q" cx="165" cy="352" r="4.5"></circle>

    <!-- 左下右：dq 平面工作点 -->
    <text class="foc-mini-title" x="293" y="292">dq 平面</text>
    <line class="foc-axis" x1="293" y1="406" x2="429" y2="406" marker-end="url(#foc-mk-a)"></line>
    <line class="foc-axis" x1="345" y1="406" x2="345" y2="322" marker-end="url(#foc-mk-a)"></line>
    <text class="foc-axis-lab" x="434" y="412">d</text>
    <text class="foc-axis-lab" x="352" y="330">q</text>
    <line class="foc-guide" data-role="dq-guide-v" x1="345" y1="406" x2="345" y2="406"></line>
    <line class="foc-guide" data-role="dq-guide-h" x1="345" y1="406" x2="345" y2="406"></line>
    <circle class="foc-dq-point" data-role="dq-point" cx="345" cy="406" r="6"></circle>
    <text class="foc-small" x="293" y="430">i_d ≈ 0</text>

    <!-- 右：PWM 占空比条 -->
    <line class="foc-center-line" x1="689" y1="52" x2="689" y2="216"></line>
    <text class="foc-small" x="689" y="46" text-anchor="middle">50%</text>
    <text class="foc-small" x="546" y="232" text-anchor="middle">0</text>
    <text class="foc-small" x="832" y="232" text-anchor="middle">1</text>
    {PHASES.map((p, i) => (
      <g class="foc-row" data-row={p.key}>
        <text class={'foc-row-lab foc-ph' + p.key} x="520" y={pwm.y0 + i * pwm.rowGap + 19} text-anchor="middle">{p.key}</text>
        <rect class="foc-bar-bg" x={pwm.x0} y={pwm.y0 + i * pwm.rowGap} width={pwm.barW} height={pwm.barH} rx="4"></rect>
        <rect class={'foc-bar-fill foc-ph' + p.key} data-duty={p.key} x={pwm.x0} y={pwm.y0 + i * pwm.rowGap} width="143" height={pwm.barH} rx="4"></rect>
        <text class="foc-bar-pct" data-duty-pct={p.key} x="880" y={pwm.y0 + i * pwm.rowGap + 19} text-anchor="end">50%</text>
      </g>
    ))}

    <!-- 右：三角载波与三相参考波 -->
    <text class="foc-subtitle" x="500" y="262">三角载波 vs 三相参考波</text>
    <text class="foc-small" x="538" y="336" text-anchor="end">载波</text>
    <path class="foc-carrier" data-role="carrier" d={CARRIER_PATH}></path>
    {PHASES.map((p) => (
      <line class={'foc-ref foc-ph' + p.key} data-ref={p.key} x1={carrier.x0} y1={carrier.cy} x2={carrier.x1} y2={carrier.cy}></line>
    ))}
    <line class="foc-carrier-cursor" data-role="carrier-cursor" x1={carrier.x0} y1="288" x2={carrier.x0} y2="372"></line>
    {PHASES.map((p) => (
      <circle class={'foc-refdot foc-ph' + p.key} data-refdot={p.key} cx={carrier.x0} cy={carrier.cy} r="4.5"></circle>
    ))}
    <circle class="foc-carrier-dot" data-role="carrier-dot" cx={carrier.x0} cy={carrier.cy} r="5"></circle>

    <text class="foc-note" x="500" y="410">开关 = 参考波 &gt; 载波（PWM）</text>
    <text class="foc-note" x="500" y="438">载波频率 ≫ 基波频率；为看清比较只画 3 个载波周期。</text>
  </svg>

  <div class="foc-controls">
    <button type="button" class="foc-btn foc-play" data-play aria-pressed="true">暂停</button>
    <label class="foc-slider-label">电角度 <span set:html={katexHtml('\\theta_e')}></span>（0–360°）
      <input class="foc-theta" type="range" min="0" max="360" step="1" value="30" />
    </label>
    <label class="foc-slider-label">q 轴电流给定 <span set:html={katexHtml('i_q^{*}')}></span>（0–1）
      <input class="foc-iq" type="range" min="0" max="1" step="0.01" value="0.8" />
    </label>
  </div>

  <div class="foc-readout">
    <output class="foc-out foc-out-values" aria-live="polite"></output>
    <output class="foc-out foc-out-result" aria-live="polite"></output>
  </div>

  <figcaption>
    玩法：拖 <span set:html={katexHtml('\\theta_e')}></span> 让电流矢量转，拖 <span set:html={katexHtml('i_q^{*}')}></span> 改转矩大小。左边是“三根交流 → 两个直流”，右边是 PWM 开关。数值为教学示意。
  </figcaption>
</figure>

<script>
  import { setParts } from '../lib/tex.js';
  import { createVisibleRaf } from '../lib/visible-raf.js';

  document.querySelectorAll('.foc-demo').forEach((demo) => {
    const cfg = JSON.parse(demo.dataset.foc);
    const geom = cfg.geom;
    const keys = cfg.phases;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const waveEl = {};
    const dotEl = {};
    const dutyEl = {};
    const dutyPctEl = {};
    const rowEl = {};
    const refEl = {};
    const refDotEl = {};
    keys.forEach((k) => {
      waveEl[k] = demo.querySelector('[data-wave="' + k + '"]');
      dotEl[k] = demo.querySelector('[data-dot="' + k + '"]');
      dutyEl[k] = demo.querySelector('[data-duty="' + k + '"]');
      dutyPctEl[k] = demo.querySelector('[data-duty-pct="' + k + '"]');
      rowEl[k] = demo.querySelector('[data-row="' + k + '"]');
      refEl[k] = demo.querySelector('[data-ref="' + k + '"]');
      refDotEl[k] = demo.querySelector('[data-refdot="' + k + '"]');
    });

    const waveCursor = demo.querySelector('[data-role="wave-cursor"]');
    const dqGroup = demo.querySelector('[data-role="dq-group"]');
    const dLab = demo.querySelector('[data-role="d-lab"]');
    const qLab = demo.querySelector('[data-role="q-lab"]');
    const ivec = demo.querySelector('[data-role="ivec"]');
    const projD = demo.querySelector('[data-role="proj-d"]');
    const projQ = demo.querySelector('[data-role="proj-q"]');
    const compD = demo.querySelector('[data-role="comp-d"]');
    const compQ = demo.querySelector('[data-role="comp-q"]');
    const footD = demo.querySelector('[data-role="foot-d"]');
    const footQ = demo.querySelector('[data-role="foot-q"]');
    const thetaArc = demo.querySelector('[data-role="theta-arc"]');
    const thetaArcLab = demo.querySelector('[data-role="theta-arc-lab"]');
    const dqPoint = demo.querySelector('[data-role="dq-point"]');
    const dqGuideV = demo.querySelector('[data-role="dq-guide-v"]');
    const dqGuideH = demo.querySelector('[data-role="dq-guide-h"]');
    const carrierCursor = demo.querySelector('[data-role="carrier-cursor"]');
    const carrierDot = demo.querySelector('[data-role="carrier-dot"]');
    const outValues = demo.querySelector('.foc-out-values');
    const outResult = demo.querySelector('.foc-out-result');
    const playBtn = demo.querySelector('.foc-play');
    const thetaSlider = demo.querySelector('.foc-theta');
    const iqSlider = demo.querySelector('.foc-iq');

    const R3 = Math.sqrt(3) / 2;
    const SQ3 = Math.sqrt(3);
    const RAD = Math.PI / 180;

    let theta = Number(thetaSlider.value);
    let iq = Number(iqSlider.value);
    let playing = !reduced;
    const loop = createVisibleRaf(demo);
    let last = 0;
    let lastText = 0;

    // 三相电流 + αβ 分量（教学示意模型，幅值随 i_q* 变化）
    const phasors = (rad) => {
      const sin = Math.sin(rad);
      const cos = Math.cos(rad);
      const alpha = -iq * sin;
      const beta = iq * cos;
      return {
        sin,
        cos,
        alpha,
        beta,
        ia: alpha,
        ib: -0.5 * alpha + R3 * beta,
        ic: -0.5 * alpha - R3 * beta,
      };
    };

    // Clarke + Park：验证 i_d ≈ 0、i_q = i_q*
    const solve = (deg) => {
      const p = phasors(deg * RAD);
      const alphaC = (2 / 3) * (p.ia - 0.5 * p.ib - 0.5 * p.ic);
      const betaC = (1 / SQ3) * (p.ib - p.ic);
      let id = alphaC * p.cos + betaC * p.sin;
      const iqOut = -alphaC * p.sin + betaC * p.cos;
      if (Math.abs(id) < 5e-3) id = 0;
      return Object.assign({}, p, { alphaC: alphaC, betaC: betaC, id: id, iqOut: iqOut });
    };

    // 一个电周期的三相波形；只在 i_q* 改变时重算
    const drawWaves = () => {
      const w = geom.wave;
      keys.forEach((k) => {
        let d = '';
        for (let deg = 0; deg <= 360; deg += 3) {
          const p = phasors(deg * RAD);
          const v = k === 'a' ? p.ia : (k === 'b' ? p.ib : p.ic);
          const x = w.x0 + (deg / 360) * (w.x1 - w.x0);
          const y = w.y0 - v * w.amp;
          d += (d ? ' L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1);
        }
        waveEl[k].setAttribute('d', d);
      });
    };

    const carrierValue = (deg) => {
      const u = (deg / 360) * geom.carrier.cycles;
      const local = u - Math.floor(u);
      return local < 0.5 ? -1 + 4 * local : 3 - 4 * local;
    };

    const draw = () => {
      const w = geom.wave;
      const a = geom.ab;
      const q = geom.dq;
      const c = geom.carrier;
      const sol = solve(theta);

      // 波形游标 + 三相取样点
      const wx = w.x0 + (theta / 360) * (w.x1 - w.x0);
      waveCursor.setAttribute('x1', wx.toFixed(1));
      waveCursor.setAttribute('x2', wx.toFixed(1));
      keys.forEach((k) => {
        const v = k === 'a' ? sol.ia : (k === 'b' ? sol.ib : sol.ic);
        dotEl[k].setAttribute('cx', wx.toFixed(1));
        dotEl[k].setAttribute('cy', (w.y0 - v * w.amp).toFixed(1));
      });

      // 随转子旋转的 d/q 轴（负号：SVG 的 y 轴朝下）
      dqGroup.setAttribute('transform', 'rotate(' + (-theta).toFixed(1) + ' ' + a.cx + ' ' + a.cy + ')');
      const lr = a.r + 12;
      dLab.setAttribute('x', (a.cx + lr * sol.cos).toFixed(1));
      dLab.setAttribute('y', (a.cy - lr * sol.sin + 6).toFixed(1));
      qLab.setAttribute('x', (a.cx - lr * sol.sin).toFixed(1));
      qLab.setAttribute('y', (a.cy - lr * sol.cos + 6).toFixed(1));

      // 电流矢量
      const tx = a.cx + a.r * sol.alpha;
      const ty = a.cy - a.r * sol.beta;
      ivec.setAttribute('x2', tx.toFixed(1));
      ivec.setAttribute('y2', ty.toFixed(1));

      // 矢量在 d/q 轴上的投影与应用
      const fdx = a.cx + a.r * sol.id * sol.cos;
      const fdy = a.cy - a.r * sol.id * sol.sin;
      const fqx = a.cx - a.r * sol.iqOut * sol.sin;
      const fqy = a.cy - a.r * sol.iqOut * sol.cos;
      projD.setAttribute('x1', tx.toFixed(1));
      projD.setAttribute('y1', ty.toFixed(1));
      projD.setAttribute('x2', fdx.toFixed(1));
      projD.setAttribute('y2', fdy.toFixed(1));
      projQ.setAttribute('x1', tx.toFixed(1));
      projQ.setAttribute('y1', ty.toFixed(1));
      projQ.setAttribute('x2', fqx.toFixed(1));
      projQ.setAttribute('y2', fqy.toFixed(1));
      compD.setAttribute('x2', fdx.toFixed(1));
      compD.setAttribute('y2', fdy.toFixed(1));
      compQ.setAttribute('x2', fqx.toFixed(1));
      compQ.setAttribute('y2', fqy.toFixed(1));
      footD.setAttribute('cx', fdx.toFixed(1));
      footD.setAttribute('cy', fdy.toFixed(1));
      footQ.setAttribute('cx', fqx.toFixed(1));
      footQ.setAttribute('cy', fqy.toFixed(1));
      compD.classList.toggle('foc-hidden', Math.abs(sol.id) * a.r < 1.5);
      compQ.classList.toggle('foc-hidden', Math.abs(sol.iqOut) * a.r < 1.5);

      // θe 角弧
      const ar = 30;
      if (theta > 2 && theta < 358) {
        thetaArc.classList.remove('foc-hidden');
        thetaArcLab.classList.remove('foc-hidden');
        const ex = a.cx + ar * sol.cos;
        const ey = a.cy - ar * sol.sin;
        thetaArc.setAttribute('d', 'M ' + (a.cx + ar) + ' ' + a.cy + ' A ' + ar + ' ' + ar + ' 0 ' + (theta > 180 ? 1 : 0) + ' 0 ' + ex.toFixed(1) + ' ' + ey.toFixed(1));
        const mid = (theta / 2) * RAD;
        thetaArcLab.setAttribute('x', (a.cx + (ar + 16) * Math.cos(mid)).toFixed(1));
        thetaArcLab.setAttribute('y', (a.cy - (ar + 16) * Math.sin(mid) + 5).toFixed(1));
      } else {
        thetaArc.classList.add('foc-hidden');
        thetaArcLab.classList.add('foc-hidden');
      }

      // dq 平面工作点（不随 θe 走动 = 直流量）
      const px = q.cx + q.scale * sol.id;
      const py = q.cy - q.scale * sol.iqOut;
      dqPoint.setAttribute('cx', px.toFixed(1));
      dqPoint.setAttribute('cy', py.toFixed(1));
      dqGuideV.setAttribute('x1', px.toFixed(1));
      dqGuideV.setAttribute('y1', py.toFixed(1));
      dqGuideV.setAttribute('x2', px.toFixed(1));
      dqGuideV.setAttribute('y2', q.cy.toFixed(1));
      dqGuideH.setAttribute('x1', px.toFixed(1));
      dqGuideH.setAttribute('y1', py.toFixed(1));
      dqGuideH.setAttribute('x2', q.cx.toFixed(1));
      dqGuideH.setAttribute('y2', py.toFixed(1));

      // PWM：占空比条 + 载波游标 + 参考波比较
      const car = carrierValue(theta);
      const cx2 = c.x0 + (theta / 360) * (c.x1 - c.x0);
      const barW = geom.pwm.x1 - geom.pwm.x0;
      carrierCursor.setAttribute('x1', cx2.toFixed(1));
      carrierCursor.setAttribute('x2', cx2.toFixed(1));
      carrierDot.setAttribute('cx', cx2.toFixed(1));
      carrierDot.setAttribute('cy', (c.cy - c.amp * car).toFixed(1));
      keys.forEach((k) => {
        const m = k === 'a' ? sol.ia : (k === 'b' ? sol.ib : sol.ic);
        const duty = Math.max(0, Math.min(1, 0.5 + 0.5 * m));
        dutyEl[k].setAttribute('width', (duty * barW).toFixed(1));
        dutyPctEl[k].textContent = Math.round(duty * 100) + '%';
        const ry = c.cy - c.amp * m;
        refEl[k].setAttribute('y1', ry.toFixed(1));
        refEl[k].setAttribute('y2', ry.toFixed(1));
        refDotEl[k].setAttribute('cx', cx2.toFixed(1));
        refDotEl[k].setAttribute('cy', ry.toFixed(1));
        rowEl[k].classList.toggle('foc-on', m > car);
      });
    };

    const f2 = (v) => (Math.abs(v) < 0.005 ? '0.00' : v.toFixed(2));

    const updateReadout = () => {
      const sol = solve(theta);
      setParts(outValues, [
        { tex: '\\theta_e = ' + theta.toFixed(0) + '^\\circ' },
        { text: '　三相电流（标幺值）' },
        { tex: 'i_a = ' + f2(sol.ia) + ',\\ i_b = ' + f2(sol.ib) + ',\\ i_c = ' + f2(sol.ic) },
      ]);
      setParts(outResult, [
        { text: '经 Clarke/Park 得 ' },
        { tex: 'i_d = ' + f2(sol.id) + '\\ (\\approx 0)' },
        { text: '、' },
        { tex: 'i_q = ' + f2(sol.iqOut) + ' = i_q^{*}' },
        { text: '：三相交流电流在 dq 里变成了两个直流量。' },
      ]);
    };

    const render = () => {
      draw();
      updateReadout();
    };

    const setPlayLabel = () => {
      playBtn.textContent = playing ? '暂停' : '播放';
      playBtn.setAttribute('aria-pressed', String(playing));
    };

    const stop = () => {
      loop.stop();
      last = 0;
    };

    loop.onFrame((ts) => {
      if (!last) { last = ts; lastText = ts; }
      const dt = Math.min((ts - last) / 1000, 0.05);
      last = ts;
      theta = (theta + 90 * dt) % 360;
      thetaSlider.value = theta.toFixed(1);
      draw();
      if (ts - lastText >= 90) {
        lastText = ts;
        updateReadout();
      }
    });

    const start = () => {
      last = 0;
      loop.start();
    };

    playBtn.addEventListener('click', () => {
      playing = !playing;
      if (playing) start(); else stop();
      setPlayLabel();
      render();
    });

    thetaSlider.addEventListener('input', () => {
      theta = Number(thetaSlider.value);
      playing = false;
      stop();
      setPlayLabel();
      render();
    });

    iqSlider.addEventListener('input', () => {
      iq = Number(iqSlider.value);
      drawWaves();
      render();
    });

    drawWaves();
    setPlayLabel();
    render();
    if (playing) start();
  });
</script>

