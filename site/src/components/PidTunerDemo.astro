---
/**
 * 4.5 用：单关节 PID 阶跃响应调参台 —— “### 参数整定”之后。
 *
 * 页面里真算一个单关节被控对象（教学近似，不代表真机参数）：
 *   I·q̈ + b·q̇ = τ_cmd − τ_load，  τ_load = 重力矩 + 可选扰动
 *   τ_cmd = kp·e + ki·∫e dt + kd·(0 − q̇)，  输出限幅 ±τ_limit
 *   e = q_des − q
 * 抗饱和（Anti-Windup）：输出饱和时不累积积分；关掉后可以看到积分饱和造成的超调。
 *
 * 默认参数（在 Node 里逐组验证过，三个现象清晰可见）：
 *   只给 P（kp=40, ki=0, kd=0）：稳态误差 0.35 rad；
 *   加 I （kp=40, ki=120, kd=0）：静差归零；关抗饱和 → 超调约 30%，开抗饱和 → ≈0；
 *   加 D （kp=40, ki=120, kd=2）：关抗饱和的超调从 30% 降到 9%。
 * 被控对象 I=0.05 kg·m²、b=0.5 N·m·s/rad、重力矩 10 N·m、限幅 15 N·m 均为教学示意，
 * 量级参考 G1 膝关节，不等同任何一台真机的辨识结果。
 */

const PRESETS = [
  { id: 'p', label: '只给 P', kp: 40, ki: 0, kd: 0 },
  { id: 'pi', label: 'P + I', kp: 40, ki: 120, kd: 0 },
  { id: 'pid', label: 'P + I + D', kp: 40, ki: 120, kd: 2 },
];

const CFG = {
  kp: 40,
  ki: 120,
  kd: 2,
  inertia: 0.05,
  damping: 0.5,
  load: 10,
  limit: 15,
  target: 1.0,
  duration: 5.0,
  distAt: 2.5,
  dist: 4,
  band: 0.03,
  presets: PRESETS,
};
---

<figure class="pid-demo" data-pid={JSON.stringify(CFG)}>
  <svg viewBox="0 0 980 360" role="img" aria-label="单关节 PID 调参台：一条时间轴显示关节角从 0 到目标 1 弧度的阶跃响应，另一条显示控制力矩与输出限幅；拖动 kp、ki、kd 滑块或选择预设，观察稳态误差、超调和积分饱和">
    <text class="pid-title" x="24" y="26">单关节 PID 调参台：同一台关节，换一组增益</text>
    <text class="pid-legend" x="24" y="44">灰虚线 = 目标　蓝线 = 关节角　橙色阴影 = 输出饱和　灰竖线 = 扰动注入</text>

    <text class="pid-lane-name" x="120" y="86" text-anchor="end">关节角</text>
    <text class="pid-lane-sub" x="120" y="104" text-anchor="end">单位 rad</text>
    <text class="pid-lane-name" x="120" y="222" text-anchor="end">控制力矩</text>
    <text class="pid-lane-sub" x="120" y="240" text-anchor="end">单位 N·m</text>

    <g clip-path="url(#pid-clip)">
      <rect class="pid-satband" data-pid-satband="0" x="130" y="60" width="810" height="0"></rect>
      <rect class="pid-satband" data-pid-satband="1" x="130" y="196" width="810" height="0"></rect>
      <line class="pid-grid" x1="130" y1="60" x2="940" y2="60"></line>
      <line class="pid-grid" x1="130" y1="160" x2="940" y2="160"></line>
      <line class="pid-grid" x1="130" y1="196" x2="940" y2="196"></line>
      <line class="pid-grid" x1="130" y1="296" x2="940" y2="296"></line>
      <line class="pid-limit" data-pid-limit="top" x1="130" y1="0" x2="940" y2="0"></line>
      <line class="pid-limit" data-pid-limit="bot" x1="130" y1="0" x2="940" y2="0"></line>
      <line class="pid-zero" x1="130" y1="296" x2="940" y2="296"></line>
      <line class="pid-dist" data-pid-dist x1="0" y1="60" x2="0" y2="296"></line>
      <path class="pid-target" data-pid-target d=""></path>
      <path class="pid-angle" data-pid-angle d=""></path>
      <path class="pid-torque" data-pid-torque d=""></path>
    </g>
    <rect class="pid-lane-box" x="130" y="60" width="810" height="100"></rect>
    <rect class="pid-lane-box" x="130" y="196" width="810" height="100"></rect>
    <line class="pid-axis" x1="130" y1="296" x2="940" y2="296"></line>
    <text class="pid-axis-label" data-pid-t="0" x="130" y="316" text-anchor="start">0 s</text>
    <text class="pid-axis-label" data-pid-t="1" x="535" y="316" text-anchor="middle">2.5 s</text>
    <text class="pid-axis-label" data-pid-t="2" x="940" y="316" text-anchor="end">5 s</text>
    <text class="pid-scale" data-pid-scale-angle x="940" y="54" text-anchor="end">角 0–1.25 rad</text>
    <text class="pid-scale" data-pid-scale-torque x="940" y="336" text-anchor="end">力矩 ±20 N·m，限幅 ±15</text>
  </svg>

  <div class="pid-controls">
    <div class="pid-row">
      <span class="pid-row-title">增益</span>
      <label class="pid-slider"><span class="pid-k">kp</span><input class="pid-range" type="range" data-pid-gain="kp" min="0" max="200" step="5" value="40" /><span class="pid-v" data-pid-v="kp">40</span></label>
      <label class="pid-slider"><span class="pid-k">ki</span><input class="pid-range" type="range" data-pid-gain="ki" min="0" max="400" step="10" value="120" /><span class="pid-v" data-pid-v="ki">120</span></label>
      <label class="pid-slider"><span class="pid-k">kd</span><input class="pid-range" type="range" data-pid-gain="kd" min="0" max="8" step="0.5" value="2" /><span class="pid-v" data-pid-v="kd">2.0</span></label>
    </div>
    <div class="pid-row">
      <span class="pid-row-title">预设</span>
      {PRESETS.map((p) => (<button type="button" class="pid-btn" data-pid-preset={p.id}>{p.label}</button>))}
      <span class="pid-hint">点预设会同时改增益并立即重跑</span>
    </div>
    <div class="pid-row">
      <span class="pid-row-title">开关</span>
      <button type="button" class="pid-btn" data-pid-aw>抗积分饱和：开</button>
      <button type="button" class="pid-btn" data-pid-distbtn>注入扰动</button>
      <button type="button" class="pid-btn" data-pid-pause>暂停</button>
      <button type="button" class="pid-btn" data-pid-reset>复位</button>
    </div>
  </div>

  <div class="pid-readout">
    <div class="pid-metrics">
      <div class="pid-metric"><span class="pid-metric-k">稳态误差</span><span class="pid-metric-v" data-pid-metric="ss">—</span></div>
      <div class="pid-metric"><span class="pid-metric-k">超调</span><span class="pid-metric-v" data-pid-metric="ov">—</span></div>
      <div class="pid-metric"><span class="pid-metric-k">饱和时长</span><span class="pid-metric-v" data-pid-metric="sat">—</span></div>
      <div class="pid-metric"><span class="pid-metric-k">进入 ±3% 时刻</span><span class="pid-metric-v" data-pid-metric="settle">—</span></div>
    </div>
    <div class="pid-state" data-pid-state>就绪</div>
  </div>
</figure>
<script>
(function () {
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  document.querySelectorAll(".pid-demo").forEach((demo) => {
    if (!(demo instanceof HTMLElement)) return;
    const cfg = JSON.parse(demo.dataset.pid || "{}");
    const CFG = {
      kp: cfg.kp != null ? cfg.kp : 40,
      ki: cfg.ki != null ? cfg.ki : 120,
      kd: cfg.kd != null ? cfg.kd : 2,
      inertia: cfg.inertia != null ? cfg.inertia : 0.05,
      damping: cfg.damping != null ? cfg.damping : 0.5,
      load: cfg.load != null ? cfg.load : 10,
      limit: cfg.limit != null ? cfg.limit : 15,
      target: cfg.target != null ? cfg.target : 1.0,
      duration: cfg.duration != null ? cfg.duration : 5,
      distAt: cfg.distAt != null ? cfg.distAt : 2.5,
      dist: cfg.dist != null ? cfg.dist : 4,
      band: cfg.band != null ? cfg.band : 0.03,
      presets: cfg.presets || [],
    };

    const pick = (name) => demo.querySelector("[data-pid-" + name + "]");
    const gains = { kp: CFG.kp, ki: CFG.ki, kd: CFG.kd };
    let aw = true;
    let paused = false;
    let disturb = false;

    const sliderEls = {};
    const valEls = {};
    ["kp", "ki", "kd"].forEach((k) => {
      sliderEls[k] = demo.querySelector("[data-pid-gain='" + k + "']");
      valEls[k] = demo.querySelector("[data-pid-v='" + k + "']");
    });
    const awBtn = pick("aw");
    const distBtn = pick("distbtn");
    const pauseBtn = pick("pause");
    const resetBtn = pick("reset");
    const stateEl = pick("state");
    const metric = { ss: pick("metric='ss'"), ov: pick("metric='ov'"), sat: pick("metric='sat'"), settle: pick("metric='settle'") };
    const pathTarget = pick("target");
    const pathAngle = pick("angle");
    const pathTorque = pick("torque");
    const satBand0 = pick("satband='0'");
    const satBand1 = pick("satband='1'");
    const distLine = pick("dist");
    const limitTop = pick("limit='top'");
    const limitBot = pick("limit='bot'");
    if (!sliderEls.kp || !awBtn) return;

    // 画布几何：上泳道 0–1.25 rad，下泳道 ±20 N·m（限幅 ±15）
    const X0 = 130;
    const X1 = 940;
    const W = X1 - X0;
    const ANGLE = { top: 60, h: 100, min: 0, max: 1.25 };
    const TORQUE = { top: 196, h: 100, min: -20, max: 20 };
    const DT = 0.001;

    const project = (t, value, lane) => {
      const x = X0 + W * (t / CFG.duration);
      const y = lane.top + lane.h - (value - lane.min) / (lane.max - lane.min) * lane.h;
      return [x, y];
    };

    const buildPath = (samples, lane, key, limit) => {
      let d = "";
      for (const s of samples) {
        const p = project(s.t, s[key], lane);
        const y = clamp(p[1], lane.top - 6, lane.top + lane.h + 6);
        d += (d ? " L " : "M ") + p[0].toFixed(1) + " " + y.toFixed(1);
      }
      return d;
    };

    // 一次完整仿真：返回采样点与指标
    const simulate = () => {
      let q = 0, dq = 0, integ = 0, satTime = 0, peak = 0, settle = null;
      const samples = [];
      const steps = Math.round(CFG.duration / DT);
      for (let k = 0; k < steps; k += 1) {
        const t = k * DT;
        const e = CFG.target - q;
        const raw = gains.kp * e + gains.ki * integ - gains.kd * dq;
        const tau = clamp(raw, -CFG.limit, CFG.limit);
        const satNow = Math.abs(raw) > CFG.limit;
        if (satNow) satTime += DT;
        if (!(aw && satNow)) integ += e * DT;
        integ = clamp(integ, -10, 10);
        const loadT = CFG.load + (disturb && t > CFG.distAt ? CFG.dist : 0);
        dq += (tau - CFG.damping * dq - loadT) / CFG.inertia * DT;
        q += dq * DT;
        if (q > peak) peak = q;
        if (t > 0.15 && Math.abs(CFG.target - q) > CFG.band) settle = null;
        else if (settle === null && t > 0.15) settle = t;
        if (k % 5 === 0) samples.push({ t: t, q: q, tau: tau, sat: satNow });
      }
      return {
        samples: samples,
        ssErr: CFG.target - q,
        overshoot: (peak - CFG.target) / CFG.target * 100,
        satTime: satTime,
        settle: settle,
      };
    };

    let result = simulate();
    let playT = 0;
    let autoHold = 0;
    let lastNow = 0;
    let raf = 0;

    const sliceUpTo = (t) => {
      const out = [];
      for (const s of result.samples) { if (s.t <= t) out.push(s); else break; }
      return out;
    };

    const renderSaturation = (t) => {
      // 把饱和区间画成橙色阴影条（简化：按采样点检测连续段）
      let bands = [];
      let start = null;
      for (const s of result.samples) {
        if (s.t > t) break;
        if (s.sat && start === null) start = s.t;
        else if (!s.sat && start !== null) { bands.push([start, s.t]); start = null; }
      }
      if (start !== null) bands.push([start, t]);
      const rect0 = satBand0, rect1 = satBand1;
      if (!rect0 || !rect1) return;
      if (bands.length === 0) {
        rect0.setAttribute("height", "0");
        rect1.setAttribute("height", "0");
        return;
      }
      // 只显示最长的一段，避免闪烁
      let best = bands[0];
      for (const b of bands) if (b[1] - b[0] > best[1] - best[0]) best = b;
      const x0 = project(best[0], 0, ANGLE)[0];
      const x1 = project(best[1], 0, ANGLE)[0];
      rect0.setAttribute("x", x0.toFixed(1));
      rect0.setAttribute("y", String(ANGLE.top));
      rect0.setAttribute("width", Math.max(0, x1 - x0).toFixed(1));
      rect0.setAttribute("height", String(ANGLE.h));
      rect1.setAttribute("x", x0.toFixed(1));
      rect1.setAttribute("y", String(TORQUE.top));
      rect1.setAttribute("width", Math.max(0, x1 - x0).toFixed(1));
      rect1.setAttribute("height", String(TORQUE.h));
    };

    const setPath = (el, d) => { if (el) el.setAttribute("d", d); };

    const render = (t, live) => {
      const upTo = live ? sliceUpTo(t) : result.samples;
      setPath(pathTarget, "M " + X0 + " " + project(0, CFG.target, ANGLE)[1].toFixed(1) + " L " + X1 + " " + project(0, CFG.target, ANGLE)[1].toFixed(1));
      setPath(pathAngle, buildPath(upTo, ANGLE, "q"));
      setPath(pathTorque, buildPath(upTo, TORQUE, "tau"));
      // 限幅线
      const yTop = project(0, CFG.limit, TORQUE)[1];
      const yBot = project(0, -CFG.limit, TORQUE)[1];
      if (limitTop) { limitTop.setAttribute("y1", yTop.toFixed(1)); limitTop.setAttribute("y2", yTop.toFixed(1)); }
      if (limitBot) { limitBot.setAttribute("y1", yBot.toFixed(1)); limitBot.setAttribute("y2", yBot.toFixed(1)); }
      // 扰动竖线
      if (distLine) {
        if (disturb) {
          const xd = project(CFG.distAt, 0, ANGLE)[0];
          distLine.setAttribute("x1", xd.toFixed(1));
          distLine.setAttribute("x2", xd.toFixed(1));
          distLine.setAttribute("opacity", live && t < CFG.distAt ? "0.25" : "0.8");
        } else {
          distLine.setAttribute("opacity", "0");
        }
      }
      renderSaturation(live ? t : CFG.duration);
    };

    const fmt = (v, digits) => (v == null || !isFinite(v) ? "—" : (v < 0 ? "−" : "") + Math.abs(v).toFixed(digits));
    const paintMetrics = (metrics) => {
      if (metric.ss) metric.ss.textContent = fmt(metrics.ssErr, 3) + " rad";
      if (metric.ov) metric.ov.textContent = fmt(metrics.overshoot, 1) + " %";
      if (metric.sat) metric.sat.textContent = fmt(metrics.satTime, 2) + " s";
      if (metric.settle) metric.settle.textContent = metrics.settle == null ? "未进入" : fmt(metrics.settle, 2) + " s";
    };

    const setState = (text, kind) => {
      if (!stateEl) return;
      stateEl.textContent = text;
      stateEl.className = "pid-state" + (kind ? " pid-state-" + kind : "");
    };

    const restart = (hold) => {
      result = simulate();
      playT = 0;
      autoHold = hold ? 0.9 : 0;
      lastNow = 0;
      paintMetrics({ ssErr: result.ssErr, overshoot: result.overshoot, satTime: 0, settle: null });
      render(0, true);
    };

    const tick = (now) => {
      raf = requestAnimationFrame(tick);
      if (paused) { lastNow = now; return; }
      if (!lastNow) lastNow = now;
      let dt = (now - lastNow) / 1000;
      lastNow = now;
      dt = clamp(dt, 0.001, 0.05);
      if (autoHold > 0) { autoHold -= dt; render(0, true); return; }
      if (playT >= CFG.duration) { autoHold = 1.2; playT = CFG.duration; render(playT, false); paintMetrics(result); return; }
      playT = Math.min(CFG.duration, playT + dt);
      render(playT, true);
      if (playT >= CFG.duration) {
        paintMetrics(result);
        if (Math.abs(result.ssErr) > 0.01) setState("稳态误差 " + fmt(result.ssErr, 3) + " rad：纯 P 撑不住负载，需要 I 或前馈", "warn");
        else if (result.overshoot > 15) setState("超调 " + fmt(result.overshoot, 1) + " %：积分饱和在作怪，试试打开抗积分饱和或加 kd", "warn");
        else setState("响应平稳：静差 " + fmt(result.ssErr, 3) + " rad、超调 " + fmt(result.overshoot, 1) + " %", "ok");
      }
    };

    const syncGainInputs = () => {
      ["kp", "ki", "kd"].forEach((k) => {
        if (sliderEls[k] instanceof HTMLInputElement) sliderEls[k].value = String(gains[k]);
        if (valEls[k]) valEls[k].textContent = k === "kd" ? gains[k].toFixed(1) : String(gains[k]);
      });
    };

    ["kp", "ki", "kd"].forEach((k) => {
      const el = sliderEls[k];
      if (!(el instanceof HTMLInputElement)) return;
      el.addEventListener("input", () => {
        gains[k] = Number(el.value);
        if (valEls[k]) valEls[k].textContent = k === "kd" ? gains[k].toFixed(1) : String(gains[k]);
        restart(false);
      });
    });
    demo.querySelectorAll("[data-pid-preset]").forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return;
      btn.addEventListener("click", () => {
        const p = CFG.presets.find((x) => x.id === btn.dataset.pidPreset);
        if (!p) return;
        gains.kp = p.kp; gains.ki = p.ki; gains.kd = p.kd;
        syncGainInputs();
        restart(false);
      });
    });
    if (awBtn instanceof HTMLButtonElement) {
      awBtn.addEventListener("click", () => {
        aw = !aw;
        awBtn.textContent = "抗积分饱和：" + (aw ? "开" : "关");
        awBtn.classList.toggle("pid-btn-warn", !aw);
        restart(false);
      });
    }
    if (distBtn instanceof HTMLButtonElement) {
      distBtn.addEventListener("click", () => {
        disturb = !disturb;
        distBtn.textContent = disturb ? "移除扰动" : "注入扰动";
        distBtn.classList.toggle("pid-btn-warn", disturb);
        restart(false);
      });
    }
    if (pauseBtn instanceof HTMLButtonElement) {
      pauseBtn.addEventListener("click", () => {
        paused = !paused;
        pauseBtn.textContent = paused ? "继续" : "暂停";
        lastNow = 0;
      });
    }
    if (resetBtn instanceof HTMLButtonElement) {
      resetBtn.addEventListener("click", () => { restart(false); setState("已复位，重新跑一遍阶跃", ""); });
    }

    syncGainInputs();
    restart(false);
    setState("拖动滑块或点预设：每一步都会立即重跑这条阶跃", "");
    raf = requestAnimationFrame(tick);
  });
})();
</script>

<style is:global>
  .pid-demo { margin: 1.5rem 0; }
  .pid-demo svg { display: block; width: 100%; max-width: 980px; height: auto; margin: 0 auto; }
  .pid-title { fill: var(--sl-color-text); font-size: 22px; font-weight: 600; }
  .pid-legend { fill: var(--sl-color-gray-2); font-size: 15px; }
  .pid-lane-name { fill: var(--sl-color-text); font-size: 16px; font-weight: 600; }
  .pid-lane-sub, .pid-scale { fill: var(--sl-color-gray-3); font-size: 13px; }
  .pid-lane-box { fill: none; stroke: var(--sl-color-gray-5); stroke-width: 1; opacity: 0.45; }
  .pid-grid { stroke: var(--sl-color-gray-5); stroke-width: 1; opacity: 0.3; }
  .pid-zero { stroke: var(--sl-color-gray-4); stroke-width: 1; stroke-dasharray: 4 4; opacity: 0.5; }
  .pid-axis { stroke: var(--sl-color-gray-4); stroke-width: 1.2; }
  .pid-axis-label { fill: var(--sl-color-gray-2); font-size: 14px; }
  .pid-satband { fill: light-dark(#f59e0b, #fbbf24); opacity: 0.13; }
  .pid-limit { stroke: light-dark(#dc2626, #f87171); stroke-width: 1; stroke-dasharray: 5 4; opacity: 0.55; }
  .pid-dist { stroke: var(--sl-color-gray-3); stroke-width: 1; stroke-dasharray: 3 3; }
  .pid-target { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 1.8; stroke-dasharray: 6 5; }
  .pid-angle { fill: none; stroke: var(--sl-color-accent); stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .pid-torque { fill: none; stroke: light-dark(#0e7490, #22d3ee); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }

  .pid-controls { display: flex; flex-direction: column; gap: 0.5rem; max-width: 980px; margin: 0.6rem auto 0; }
  .pid-row { display: flex; align-items: center; gap: 0.6rem; margin: 0; flex-wrap: wrap; }
  .pid-row-title { flex: 0 0 3rem; margin: 0; color: var(--sl-color-gray-2); font-size: 0.8125rem; }
  .pid-slider { display: flex; flex: 1 1 12rem; min-width: 0; align-items: center; gap: 0.35rem; margin: 0; }
  .pid-k { flex: 0 0 1.6rem; color: var(--sl-color-gray-2); font-size: 0.8125rem; font-weight: 600; }
  .pid-range { flex: 1 1 auto; min-width: 4rem; margin: 0; accent-color: var(--sl-color-accent); }
  .pid-v { flex: 0 0 3rem; text-align: right; color: var(--sl-color-accent); font-weight: 600; font-variant-numeric: tabular-nums; font-size: 0.875rem; }
