---
/**
 * LowCmd / LowState 源码节选卡片：逐字摘自 unitree_sdk2 固定提交
 * （9754cd153af3da471b0fe5f3aa535e426fb11db3）的消息定义与官方 G1 低层示例，
 * 保留原文件行号；正文提到的字段行高亮并附中文注释标签，其余行压暗。
 * 纯 HTML + CSS，无 JS 依赖。
 *
 * 使用方式（仅限 .mdx 小节）：
 *   import LowCmdLowStateSnippet from '../../../components/LowCmdLowStateSnippet.astro';
 *   <LowCmdLowStateSnippet />
 */

const COMMIT = '9754cd153af3da471b0fe5f3aa535e426fb11db3';
const src = (file, line) => `https://github.com/unitreerobotics/unitree_sdk2/blob/${COMMIT}/${file}#L${line}`;

const cards = [
  {
    role: '下发 · 消息定义',
    file: 'include/unitree/idl/hg/LowCmd_.hpp',
    anchor: 23,
    lines: [
      { n: 23, code: 'class LowCmd_' },
      { n: 26, code: ' uint8_t mode_pr_ = 0;' },
      { n: 27, code: ' uint8_t mode_machine_ = 0;' },
      { n: 28, code: ' std::array<::unitree_hg::msg::dds_::MotorCmd_, 35> motor_cmd_ = { };', hl: true, ann: '逐关节指令数组' },
      { n: 29, code: ' std::array<uint32_t, 4> reserve_ = { };' },
      { n: 30, code: ' uint32_t crc_ = 0;' },
    ],
  },
  {
    role: '下发 · 单个关节的指令字段',
    file: 'include/unitree/idl/hg/MotorCmd_.hpp',
    anchor: 20,
    lines: [
      { n: 20, code: 'class MotorCmd_' },
      { n: 23, code: ' uint8_t mode_ = 0;', ann: '使能模式' },
      { n: 24, code: ' float q_ = 0.0f;', hl: true, ann: '目标位置' },
      { n: 25, code: ' float dq_ = 0.0f;', hl: true, ann: '目标速度' },
      { n: 26, code: ' float tau_ = 0.0f;', hl: true, ann: '前馈力矩' },
      { n: 27, code: ' float kp_ = 0.0f;', hl: true, ann: '位置增益' },
      { n: 28, code: ' float kd_ = 0.0f;', hl: true, ann: '速度增益' },
      { n: 29, code: ' uint32_t reserve_ = 0;' },
    ],
  },
  {
    role: '回报 · 消息定义',
    file: 'include/unitree/idl/hg/LowState_.hpp',
    anchor: 25,
    lines: [
      { n: 25, code: 'class LowState_' },
      { n: 31, code: ' uint32_t tick_ = 0;', ann: '时间戳' },
      { n: 32, code: ' ::unitree_hg::msg::dds_::IMUState_ imu_state_;', hl: true, ann: 'IMU 数据' },
      { n: 33, code: ' std::array<::unitree_hg::msg::dds_::MotorState_, 35> motor_state_ = { };', hl: true, ann: '电机状态回报' },
      { n: 36, code: ' uint32_t crc_ = 0;' },
    ],
  },
  {
    role: '官方低层示例 · 控制线程',
    file: 'example/g1/low_level/g1_ankle_swing_example.cpp',
    anchor: 175,
    lines: [
      { n: 175, code: '        control_dt_(0.002),', hl: true, ann: '2 ms 控制周期（500 Hz）' },
      { n: 284, code: ' void LowCommandWriter() {' },
      { n: 292, code: '        dds_low_command.motor_cmd().at(i).mode() = 1;  // 1:Enable, 0:Disable' },
      { n: 294, code: '        dds_low_command.motor_cmd().at(i).q() = mc->q_target.at(i);' },
      { n: 301, code: '      lowcmd_publisher_->Write(dds_low_command);', hl: true, ann: '发布到 rt/lowcmd' },
    ],
  },
];
---

<figure class="lc-snippet">
  {cards.map((card) => (
    <div class="lc-card">
      <div class="lc-card-head">
        <span class="lc-role">{card.role}</span>
        <a class="lc-file" href={src(card.file, card.anchor)} target="_blank" rel="noopener noreferrer" title={`在 GitHub 查看源码（固定提交 ${COMMIT.slice(0, 7)}）`}>{card.file}</a>
      </div>
      <div class="lc-body">
        {card.lines.map((line) => (
          <div class={line.hl ? 'lc-line lc-hl' : 'lc-line lc-dim'}>
            <span class="lc-ln">{line.n}</span>
            <code class="lc-code">{line.code}</code>
            {line.ann && <span class="lc-ann">{line.ann}</span>}
          </div>
        ))}
      </div>
    </div>
  ))}
  <figcaption>
    片段逐字摘自 unitree_sdk2（提交 <code>9754cd1</code>）对应文件，行号为原文件行号，行号不连续处为省略；高亮行即正文提到的字段，右侧为中文注释。
  </figcaption>
</figure>

